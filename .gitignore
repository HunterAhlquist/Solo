## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon[\r]
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
# Solo.Desktop (Electron shell)
src/Solo.Desktop/node_modules/
src/Solo.Desktop/wwwroot/
src/Solo.Desktop/publish/
src/Solo.Desktop/dist/
# Staged from Icons/Solo.icon at build time for the installed actool.
src/Solo.Desktop/build/Solo.icon/
# Documentation site (site/): the Jekyll output, and the files
# build/stage-site-assets.sh copies in from docs/ and the client.
site/_site/
site/.jekyll-cache/
site/.jekyll-metadata
site/assets/screenshots/
site/assets/favicon.svg

# Design Docs' bundled module, styles, and dependency installation.
extensions/DesignDocs/Solo.DesignDocs.Client/js/node_modules/
extensions/DesignDocs/Solo.DesignDocs/content/design-docs.js
extensions/DesignDocs/Solo.DesignDocs/content/design-docs.css
extensions/DesignDocs/Solo.DesignDocs/content/THIRD-PARTY-LICENSES.txt

extensions/DesignDocs/Solo.DesignDocs/content/pixel-font.png

# Generated copies of the sketch clear effect; source assets live beside JS.
extensions/DesignDocs/Solo.DesignDocs/content/explosion.gif
extensions/DesignDocs/Solo.DesignDocs/content/explosion.wav
extensions/DesignDocs/Solo.DesignDocs/content/NOTICE.txt

extensions/DesignDocs/Solo.DesignDocs/content/MATERIAL-SYMBOLS-LICENSE.txt
