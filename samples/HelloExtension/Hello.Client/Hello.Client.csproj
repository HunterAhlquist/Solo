<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The client half: a page the browser downloads after sign-in and hands to
       the app's router.

       HunterAhlquist.Solo.Shared, never Solo.Extensibility — the contract's
       ASP.NET Core and EF Core dependencies don't resolve for browser-wasm.
       Components.Web and MudBlazor match the versions the instance runs: it
       supplies both at runtime, so compiling against a newer MudBlazor risks
       calling members the instance doesn't have. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Static files ship in the package's own content/ folder, not through
         the host's static-web-asset pipeline. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="HunterAhlquist.Solo.Shared" Version="1.11.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Hello\Contracts\*.cs" Link="Contracts\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
