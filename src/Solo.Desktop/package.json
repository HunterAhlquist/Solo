{
  "name": "solo-desktop",
  "productName": "Solo",
  "version": "0.1.0",
  "description": "Desktop shell for Solo. Gives each Solo instance a local origin and proxies everything on it, the client included, to that instance.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "Hunter Ahlquist <36090375+HunterAhlquist@users.noreply.github.com>",
  "scripts": {
    "start": "electron .",
    "build:native": "node scripts/build-native.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "build:installer-art": "electron scripts/build-installer-art.mjs",
    "stage:icon": "node scripts/stage-icon.mjs",
    "test:glass-theme": "node scripts/check-glass-theme-sync.mjs",
    "test:glass-loading": "node scripts/check-glass-loading.mjs",
    "test:network-recovery": "node scripts/check-network-recovery.mjs",
    "test:network-reset": "node scripts/check-server-network-reset.mjs",
    "test:proxy-paths": "node scripts/check-server-proxy-paths.mjs",
    "test:host-guard": "node scripts/check-server-host-guard.mjs",
    "test:desktop-auth": "node scripts/check-desktop-auth.mjs",
    "test:settings": "node scripts/check-settings-window.mjs",
    "dist": "electron-builder --config electron-builder.config.cjs",
    "test:app-identity": "node scripts/check-app-identity.mjs",
    "test:updater": "node scripts/check-updater.mjs",
    "test:update-progress": "node scripts/check-update-progress.mjs",
    "test:instance-extensions": "node scripts/check-instance-extensions.mjs",
    "test:mac-network-identity": "node scripts/check-mac-network-identity.mjs",
    "test:rotation-gesture": "node scripts/check-rotation-gesture.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "http-proxy": "^1.18.1"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "1.1.1"
  },
  "devDependencies": {
    "electron": "^44.10.1",
    "electron-builder": "^26.18.1"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "app-builder-lib": {
      "minimatch@^10": "^11.0.1"
    },
    "@electron/universal": {
      "minimatch@^9": "^11.0.1"
    }
  },
  "build": {
    "appId": "com.solo.desktop",
    "productName": "Solo",
    "beforePack": "scripts/before-pack.mjs",
    "afterAllArtifactBuild": "scripts/after-all-artifact-build.mjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "main/**",
      "preload/**",
      "settings/**",
      "about/**",
      "update/**",
      "native/auth-session/build/Release/auth_session.node",
      "package.json",
      "!node_modules/electron-liquid-glass/prebuilds/darwin-x64/**"
    ],
    "asarUnpack": [
      "node_modules/electron-liquid-glass/prebuilds/**/*.node",
      "native/auth-session/build/Release/auth_session.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/Solo.icon",
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        },
        {
          "target": "zip",
          "arch": "arm64"
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "signIgnore": [
        "\\.(pak|dat|bin|nib|asar|car|icns)$",
        "\\.framework/(?!Versions/A/)"
      ],
      "notarize": false
    },
    "dmg": {
      "background": "build/background.png",
      "iconSize": 112,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 180,
          "y": 210,
          "type": "file"
        },
        {
          "x": 480,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "ProjectManagement"
    }
  }
}
