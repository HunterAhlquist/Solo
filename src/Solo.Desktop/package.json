{
  "name": "solo-desktop",
  "productName": "Solo",
  "version": "0.1.0",
  "description": "Desktop shell for the Solo client. Serves the published Blazor WASM app on a local origin and proxies API traffic to a configurable Solo instance.",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "Hunter Ahlquist <36090375+HunterAhlquist@users.noreply.github.com>",
  "scripts": {
    "start": "electron .",
    "build:client": "node scripts/build-client.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "stage:icon": "node scripts/stage-icon.mjs",
    "test:glass-theme": "node scripts/check-glass-theme-sync.mjs",
    "test:glass-loading": "node scripts/check-glass-loading.mjs",
    "test:network-recovery": "node scripts/check-network-recovery.mjs",
    "test:network-reset": "node scripts/check-server-network-reset.mjs",
    "test:static-paths": "node scripts/check-server-static-paths.mjs",
    "test:desktop-auth": "node scripts/check-desktop-auth.mjs",
    "test:settings": "node scripts/check-settings-window.mjs",
    "dist": "npm run build:client && electron-builder"
  },
  "dependencies": {
    "http-proxy": "^1.18.1"
  },
  "optionalDependencies": {
    "electron-liquid-glass": "1.1.1"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  },
  "build": {
    "appId": "com.solo.desktop",
    "productName": "Solo",
    "beforePack": "scripts/before-pack.mjs",
    "afterAllArtifactBuild": "scripts/after-all-artifact-build.mjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "main/**",
      "preload/**",
      "settings/**",
      "wwwroot/**",
      "package.json",
      "!node_modules/electron-liquid-glass/prebuilds/darwin-x64/**"
    ],
    "asarUnpack": [
      "node_modules/electron-liquid-glass/prebuilds/**/*.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/Solo.icon",
      "target": [
        {
          "target": "dmg",
          "arch": "arm64"
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "signIgnore": [
        "\\.(pak|dat|bin|nib|asar|car|icns)$",
        "\\.framework/(?!Versions/A/)"
      ],
      "notarize": false
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "ProjectManagement"
    }
  }
}
