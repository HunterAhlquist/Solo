<Project Sdk="Microsoft.NET.Sdk">

  <!-- The MCP server, built the way a third-party extension would be: it
       references Solo.Extensibility and nothing else from this solution, owns
       its own Postgres schema and its own migrations, and reaches core only
       through the contract and the public REST API.

       Nothing about this feature lives in Solo.Api or Solo.Data. That is the
       point of the exercise: remove the package and the instance loses MCP
       access and nothing else. If this project ever needs something the
       contract does not offer, that is a finding about the contract.

       Versioned independently of the app — build/pack-mcp-extension.sh stamps
       this version into extension.json and into the package filename. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Version>1.3.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Solo.Extensibility\Solo.Extensibility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migrations are scaffolded at build time by the extension author, exactly
         as core's are; the host only applies them. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
