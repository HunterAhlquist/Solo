<Project Sdk="Microsoft.NET.Sdk">

  <!-- The public contract extensions compile against. Versioned independently of
       the app (see docs/extension-plan.md §10): the host checks a package's
       declared range against ContractVersion and refuses to load out-of-range.
       Published as HunterAhlquist.Solo.Extensibility; the version and package
       metadata live in build/contract-package.props, shared with Solo.Shared.

       It may reference Solo.Shared and NOTHING ELSE from this solution. A
       reference to Solo.Data or Solo.Api would make every internal refactor a
       breaking change for every installed extension. -->

  <Import Project="..\..\build\contract-package.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>The contract a Solo extension's server half compiles against: the entry point, operation hooks, domain events, caller-scoped reads of core data, and a DbContext in the extension's own schema.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Solo.Shared\Solo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Pinned to the same EF Core the rest of the solution resolves, so the
         contract assembly and Solo.Data unify on one Abstractions version. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

</Project>
