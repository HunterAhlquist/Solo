<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Roadmaps extension's server half: roadmaps, their entries and the
       timeline settings, in its own ext_roadmap schema. Built the way src/Solo.Mcp
       is — it references Solo.Extensibility and nothing else from this solution,
       reads core only through ISoloQuery, and never writes a core row. Task dates
       are set by the client half through core's own schedule endpoint.

       Remove the package and the instance loses roadmaps and nothing else; the
       schema is then reported as data without a package and can be purged.

       Versioned independently of the app — build/pack-roadmap-extension.sh stamps
       this version into the package filename and checks it against extension.json. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Version>1.6.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Solo.Extensibility\Solo.Extensibility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migrations are scaffolded at build time by the extension author, exactly
         as core's are; the host only applies them. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
