@page "/kit-spike/host"
@implements IAsyncDisposable
@inject ISoloClientApi Api
@inject IJSRuntime JS

@*
    The page the app loads in a web view nobody sees. It runs each project's
    card contribution on a kit surface, so the components draw kit nodes; a
    script (content/kit.js) watches those and posts them to the app as a tree,
    and turns a tap in the app back into a click here.

    In a real design this is the host's job and it would find contributions by
    their attributes. The spike names its one component.
*@

<div id="kit-spike-host" style="padding:16px">
    <MudText Typo="Typo.caption" Color="Color.Secondary">
        Kit host — what follows is drawn for inspection in a browser; the app reads the tree, not this page.
    </MudText>
    <CascadingValue Value="_surface" IsFixed="true">
        @if (_projects is not null)
        {
            @foreach (var project in _projects)
            {
                <div @key="project.Id" data-kit-root="projectCard" data-project="@project.Id"
                     data-alias="@project.Alias" data-name="@project.Name">
                    <RoadmapKitCard Project="project" CanWrite="@(project.Role == ProjectRole.ReadWrite)" />
                </div>
            }
        }
    </CascadingValue>
</div>

@code {
    private readonly KitSurface _surface;
    private IReadOnlyList<ProjectSummaryDto>? _projects;
    private IJSObjectReference? _module;

    public KitHostPage()
    {
        _surface = new KitSurface(route => _module is null
            ? Task.CompletedTask
            : _module.InvokeVoidAsync("open", route).AsTask());
    }

    protected override async Task OnInitializedAsync()
    {
        _projects = await Api.GetAsync<IReadOnlyList<ProjectSummaryDto>>("api/projects");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var script = Api.Resolve("api/extensions/kit-spike/content/kit.js?v=0.1.0").ToString();
        _module = await JS.InvokeAsync<IJSObjectReference>("import", script);
        await _module.InvokeVoidAsync("start", "kit-spike-host");
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
