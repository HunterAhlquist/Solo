@page "/kit-spike/demo/{ProjectAlias}"
@inject NavigationManager Navigation

@*
    A page built from the kit and nothing else. The web client draws it with
    the components core is made of; an app that draws pages itself draws it as
    a screen of its own, with its own controls, while this code runs where it
    always does. Its links are the cases such an app has to get right: a core
    screen by address and from a handler, a page the web has to show, and
    somewhere off the instance.
*@

<PageTitle>Plugin demo</PageTitle>

<SoloStack Spacing="SoloSpacing.Large">
    <SoloStack>
        <SoloText Text="Plugin demo" Variant="SoloTextVariant.Heading" />
        <SoloText Text="@($"A page from an extension, for project {ProjectAlias}. Count: {_count}")" />
        <SoloText Text="Each piece says what it is, and the client draws it." Variant="SoloTextVariant.Caption" Tone="SoloTone.Muted" />
    </SoloStack>

    <SoloStack Direction="SoloDirection.Horizontal" Align="SoloAlign.Center">
        <SoloIcon Name="Flag" Tone="SoloTone.Primary" Label="Flagged" />
        <SoloBadge Text="Default" />
        <SoloBadge Text="Primary" Tone="SoloTone.Primary" />
        <SoloBadge Text="On track" Icon="Star" Tone="SoloTone.Success" />
        <SoloBadge Text="3 left" Tone="SoloTone.Warning" />
        <SoloBadge Text="Overdue" Tone="SoloTone.Danger" />
    </SoloStack>

    <SoloStack Direction="SoloDirection.Horizontal" Align="SoloAlign.Center">
        <SoloButton Text="Count up" Variant="SoloButtonVariant.Primary" Icon="Bolt" OnClick="@(() => _count++)" />
        <SoloButton Text="Open the project" Href="@($"projects/{ProjectAlias}")" />
        <SoloButton Text="Plain" Variant="SoloButtonVariant.Plain" OnClick="@(() => _count++)" />
        <SoloButton Text="Reset" Destructive="true" OnClick="@(() => _count = 0)" />
        <SoloButton Text="Disabled" Disabled="true" />
    </SoloStack>

    <SoloStack Spacing="SoloSpacing.None" Align="SoloAlign.Stretch">
        <SoloRow Icon="Dashboard" Title="The project" Subtitle="A core screen, by its address" Href="@($"projects/{ProjectAlias}")" />
        <SoloRow Icon="Flag" Title="All projects" Subtitle="A core screen, from a handler" OnClick="@(() => Navigation.NavigateTo("projects"))" />
        <SoloRow Icon="Extension" Title="Page two" Subtitle="Marked [WebPage]: the web client draws it" Href="@($"kit-spike/demo/{ProjectAlias}/more")" />
        <SoloRow Icon="Book" Title="About" Subtitle="Not marked, and not the kit either" Href="kit-spike/about" />
        <SoloRow Icon="Star" Title="A link off the instance" Subtitle="example.com" Href="https://example.com/" />
        <SoloRow Icon="Bolt" Title="A row that does something" OnClick="@(() => _count++)">
            <SoloBadge Text="@($"pressed {_count}×")" Tone="SoloTone.Primary" />
        </SoloRow>
        <SoloRow Icon="Book" Title="A row that only says something" Subtitle="Nothing to press" />
    </SoloStack>

    <SoloProgress Value="@(Math.Min(_count, 8) / 8.0)" Label="@($"{Math.Min(_count, 8)} of 8")" />
    <SoloToggle Label="@(_on ? "On" : "Off")" @bind-Value="_on" />

    @* Something to write and something to pick. The handler tidies what was written, so the
       field shows what the extension kept and not only what was typed. *@
    <SoloStack Spacing="SoloSpacing.Medium" Align="SoloAlign.Stretch">
        <SoloTextField Label="Your name" Placeholder="Ada" Value="@_name" ValueChanged="@(value => _name = value.Trim())" />
        <SoloPicker Label="Mood" Placeholder="Pick one" Options="Moods" @bind-Value="_mood" />
        <SoloStack Direction="SoloDirection.Horizontal" Align="SoloAlign.Center">
            <SoloText Text="@(_name.Length == 0 ? "Hello." : $"Hello, {_name}.")" />
            @if (Moods.FirstOrDefault(m => m.Value == _mood) is { } mood)
            {
                <SoloBadge Text="@mood.Label" Tone="@(_mood == "bad" ? SoloTone.Danger : _mood == "good" ? SoloTone.Success : SoloTone.Default)" />
            }
        </SoloStack>
        <SoloTextField Label="Notes" Placeholder="Several lines" Multiline="true" @bind-Value="_notes" />
        <SoloText Text="@($"{_notes.Length} characters of notes")" Variant="SoloTextVariant.Caption" Tone="SoloTone.Muted" />
    </SoloStack>
</SoloStack>

@code {
    private static readonly IReadOnlyList<SoloOption> Moods = [new("good", "Good"), new("fine", "Fine"), new("bad", "Bad")];

    private int _count;
    private bool _on;
    private string _name = "";
    private string? _mood;
    private string _notes = "";

    [Parameter] public string ProjectAlias { get; set; } = "";
}
