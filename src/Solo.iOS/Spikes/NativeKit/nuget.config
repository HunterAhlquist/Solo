<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The contract packages come from build/pack-contract.sh's output, as they do for extensions/. -->
  <packageSources>
    <clear />
    <add key="contract" value="../../../../artifacts/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="contract">
      <package pattern="HunterAhlquist.Solo.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
