<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A self-hosted instance is often a plain-http address on the LAN (an IP,
	     a .local name, localhost). This allows those and nothing wider: an
	     instance on the public internet still has to be https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The keychain group the app shares with its widgets, with the team's prefix filled in. -->
	<key>SoloKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.hunterahlquist.solo.native.shared</string>
	<!-- Nothing of the app's own encrypts anything: it speaks https and keeps a session in
	     the keychain, both the system's. Said here so an upload isn't held for the answer. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The background refresh that reads each instance's inbox while the app is closed
	     (BackgroundSync), and the mode it runs under. An iPhone's and iPad's; a Mac has
	     neither and ignores both. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Solo connects to the instance you point it at, which may be on your local network.</string>
	<!-- What a note or folder carries while it is dragged about its design doc. Private to
	     the app; a dragged note also carries a link to itself as plain text, for everything else. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.hunterahlquist.solo.doc-node</string>
			<key>UTTypeDescription</key>
			<string>Solo design doc item</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
		</dict>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose a picture to use as an icon or to attach to a design doc.</string>
	<!-- Where the instance's sign-in page returns to. The sign-in sheet claims
	     this for the length of one sign-in; registering it here as well lets a
	     cold return through the system still find the app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hunterahlquist.solo.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.hunterahlquist.solo</string>
			</array>
		</dict>
		<!-- How a widget opens the app at a page. -->
		<dict>
			<key>CFBundleURLName</key>
			<string>com.hunterahlquist.solo.native.widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.hunterahlquist.solo.native</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
