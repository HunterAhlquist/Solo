<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A Mac app keeps to its own container: its settings, its cache of what it last read,
	     and nothing of the rest of the disk but what is handed to it. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The instance. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Signing in to an instance from before the app's own flow comes home over loopback,
	     which is listening. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- A picture chosen for an icon or a note, or saved from one. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
