<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- What the app and its widgets share: which instance, a copy of the session, the last
	     summary drawn. A keychain group needs no registering; any profile for the team allows it. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.hunterahlquist.solo.native.shared</string>
	</array>
</dict>
</plist>
