<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The Roadmaps extension's client half: the sidebar section, the timeline
       page, the task view's roadmap chips and the Admin settings panel. Packaged
       under client/ and loaded by the browser after sign-in (see Solo.Client's
       ExtensionLoader), like src/Solo.Mcp.Client.

       References only Solo.Shared, Components.Web and MudBlazor — never
       Solo.Extensibility, whose ASP.NET Core and EF Core dependencies don't
       resolve for browser-wasm. Both halves compile the same request/response
       records from the server project's Contracts folder, so the package owns
       its API shapes end to end without a third assembly or anything in core. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Version>1.3.0</Version>
    <!-- content/ (the stylesheet and the pointer-event module) ships in the
         package and is fetched from /api/extensions/roadmap/content/, not
         through the host's static-web-asset pipeline. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
    <ProjectReference Include="..\Solo.Shared\Solo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Solo.Roadmap\Contracts\*.cs" Link="Contracts\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
