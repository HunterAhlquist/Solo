@attribute [ExtensionSettings]
@inject ISoloClientApi Client
@inject ISnackbar Snackbar
@inject IJSRuntime JS

@*
    The timeline's instance-wide settings, inside the Roadmaps entry on Admin
    settings. The endpoint guards itself — super admins only — rather than
    relying on this page being theirs. Changes apply the next time a roadmap
    page loads.
*@

@if (_error is not null)
{
    <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">@_error</MudText>
}
else if (_settings is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudText Typo="Typo.subtitle2" Class="mb-1">Scroll bounds</MudText>
    <div class="roadmap-settings__group">
        <MudNumericField T="int" @bind-Value="_pastDays" Label="Days before today" Variant="Variant.Outlined"
                         Margin="Margin.Dense" Min="RoadmapLimits.MinBoundDays" Max="RoadmapLimits.MaxBoundDays" />
        <MudNumericField T="int" @bind-Value="_futureDays" Label="Days after today" Variant="Variant.Outlined"
                         Margin="Margin.Dense" Min="RoadmapLimits.MinBoundDays" Max="RoadmapLimits.MaxBoundDays" />
    </div>

    <MudText Typo="Typo.subtitle2" Class="mb-1">Sprint Indication</MudText>
    <div class="roadmap-settings__group">
        <MudSelect T="DayOfWeek" @bind-Value="_startDay" Label="Sprints start on" Variant="Variant.Outlined"
                   Margin="Margin.Dense">
            @foreach (var day in Week)
            {
                <MudSelectItem Value="@day">@day</MudSelectItem>
            }
        </MudSelect>
        <MudNumericField T="int" @bind-Value="_weeks" Label="Sprint length (weeks)" Variant="Variant.Outlined"
                         Margin="Margin.Dense" Min="RoadmapLimits.MinSprintWeeks" Max="RoadmapLimits.MaxSprintWeeks" />
    </div>
    <MudText Typo="Typo.caption" Color="@(ReadBack is null ? Color.Error : Color.Secondary)" Class="d-block mb-3">
        @(ReadBack ?? $"A sprint lasts {RoadmapLimits.MinSprintWeeks}–{RoadmapLimits.MaxSprintWeeks} weeks.")
    </MudText>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
               Disabled="@(_saving || !Changed || ReadBack is null)" OnClick="@SaveAsync">
        Save
    </MudButton>
}

@code {
    private RoadmapSettingsDto? _settings;
    private int _pastDays;
    private int _futureDays;
    private DayOfWeek _startDay;
    private int _weeks;
    private bool _saving;
    private string? _error;

    [Parameter]
    public string ExtensionId { get; set; } = "";

    private RoadmapApi Api => new(Client);

    /// <summary>Monday first, the way a sprint calendar is usually read.</summary>
    private static readonly DayOfWeek[] Week =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
        DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday,
    ];

    /// <summary>
    /// What the fields mean, in words, with the sprint running now as the check:
    /// "Sprints start on Mondays and last 2 weeks. This one runs 28 Sep – 11 Oct."
    /// </summary>
    private string? ReadBack
    {
        get
        {
            if (_weeks < RoadmapLimits.MinSprintWeeks || _weeks > RoadmapLimits.MaxSprintWeeks)
            {
                return null;
            }

            var start = RoadmapSprints.SprintStart(DateOnly.FromDateTime(DateTime.Now), _startDay, _weeks);
            return $"Sprints start on {_startDay}s and last {_weeks} week{(_weeks == 1 ? "" : "s")}. " +
                   $"This one runs {Dates.Range(start, start.AddDays(_weeks * 7 - 1))}.";
        }
    }

    private bool Changed => _settings is not null &&
        (_pastDays, _futureDays, _startDay, _weeks) !=
        (_settings.PastDays, _settings.FutureDays, _settings.SprintStartDay, _settings.SprintLengthWeeks);

    protected override async Task OnInitializedAsync()
    {
        await RoadmapAssets.EnsureStylesAsync(JS, Api);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            Apply(await Api.SettingsAsync());
            _error = null;
        }
        catch (Exception e) when (e is SoloApiException or HttpRequestException)
        {
            _error = "Couldn't load the roadmap settings.";
        }
    }

    private void Apply(RoadmapSettingsDto settings)
    {
        _settings = settings;
        (_pastDays, _futureDays, _startDay, _weeks) =
            (settings.PastDays, settings.FutureDays, settings.SprintStartDay, settings.SprintLengthWeeks);
    }

    private async Task SaveAsync()
    {
        if (_settings is null)
        {
            return;
        }

        _saving = true;
        try
        {
            Apply(await Api.SaveSettingsAsync(new UpdateRoadmapSettingsRequest
            {
                PastDays = _pastDays,
                FutureDays = _futureDays,
                SprintStartDay = _startDay,
                SprintLengthWeeks = _weeks,
                Version = _settings.Version,
            }));
            Snackbar.Add("Saved. Roadmaps pick this up the next time they load.", Severity.Success);
        }
        catch (SoloApiException e) when (e.StatusCode == HttpStatusCode.Conflict)
        {
            await LoadAsync();
            Snackbar.Add("These settings changed elsewhere; they've been reloaded.", Severity.Info);
        }
        catch (Exception e) when (e is SoloApiException or HttpRequestException)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
