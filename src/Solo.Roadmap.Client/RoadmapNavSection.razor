@attribute [ProjectNavSection("Roadmaps", Order = 10)]
@inherits RoadmapListComponent

@*
    A project's roadmaps, under the Roadmaps header core draws in the sidebar.
    Rendered only once the project's group is expanded — the same moment its
    boards load — so the list is fetched then, not at sign-in.
*@

@if (Roadmaps is null && Error is null)
{
    <div class="px-4 py-2">
        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
    </div>
}
else if (Error is not null)
{
    <MudText Typo="Typo.caption" Color="Color.Error" Class="px-4 py-1 d-block">@Error</MudText>
}
else
{
    @foreach (var roadmap in Roadmaps!)
    {
        <MudNavLink Href="@Href(roadmap)" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Timeline">
            @roadmap.Title
        </MudNavLink>
    }

    @if (Roadmaps!.Count == 0)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-4 py-1 d-block">
            No roadmaps.
        </MudText>
    }
}

@if (CanWrite)
{
    <MudNavLink Icon="@Icons.Material.Filled.Add" Class="roadmap-nav__add" OnClick="@CreateAsync">
        Add roadmap
    </MudNavLink>
}
