@inject ISoloClientApi Client
@inject IJSRuntime JS

@*
    Picks a task to put on the roadmap: any task in the project not already on
    it, searchable by name or serial, grouped by board. Arrow keys move through
    the results and Enter takes the highlighted one.
*@

<MudDialog DefaultFocus="DefaultFocus.None">
    <DialogContent>
        <MudTextField @ref="_search" T="string" Value="@_query" ValueChanged="@OnQueryChanged" Immediate="true"
                      Placeholder="Search by name or serial" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      AutoFocus="true" OnKeyDown="@OnKeyDown" aria-label="Search tasks" />

        <div class="roadmap-picker__results" role="listbox" aria-label="Tasks">
            @if (_error is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Error" Class="pa-2">@_error</MudText>
            }
            else if (_candidates is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
            }
            else if (_groups.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">
                    @(_candidates.Count == 0 ? "Every task in this project is already on the roadmap." : "No tasks match.")
                </MudText>
            }
            else
            {
                var index = 0;
                @foreach (var group in _groups)
                {
                    <div class="roadmap-picker__board">@group.BoardName</div>
                    @foreach (var candidate in group.Candidates)
                    {
                        var position = index++;
                        <div class="@($"roadmap-picker__option{(position == _active ? " is-active" : "")}")"
                             role="option" aria-selected="@(position == _active ? "true" : "false")"
                             data-picker-option="@position" @key="candidate.Task.Id"
                             @onclick="@(() => Pick(candidate))">
                            <span class="roadmap-picker__serial">@CandidateSearch.Serial(candidate, ProjectAlias)</span>
                            <span class="roadmap-picker__name">@candidate.Task.Name</span>
                            <MudChip T="string" Size="Size.Small" Color="@StatusColor(candidate.Task.Status)"
                                     Variant="Variant.Text">@StatusText(candidate.Task.Status)</MudChip>
                            @if (DatesOf(candidate.Task) is { } dates)
                            {
                                <span class="roadmap-picker__dates">@dates</span>
                            }
                        </div>
                    }
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private MudTextField<string>? _search;
    private List<RoadmapCandidateDto>? _candidates;
    private IReadOnlyList<CandidateGroup> _groups = [];
    private List<RoadmapCandidateDto> _flat = [];
    private string _query = string.Empty;
    private int _active;
    private string? _error;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    [Parameter, EditorRequired]
    public string ProjectAlias { get; set; } = "";

    [Parameter, EditorRequired]
    public Guid RoadmapId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _candidates = await new RoadmapApi(Client).CandidatesAsync(ProjectId, RoadmapId);
            Filter();
        }
        catch (Exception e) when (e is SoloApiException or HttpRequestException)
        {
            _error = "Couldn't load this project's tasks.";
        }
    }

    /// <summary>
    /// Focused explicitly: the dialog's own focus handling runs after the field's
    /// autofocus and takes it, and a picker you can't type into straight away
    /// isn't much of a search.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _search is not null)
        {
            await _search.FocusAsync();
        }
    }

    private void OnQueryChanged(string query)
    {
        _query = query;
        Filter();
    }

    private void Filter()
    {
        _groups = CandidateSearch.Filter(_candidates ?? [], ProjectAlias, _query);
        _flat = _groups.SelectMany(g => g.Candidates).ToList();
        _active = 0;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown" when _flat.Count > 0:
                _active = Math.Min(_active + 1, _flat.Count - 1);
                await RevealActiveAsync();
                break;
            case "ArrowUp" when _flat.Count > 0:
                _active = Math.Max(_active - 1, 0);
                await RevealActiveAsync();
                break;
            case "Enter" when _flat.Count > 0:
                Pick(_flat[_active]);
                break;
        }
    }

    private async Task RevealActiveAsync()
    {
        StateHasChanged();
        try
        {
            var module = await RoadmapAssets.ModuleAsync(JS, new RoadmapApi(Client));
            await module.InvokeVoidAsync("scrollIntoView", $"[data-picker-option=\"{_active}\"]");
        }
        catch (Exception e) when (e is JSException or InvalidOperationException)
        {
            // The list still moves; it just won't scroll to follow.
        }
    }

    private void Pick(RoadmapCandidateDto candidate) => Dialog.Close(DialogResult.Ok(candidate));

    private static string StatusText(TaskState status) => status switch
    {
        TaskState.InProgress => "In progress",
        TaskState.Finished => "Finished",
        _ => "Unstarted",
    };

    private static Color StatusColor(TaskState status) => status switch
    {
        TaskState.InProgress => Color.Info,
        TaskState.Finished => Color.Success,
        _ => Color.Default,
    };

    private static string? DatesOf(TaskDto task) => task.DeadlineAt is { } deadline
        ? task.StartAt is { } start ? Dates.Range(start, deadline) : $"due {Dates.Day(deadline)}"
        : null;
}
