{
  "formatVersion": 1,
  "id": "ahlquist-interactive",
  "name": "Ahlquist Interactive",
  "description": "Black-and-yellow monospace terminal. The original Solo look.",
  "author": "Ahlquist Interactive",

  "stylesheet": "content/theme.css",

  "typography": {
    "fontFamily": ["Courier New", "monospace"],
    "fontSize": "0.875rem",
    "headingWeight": "700",
    "buttonWeight": "700"
  },

  "layout": {
    "borderRadius": "8px",
    "appbarHeight": "5em",
    "drawerWidth": "20em"
  },

  "login": {
    "background": {
      "image": "content/login-dark.svg",
      "imageLight": "content/login-light.svg",
      "fit": "cover",
      "position": "center",
      "scrim": 0.35
    }
  },

  "dark": {
    "primary": "#fff600",
    "secondary": "#c9c400",
    "tertiary": "#8a8600",
    "background": "#000000",
    "backgroundGray": "#080808",
    "surface": "#101010",
    "appbarBackground": "#000000",
    "appbarText": "#fff600",
    "drawerBackground": "#080808",
    "drawerText": "#ffffff",
    "drawerIcon": "#fff600",
    "textPrimary": "#ffffff",
    "textSecondary": "#b0b0a0",
    "textDisabled": "#6f6f64",
    "actionDefault": "#c9c400",
    "divider": "#fff60040",
    "dividerLight": "#fff60026",
    "linesDefault": "#fff60040",
    "linesInputs": "#fff60059",
    "tableLines": "#fff60026",
    "tableHover": "#fff6000f",
    "success": "#5ad469",
    "warning": "#ffb300",
    "error": "#ff5252",
    "info": "#fff600"
  },

  "light": {
    "primary": "#df6610",
    "secondary": "#a8480a",
    "tertiary": "#7a3206",
    "background": "#fdf9f3",
    "backgroundGray": "#f8f1e8",
    "surface": "#fffdfa",
    "appbarBackground": "#17160f",
    "appbarText": "#ffe000",
    "drawerBackground": "#fffdfa",
    "drawerText": "#231d16",
    "drawerIcon": "#df6610",
    "textPrimary": "#231d16",
    "textSecondary": "#5b4f42",
    "textDisabled": "#8f8375",
    "actionDefault": "#5b4f42",
    "divider": "#e4d9c9",
    "dividerLight": "#eee6da",
    "linesDefault": "#dccfbb",
    "linesInputs": "#c3b199",
    "tableLines": "#ebe3d7",
    "tableHover": "#df661014",
    "success": "#1f6f43",
    "warning": "#8a5a00",
    "error": "#b3261e",
    "info": "#2f5d8a"
  }
}
