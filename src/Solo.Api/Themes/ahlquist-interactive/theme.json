{
  "formatVersion": 1,
  "id": "ahlquist-interactive",
  "name": "Ahlquist Interactive",
  "description": "Black-and-yellow monospace terminal. The original Solo look.",
  "author": "Ahlquist Interactive",

  "stylesheet": "content/theme.css",

  "typography": {
    "fontFamily": ["Courier New", "monospace"],
    "fontSize": "0.875rem",
    "headingWeight": "700",
    "buttonWeight": "700"
  },

  "layout": {
    "borderRadius": "8px",
    "appbarHeight": "5em",
    "drawerWidth": "20em"
  },

  "login": {
    "background": {
      "image": "content/login-dark.svg",
      "imageLight": "content/login-light.svg",
      "fit": "cover",
      "position": "center",
      "scrim": 0.35
    }
  },

  "dark": {
    "primary": "#fff600",
    "secondary": "#c9c400",
    "tertiary": "#8a8600",
    "background": "#000000",
    "backgroundGray": "#080808",
    "surface": "#101010",
    "appbarBackground": "#000000",
    "appbarText": "#fff600",
    "drawerBackground": "#080808",
    "drawerText": "#ffffff",
    "drawerIcon": "#fff600",
    "textPrimary": "#ffffff",
    "textSecondary": "#b0b0a0",
    "textDisabled": "#6f6f64",
    "actionDefault": "#c9c400",
    "divider": "#fff60040",
    "dividerLight": "#fff60026",
    "linesDefault": "#fff60040",
    "linesInputs": "#fff60059",
    "tableLines": "#fff60026",
    "tableHover": "#fff6000f",
    "success": "#5ad469",
    "warning": "#ffb300",
    "error": "#ff5252",
    "info": "#fff600"
  },

  "light": {
    "primary": "#b45309",
    "secondary": "#8f3d0a",
    "tertiary": "#6b2d05",
    "background": "#f7f3ee",
    "backgroundGray": "#efe9e2",
    "surface": "#fdfaf7",
    "appbarBackground": "#17160f",
    "appbarText": "#ffe000",
    "drawerBackground": "#fdfaf7",
    "drawerText": "#211c17",
    "drawerIcon": "#b45309",
    "textPrimary": "#211c17",
    "textSecondary": "#574c42",
    "textDisabled": "#8d8175",
    "actionDefault": "#574c42",
    "divider": "#ddd3c8",
    "dividerLight": "#e8e0d8",
    "linesDefault": "#d3c7ba",
    "linesInputs": "#bcac9c",
    "tableLines": "#e3dbd2",
    "tableHover": "#b4530910",
    "success": "#1f6f43",
    "warning": "#8a5a00",
    "error": "#b3261e",
    "info": "#2f5d8a"
  }
}
