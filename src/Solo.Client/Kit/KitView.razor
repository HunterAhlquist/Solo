@namespace Solo.Client.Kit
@using Solo.Shared.Kit

@*
    One kit component, drawn. The kit says what a thing is and this says what
    that looks like here: the same MudBlazor components, sizes and colours core
    uses for the same job, so nothing about a contribution gives away that an
    extension made it.
*@

@if (Surface is not null)
{
    @* On a kit surface nothing is drawn. Each component is written out as what
       it is, for an app to draw with controls of its own (KitSurface.cs). The
       names and values here are what that app reads, so they are the kit's own
       words and not MudBlazor's. *@
    switch (Source)
    {
        case SoloStack stack:
            <solo-kit data-kind="stack" data-direction="@stack.Direction" data-spacing="@stack.Spacing" data-align="@stack.Align">@stack.ChildContent</solo-kit>
            break;

        case SoloText text:
            <solo-kit data-kind="text" data-text="@text.Text" data-variant="@text.Variant" data-tone="@text.Tone"></solo-kit>
            break;

        case SoloIcon icon:
            <solo-kit data-kind="icon" data-name="@icon.Name" data-tone="@icon.Tone" data-label="@icon.Label"></solo-kit>
            break;

        case SoloBadge badge:
            <solo-kit data-kind="badge" data-text="@badge.Text" data-icon="@badge.Icon" data-tone="@badge.Tone"></solo-kit>
            break;

        case SoloButton button:
            <solo-kit data-kind="button" data-text="@button.Text" data-icon="@button.Icon" data-variant="@button.Variant"
                      data-destructive="@Flag(button.Destructive)" data-disabled="@Flag(button.Disabled)" data-href="@button.Href"
                      data-press="@Flag(button.OnClick.HasDelegate)" @onclick="@button.OnClick"></solo-kit>
            break;

        case SoloRow row:
            <solo-kit data-kind="row" data-title="@row.Title" data-subtitle="@row.Subtitle" data-icon="@row.Icon"
                      data-disabled="@Flag(row.Disabled)" data-href="@row.Href" data-press="@Flag(row.OnClick.HasDelegate)"
                      @onclick="@row.OnClick">@row.ChildContent</solo-kit>
            break;

        case SoloProgress progress:
            <solo-kit data-kind="progress" data-tone="@progress.Tone" data-label="@progress.Label"
                      data-value="@Math.Clamp(progress.Value, 0, 1).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)"></solo-kit>
            break;

        case SoloToggle toggle:
            @* A press is the one thing an app sends back, so a switch is pressed: it asks for the other value. *@
            <solo-kit data-kind="toggle" data-label="@toggle.Label" data-value="@Flag(toggle.Value)" data-disabled="@Flag(toggle.Disabled)"
                      data-press="1" @onclick="@(() => toggle.ValueChanged.InvokeAsync(!toggle.Value))"></solo-kit>
            break;

        case SoloTextField field:
            @* Something written comes back as a change on the node, carrying the text (js/kit-surface.js). *@
            <solo-kit data-kind="textField" data-label="@field.Label" data-value="@field.Value" data-placeholder="@field.Placeholder"
                      data-multiline="@Flag(field.Multiline)" data-disabled="@Flag(field.Disabled)" data-input="1"
                      @onchange="@(change => field.Disabled ? Task.CompletedTask : field.ValueChanged.InvokeAsync(change.Value as string ?? ""))"></solo-kit>
            break;

        case SoloPicker picker:
            <solo-kit data-kind="picker" data-label="@picker.Label" data-value="@Picked(picker)" data-placeholder="@picker.Placeholder"
                      data-disabled="@Flag(picker.Disabled)" data-input="1"
                      @onchange="@(change => picker.PickAsync(change.Value as string))">
                @foreach (var option in picker.Options)
                {
                    <solo-kit @key="option.Value" data-kind="option" data-value="@option.Value" data-label="@option.Label"></solo-kit>
                }
            </solo-kit>
            break;
    }
}
else
{
    switch (Source)
    {
        case SoloStack stack:
            <MudStack Row="@(stack.Direction == SoloDirection.Horizontal)" Spacing="@Gap(stack.Spacing)"
                      AlignItems="@Across(stack.Align)" Wrap="@(stack.Direction == SoloDirection.Horizontal ? Wrap.Wrap : Wrap.NoWrap)"
                      Class="solo-kit-stack">
                @stack.ChildContent
            </MudStack>
            break;

        case SoloText text:
            <MudText Typo="@Type(text.Variant)" Color="@Tone(text.Tone, Color.Inherit)" Class="solo-kit-text">@text.Text</MudText>
            break;

        case SoloIcon icon:
            <MudIcon Icon="@SoloIcons.Resolve(icon.Name)" Size="Size.Small" Color="@Tone(icon.Tone, Color.Inherit)"
                     Title="@icon.Label" Class="solo-kit-icon" />
            break;

        case SoloBadge badge:
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="@Tone(badge.Tone, Color.Default)"
                     Icon="@(badge.Icon is null ? null : SoloIcons.Resolve(badge.Icon))" Class="solo-kit-badge">@badge.Text</MudChip>
            break;

        case SoloButton button:
            <MudButton Variant="@Weight(button.Variant)" Size="Size.Small" Disabled="@button.Disabled"
                       Color="@(button.Destructive ? Color.Error : button.Variant == SoloButtonVariant.Plain ? Color.Default : Color.Primary)"
                       StartIcon="@(button.Icon is null ? null : SoloIcons.Resolve(button.Icon))"
                       Href="@(button.Disabled ? null : button.Href)" OnClick="@button.OnClick" Class="solo-kit-button">@button.Text</MudButton>
            break;

        case SoloRow row when row.Href is not null && !row.Disabled:
            <a class="solo-kit-row solo-kit-row--pressable" href="@row.Href" @onclick="@row.OnClick">
                @RowParts(row)
            </a>
            break;

        case SoloRow row when row.OnClick.HasDelegate && !row.Disabled:
            <div class="solo-kit-row solo-kit-row--pressable" role="button" tabindex="0"
                 @onclick="@row.OnClick" @onkeydown="@(key => PressAsync(key, row))">
                @RowParts(row)
            </div>
            break;

        case SoloRow row:
            <div class="solo-kit-row @(row.Disabled ? "solo-kit-row--disabled" : null)" aria-disabled="@(row.Disabled ? "true" : null)">
                @RowParts(row)
            </div>
            break;

        case SoloProgress progress:
            <MudProgressLinear Value="@(Math.Clamp(progress.Value, 0, 1) * 100)" Color="@Tone(progress.Tone, Color.Primary)"
                               Rounded="true" Size="Size.Small" Class="solo-kit-progress" aria-label="@progress.Label" />
            break;

        case SoloToggle toggle:
            <MudSwitch T="bool" Value="@toggle.Value" ValueChanged="@toggle.ValueChanged" Label="@toggle.Label"
                       Disabled="@toggle.Disabled" Color="Color.Primary" Class="solo-kit-toggle" />
            break;

        case SoloTextField field:
            @* As core's own fields are drawn. Heard as the person writes, once they pause, and when they leave. *@
            <MudTextField T="string" Value="@field.Value" ValueChanged="@field.ValueChanged" Label="@field.Label"
                          Placeholder="@field.Placeholder" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="@(field.Multiline ? 3 : 1)" AutoGrow="@field.Multiline" Disabled="@field.Disabled"
                          Immediate="true" DebounceInterval="300" Class="solo-kit-field" />
            break;

        case SoloPicker picker:
            <MudSelect T="string" Value="@Picked(picker)" ValueChanged="@(value => picker.PickAsync(value))"
                       Label="@picker.Label" Placeholder="@picker.Placeholder" Variant="Variant.Outlined" Margin="Margin.Dense"
                       Disabled="@picker.Disabled" ToStringFunc="@(value => picker.Options.FirstOrDefault(o => o.Value == value)?.Label)"
                       Class="solo-kit-picker">
                @foreach (var option in picker.Options)
                {
                    <MudSelectItem T="string" Value="@option.Value">@option.Label</MudSelectItem>
                }
            </MudSelect>
            break;
    }
}

@code {
    /// <summary>The kit component this draws. Its parameters are read on every render.</summary>
    [Parameter, EditorRequired]
    public SoloKitComponent Source { get; set; } = null!;

    /// <summary>Set under the page an app keeps open to draw contributions itself.</summary>
    [CascadingParameter]
    public KitSurface? Surface { get; set; }

    /// <summary>A picker's value when it is one of its options, and nothing when it is not.</summary>
    private static string? Picked(SoloPicker picker) =>
        picker.Options.Any(option => option.Value == picker.Value) ? picker.Value : null;

    /// <summary>A flag is there or it isn't: an attribute with no value is left out of the page altogether.</summary>
    private static string? Flag(bool set) => set ? "1" : null;

    private RenderFragment RowParts(SoloRow row) => @<text>
        @if (row.Icon is not null)
        {
            <MudIcon Icon="@SoloIcons.Resolve(row.Icon)" Size="Size.Small" Color="Color.Primary" />
        }
        <span class="solo-kit-row__text">
            <span class="solo-kit-row__title text-truncate">@row.Title</span>
            @if (row.Subtitle is not null)
            {
                <span class="solo-kit-row__subtitle text-truncate">@row.Subtitle</span>
            }
        </span>
        @row.ChildContent
    </text>;

    /// <summary>A row with only a handler is a button in all but element, so it answers the keys a button does.</summary>
    private static Task PressAsync(KeyboardEventArgs key, SoloRow row) =>
        key.Key is "Enter" or " " ? row.OnClick.InvokeAsync() : Task.CompletedTask;

    private static int Gap(SoloSpacing spacing) => spacing switch
    {
        SoloSpacing.None => 0,
        SoloSpacing.Small => 1,
        SoloSpacing.Medium => 2,
        _ => 4,
    };

    private static AlignItems Across(SoloAlign align) => align switch
    {
        SoloAlign.Center => AlignItems.Center,
        SoloAlign.End => AlignItems.End,
        SoloAlign.Stretch => AlignItems.Stretch,
        _ => AlignItems.Start,
    };

    private static Typo Type(SoloTextVariant variant) => variant switch
    {
        SoloTextVariant.Caption => Typo.caption,
        SoloTextVariant.Label => Typo.subtitle2,
        SoloTextVariant.Heading => Typo.h6,
        _ => Typo.body2,
    };

    private static Variant Weight(SoloButtonVariant variant) => variant switch
    {
        SoloButtonVariant.Primary => Variant.Filled,
        SoloButtonVariant.Plain => Variant.Text,
        _ => Variant.Outlined,
    };

    /// <summary>Muted is the colour core gives its own secondary text; the unmarked tone is the place's own.</summary>
    private static Color Tone(SoloTone tone, Color unmarked) => tone switch
    {
        SoloTone.Muted => Color.Secondary,
        SoloTone.Primary => Color.Primary,
        SoloTone.Success => Color.Success,
        SoloTone.Warning => Color.Warning,
        SoloTone.Danger => Color.Error,
        _ => unmarked,
    };
}
