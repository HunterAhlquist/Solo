@page "/kit-surface"
@namespace Solo.Client.Kit
@implements IAsyncDisposable
@using System.Text.Json
@using Solo.Client.Extensions
@using Solo.Client.Hosting
@inject HostShell Shell
@inject IJSRuntime Js
@inject ExtensionCatalog Extensions
@inject NavigationManager Navigation

@*
    The page an app keeps open, unseen, to draw extensions' contributions
    itself (see KitSurface.cs). It has nothing to show a person, and outside a
    hosting app it does not exist.
*@

@if (!Shell.IsHosted)
{
    <MudAlert Severity="Severity.Warning" Class="ma-8">That page doesn't exist.</MudAlert>
}
else
{
    <CascadingValue Value="_surface" IsFixed="true">
        <div id="solo-kit-surface" aria-hidden="true">
            @foreach (var mount in _mounts.Values)
            {
                <div @key="mount.Id" data-kit-mount="@mount.Id">
                    <KitMountView Mount="mount" Skip="_skip" OnTaskChanged="TaskChangedAsync" />
                </div>
            }
        </div>
    </CascadingValue>
}

@code {
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);

    private readonly KitSurface _surface = new();
    private readonly Dictionary<string, KitMount> _mounts = new(StringComparer.Ordinal);
    private IReadOnlySet<string> _skip = new HashSet<string>();
    private IJSObjectReference? _module;
    private DotNetObjectReference<KitSurfacePage>? _self;
    private bool _started;

    /// <summary>What the app sends: a place to mount, to drop, or to read again.</summary>
    private sealed record Request(string Op, string? Id, string? Seam, Guid? Project, Guid? Board, Guid? Task);

    private IDisposable? _navigation;

    protected override void OnInitialized()
    {
        Extensions.Changed += OnExtensionsChanged;
        if (Shell.IsHosted)
        {
            Shell.OnKitSurface = true;
            _navigation = Navigation.RegisterLocationChangingHandler(OnLocationChanging);
        }
    }

    /// <summary>
    /// A contribution that navigates from a handler would take this page away,
    /// and every other contribution with it. The page stays; where it was asked
    /// to go is handed to the app, which opens it.
    /// </summary>
    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        context.PreventNavigation();
        try
        {
            await Shell.OpenAsync(Js, Navigation.ToBaseRelativePath(Navigation.ToAbsoluteUri(context.TargetLocation).AbsoluteUri));
        }
        catch (ArgumentException)
        {
            // Somewhere off the instance: not this page's to open, nor the app's to be asked.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Shell.IsHosted)
        {
            return;
        }

        _self = DotNetObjectReference.Create(this);
        _module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/kit-surface.js");
        // The extensions the app draws itself come back from the script, which reads them off the host.
        _skip = (await _module.InvokeAsync<string[]>("start", _self, "solo-kit-surface")).ToHashSet(StringComparer.Ordinal);
        _started = true;
        await AnnounceAsync();
    }

    private void OnExtensionsChanged() => _ = InvokeAsync(async () =>
    {
        await AnnounceAsync();
        StateHasChanged();
    });

    /// <summary>
    /// Tells the app which places any extension contributes to, once that is
    /// known: an app with nothing to draw can then close this page again.
    /// </summary>
    private async Task AnnounceAsync()
    {
        if (!_started || !Extensions.Settled || _module is null)
        {
            return;
        }

        var seams = KitSeams.All.Where(seam => KitSeams.Find(seam, Extensions, _skip).Count > 0).ToArray();
        await _module.InvokeVoidAsync("announce", (object)seams);
    }

    [JSInvokable]
    public Task Receive(string json)
    {
        Request? request;
        try
        {
            request = JsonSerializer.Deserialize<Request>(json, Json);
        }
        catch (JsonException)
        {
            return Task.CompletedTask;
        }

        if (request?.Id is not { Length: > 0 and <= 64 } id)
        {
            return Task.CompletedTask;
        }

        switch (request.Op)
        {
            case "mount" when request.Seam is not null && KitSeams.All.Contains(request.Seam):
                _mounts[id] = new KitMount(id, request.Seam, request.Project, request.Board, request.Task);
                break;
            case "unmount":
                _mounts.Remove(id);
                break;
            case "refresh" when _mounts.TryGetValue(id, out var mount):
                _mounts[id] = mount with { Revision = mount.Revision + 1 };
                break;
            default:
                return Task.CompletedTask;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>A task-detail contribution saved something: the app's copy of the task is stale.</summary>
    private async Task TaskChangedAsync(Guid taskId)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("taskChanged", taskId.ToString());
        }
    }

    public async ValueTask DisposeAsync()
    {
        Extensions.Changed -= OnExtensionsChanged;
        _navigation?.Dispose();
        Shell.OnKitSurface = false;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("stop");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }

        _self?.Dispose();
    }
}
