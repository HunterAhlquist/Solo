@page "/mcp"
@attribute [Authorize]
@using Solo.Client.Api
@inject ApiClient Api
@inject InstanceConnection Instance
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IJSRuntime Js

@*
    Lets a person connect an LLM to this Solo instance: generate a token, then
    copy the config their client wants.

    The page is core, the feature is not. Tokens, the endpoint and the whole MCP
    surface live in the `mcp` extension package; everything here is a consumer of
    /api/ext/mcp/… and says so plainly when the package is absent. It lives in
    core only because an extension's client assembly has no supported way to make
    an authenticated API call yet.
*@

<PageTitle>MCP access · Solo</PageTitle>

<MudText Typo="Typo.h1" Class="mb-4">MCP access</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_info is null)
{
    @* Not installed. Say what is missing and who can fix it, rather than
       rendering a token page for an endpoint that would 404. *@
    <MudAlert Severity="Severity.Info" Class="mb-4" Style="max-width:44rem">
        <MudText Typo="Typo.body1" Class="mb-1">The MCP server isn't installed on this instance.</MudText>
        <MudText Typo="Typo.body2">
            It ships as an extension package. An admin can install it by copying
            <b>solo-mcp-&lt;version&gt;.zip</b> into the instance's extensions directory and
            restarting — extensions are fixed at startup, so there is no rescan.
        </MudText>
    </MudAlert>
}
else
{
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4" Style="max-width:44rem">
        Connect an AI assistant to Solo and it can read your boards and create,
        edit and move tasks — acting as you, and reaching only the projects you
        are a member of.
    </MudText>

    @* ------------------------------------------------------------------ *@
    @* The token                                                          *@
    @* ------------------------------------------------------------------ *@
    <MudPaper Elevation="1" Class="pa-4 mb-4" Style="max-width:44rem">
        <MudText Typo="Typo.h4" Class="mb-1">Your token</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            One token per account. Generating a new one immediately blocks the old
            one, so anything still using it stops working.
        </MudText>

        @* Shown once, and never retrievable: the server keeps only a hash. *@
        @if (_secret is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                <MudText Typo="Typo.body2" Class="mb-2">
                    <b>Copy this now.</b> It won't be shown again — if you lose it, generate another.
                </MudText>
                <div class="d-flex align-center gap-2">
                    <MudTextField T="string" Value="@_secret" ReadOnly="true" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" Class="mcp-token" Label="Token" />
                    <MudTooltip Text="Copy to clipboard">
                        <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                       OnClick="@(() => CopyAsync(_secret))" aria-label="Copy token" />
                    </MudTooltip>
                </div>
            </MudAlert>
        }

        @if (_status?.Active is { } active)
        {
            <MudSimpleTable Dense="true" Elevation="0" Class="mb-4">
                <tbody>
                    <tr>
                        <td><MudText Typo="Typo.body2" Color="Color.Secondary">Created</MudText></td>
                        <td><MudText Typo="Typo.body2">@Local(active.CreatedAt)</MudText></td>
                    </tr>
                    <tr>
                        <td><MudText Typo="Typo.body2" Color="Color.Secondary">Last used</MudText></td>
                        <td>
                            <MudText Typo="Typo.body2">
                                @(active.LastUsedAt is { } used ? Local(used) : "never")
                            </MudText>
                        </td>
                    </tr>
                    @if (active.Description is { Length: > 0 } label)
                    {
                        <tr>
                            <td><MudText Typo="Typo.body2" Color="Color.Secondary">Label</MudText></td>
                            <td><MudText Typo="Typo.body2">@label</MudText></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>

            <div class="d-flex gap-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy"
                           StartIcon="@Icons.Material.Filled.Autorenew" OnClick="@RegenerateAsync">
                    Regenerate
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@_busy"
                           StartIcon="@Icons.Material.Filled.Block" OnClick="@RevokeAsync">
                    Revoke
                </MudButton>
            </div>
        }
        else
        {
            <MudTextField @bind-Value="_description" Label="Label (optional)" Variant="Variant.Outlined"
                          Margin="Margin.Dense" MaxLength="200" Class="mb-3"
                          HelperText="What you're connecting, e.g. &quot;Claude Code on the laptop&quot;." />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy"
                       StartIcon="@Icons.Material.Filled.Key" OnClick="@GenerateAsync">
                Generate token
            </MudButton>
        }
    </MudPaper>

    @* ------------------------------------------------------------------ *@
    @* Connection instructions                                            *@
    @* ------------------------------------------------------------------ *@
    <MudPaper Elevation="1" Class="pa-4 mb-4" Style="max-width:44rem">
        <MudText Typo="Typo.h4" Class="mb-1">Connect a client</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Solo speaks MCP over HTTP at
            <code>@Endpoint</code>, protocol revision @_info.ProtocolVersion.
            @if (_isDesktop)
            {
                <span>
                    You're in the desktop app, so that address is the local shell — use your
                    instance's own URL in the configuration below.
                </span>
            }
        </MudText>

        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4">
            <MudTabPanel Text="Claude Code">
                <Snippet Title="Run this once" Text="@ClaudeCodeCommand" OnCopy="@CopyAsync" />
            </MudTabPanel>
            <MudTabPanel Text="JSON config">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Most desktop clients — Claude Desktop, Cursor, Windsurf — read a config file
                    with an <code>mcpServers</code> object. Add Solo to yours:
                </MudText>
                <Snippet Title="mcp.json" Text="@JsonConfig" OnCopy="@CopyAsync" />
            </MudTabPanel>
            <MudTabPanel Text="VS Code">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Put this in <code>.vscode/mcp.json</code> in your workspace.
                </MudText>
                <Snippet Title=".vscode/mcp.json" Text="@VsCodeConfig" OnCopy="@CopyAsync" />
            </MudTabPanel>
            <MudTabPanel Text="Anything else">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
                    Any MCP client that supports a streamable-HTTP server and a custom header:
                </MudText>
                <Snippet Title="Endpoint" Text="@Endpoint" OnCopy="@CopyAsync" />
                <Snippet Title="Header" Text="@($"Authorization: Bearer {TokenOrPlaceholder}")"
                         OnCopy="@CopyAsync" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2 d-block">
                    POST only — the endpoint is stateless and offers no event stream, so a client
                    that insists on opening a GET stream will see 405.
                </MudText>
            </MudTabPanel>
        </MudTabs>
    </MudPaper>

    @* ------------------------------------------------------------------ *@
    @* Tools                                                              *@
    @* ------------------------------------------------------------------ *@
    <MudPaper Elevation="1" Class="pa-4" Style="max-width:44rem">
        <MudText Typo="Typo.h4" Class="mb-1">What it can do</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @_info.Tools.Count tools, from MCP server version @_info.ServerVersion.
        </MudText>

        <MudSimpleTable Dense="true" Elevation="0">
            <tbody>
                @foreach (var tool in _info.Tools)
                {
                    <tr>
                        <td style="white-space:nowrap"><code>@tool.Name</code></td>
                        <td><MudText Typo="Typo.body2">@tool.Description</MudText></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

@code {
    private McpInfoDto? _info;
    private McpTokenStatusDto? _status;
    private string? _secret;
    private string? _description;
    private string? _error;
    private bool _loading = true;
    private bool _busy;
    private bool _isDesktop;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _info = await Api.GetMcpInfoAsync();
            if (_info is not null)
            {
                _status = await Api.GetMcpTokensAsync();
            }
        }
        catch (ApiException e)
        {
            _error = e.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _isDesktop = await Js.InvokeAsync<bool>("solo.desktop.available");
        }
        catch (JSException)
        {
            // Interop unavailable (prerender, or a stripped shell): the extra
            // sentence is a nicety, not a requirement.
        }

        if (_isDesktop)
        {
            StateHasChanged();
        }
    }

    private Task GenerateAsync() => MintAsync();

    /// <summary>
    /// Regeneration is destructive to whatever is already connected, so it asks
    /// first — the old token stops working the instant the new one exists.
    /// </summary>
    private async Task RegenerateAsync()
    {
        if (await ConfirmAsync(
                "Regenerate token",
                "Your current token stops working immediately. Any assistant still using it " +
                "loses access until you give it the new one.",
                "Regenerate"))
        {
            await MintAsync();
        }
    }

    private async Task MintAsync()
    {
        _busy = true;
        try
        {
            var minted = await Api.CreateMcpTokenAsync(_description);
            _secret = minted.Value;
            _description = null;
            _status = await Api.GetMcpTokensAsync();
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RevokeAsync()
    {
        if (!await ConfirmAsync(
                "Revoke token",
                "Anything using this token loses access immediately. You can generate a new one at any time.",
                "Revoke"))
        {
            return;
        }

        _busy = true;
        try
        {
            await Api.RevokeMcpTokenAsync();
            _secret = null;
            _status = await Api.GetMcpTokensAsync();
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> ConfirmAsync(string title, string message, string confirmText)
    {
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>(
            title,
            new DialogParameters<ConfirmDialog>
            {
                { d => d.Message, message },
                { d => d.ConfirmText, confirmText },
            });

        return await dialog.Result is { Canceled: false };
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            if (await Js.InvokeAsync<bool>("solo.clipboard.write", text))
            {
                Snackbar.Add("Copied.", Severity.Success);
                return;
            }
        }
        catch (JSException)
        {
            // Fall through to the same advice.
        }

        Snackbar.Add("Couldn't reach the clipboard — select the text and copy it.", Severity.Warning);
    }

    // -- The snippets -------------------------------------------------------

    private string Endpoint => Instance.Resolve(ApiClient.McpEndpointPath).ToString();

    /// <summary>
    /// The real token while it is still on screen, a placeholder afterwards —
    /// the server cannot give it back, so the snippets stop pretending it can.
    /// </summary>
    private string TokenOrPlaceholder => _secret ?? "YOUR_TOKEN";

    private string ClaudeCodeCommand =>
        $"claude mcp add --transport http solo {Endpoint} \\\n" +
        $"  --header \"Authorization: Bearer {TokenOrPlaceholder}\"";

    private string JsonConfig =>
        $$"""
          {
            "mcpServers": {
              "solo": {
                "type": "http",
                "url": "{{Endpoint}}",
                "headers": {
                  "Authorization": "Bearer {{TokenOrPlaceholder}}"
                }
              }
            }
          }
          """;

    private string VsCodeConfig =>
        $$"""
          {
            "servers": {
              "solo": {
                "type": "http",
                "url": "{{Endpoint}}",
                "headers": {
                  "Authorization": "Bearer {{TokenOrPlaceholder}}"
                }
              }
            }
          }
          """;

    private static string Local(DateTimeOffset value) => value.ToLocalTime().ToString("g");
}
