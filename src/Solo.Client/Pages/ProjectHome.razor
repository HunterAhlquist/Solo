@page "/projects/{ProjectAlias}"
@attribute [Authorize]
@using Solo.Client.Extensions
@implements IDisposable
@inject ApiClient Api
@inject ExtensionCatalog Extensions
@inject UserSession Session
@inject RecentProjectsStore Recent
@inject ISnackbar Snackbar

<PageTitle>@(_project?.Name ?? "Project") · Solo</PageTitle>

@if (_project is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="d-flex align-center mb-4" style="gap:.75rem">
        <EntityIcon ImageId="@_project.ImageId" Icon="@_project.Icon" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h1">@_project.Name</MudText>
    </div>

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
        <MudTabPanel Text="@WorkTabText" Icon="@Icons.Material.Filled.ViewKanban">
            @* Headers only once an extension adds a section: alone, Boards needs no
               label beyond its tab. *@
            @if (HomeSections.Count > 0)
            {
                <PageSectionHeader Title="Boards" />
            }
            <BoardsGrid ProjectId="@_project.Id" ProjectAlias="@_project.Alias" CanWrite="@_canWrite" />

            @* Each contributed section under its own boundary, as in the sidebar:
               one that throws costs a line of error text, not the page. *@
            @foreach (var contributed in HomeSections)
            {
                <PageSectionHeader Title="@contributed.Title" />
                <ErrorBoundary @key="(_project.Id, contributed.Component)">
                    <ChildContent>
                        <DynamicComponent Type="@contributed.Component" Parameters="@SectionParameters(_project)" />
                    </ChildContent>
                    <ErrorContent>
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">
                            @contributed.Title couldn't load.
                        </MudText>
                    </ErrorContent>
                </ErrorBoundary>
            }
        </MudTabPanel>

        <MudTabPanel Text="Members" Icon="@Icons.Material.Filled.People">
            <MembersTab ProjectId="@_project.Id" IsOwner="@_isOwner" OnMembersChanged="@LoadProjectAsync" />
        </MudTabPanel>

        @if (_canWrite)
        {
            <MudTabPanel Text="Label defaults" Icon="@Icons.Material.Filled.Label">
                <LabelsTab ProjectId="@_project.Id" CanWrite="@_canWrite" />
            </MudTabPanel>
        }

        @if (_isOwner)
        {
            <MudTabPanel Text="Audit" Icon="@Icons.Material.Filled.History">
                <AuditTab ProjectId="@_project.Id" Members="@_project.Members" />
            </MudTabPanel>

            <MudTabPanel Text="Settings" Icon="@Icons.Material.Filled.Settings">
                <ProjectSettingsTab Project="@_project" OnSaved="@OnProjectSaved"
                                    Sections="@SettingsSections" SectionParameters="@SectionParameters(_project)" />
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    private ProjectDto? _project;
    private bool _isOwner;
    private bool _canWrite;

    [Parameter]
    public string ProjectAlias { get; set; } = string.Empty;

    /// <summary>
    /// The layout hydrates the session too, but it races this page — and every tab
    /// here is gated on the signed-in user's id and super-admin flag. Without this,
    /// an owner sees neither the Audit nor the Settings tab.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        Extensions.Changed += OnExtensionsChanged;

        if (Session.Current is null)
        {
            try
            {
                await Session.LoadAsync();
            }
            catch (ApiException)
            {
                // Non-fatal: the project loads, permissions stay at their minimum.
            }
        }
    }

    protected override Task OnParametersSetAsync() => LoadProjectAsync();

    private Guid _recorded;

    /// <summary>Remember this project so the sidebar can unfold recent work.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The route only carries the alias; the id arrives with the payload.
        if (_project is not { } project || _recorded == project.Id)
        {
            return;
        }

        _recorded = project.Id;
        try
        {
            await Recent.RecordAsync(project.Id);
        }
        catch (JSException)
        {
            // Storage unavailable (private mode, say) — recents are best-effort.
        }
    }

    private async Task LoadProjectAsync()
    {
        try
        {
            _project = await Api.GetProjectByAliasAsync(ProjectAlias);

            // Membership decides which tabs exist at all.
            (_isOwner, _canWrite) = Session.AccessIn(_project.Members);
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't load that project.", Severity.Error);
        }
    }

    private void OnProjectSaved(ProjectDto project) => _project = project;

    private IReadOnlyList<ContributedSection>? _sections;

    private IReadOnlyList<ContributedSection> HomeSections => _sections ??=
        ContributedSections.Find<Solo.Shared.Extensibility.ProjectHomeSectionAttribute>(
            Extensions, a => a.Title, a => a.Order);

    private IReadOnlyList<ContributedSection>? _settingsSections;

    private IReadOnlyList<ContributedSection> SettingsSections => _settingsSections ??=
        ContributedSections.Find<Solo.Shared.Extensibility.ProjectSettingsSectionAttribute>(
            Extensions, a => a.Title, a => a.Order);

    /// <summary>"Boards", or "Boards & Roadmaps" once an extension adds a section to the tab.</summary>
    private string WorkTabText => HomeSections.Count == 0
        ? "Boards"
        : string.Join(", ", HomeSections.SkipLast(1).Select(s => s.Title).Prepend("Boards")) +
          " & " + HomeSections[^1].Title;

    /// <summary>The same shape the sidebar's sections get, so one component can serve both.</summary>
    private IDictionary<string, object> SectionParameters(ProjectDto project)
    {
        var me = project.Members.FirstOrDefault(m => m.UserId == Session.UserId);
        return new Dictionary<string, object>
        {
            ["Project"] = new ProjectSummaryDto(project.Id, project.Name, project.Alias, project.Icon,
                project.ImageId, me?.Role ?? ProjectRole.Read, me?.IsOwner ?? false),
            ["CanWrite"] = _canWrite,
        };
    }

    private void OnExtensionsChanged()
    {
        _sections = null;
        _settingsSections = null;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Extensions.Changed -= OnExtensionsChanged;
}
