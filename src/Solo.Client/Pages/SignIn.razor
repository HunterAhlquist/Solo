@page "/signin"
@layout EmptyLayout
@using System.Globalization
@implements IDisposable
@inject AppConfig Config
@inject NavigationManager Navigation
@inject GoogleIdentityService Google
@inject ThemeState Theme

<PageTitle>Sign in · @Config.SiteName</PageTitle>

@* Fixed backdrop behind the card. Redraws when the colour scheme changes, so a
   theme shipping a per-scheme image swaps with the toggle. *@
<div class="signin-backdrop" style="@BackdropStyle"></div>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center justify-center signin-content"
              Style="height:100vh">
    <MudPaper Elevation="2" Class="pa-8 width-100 d-flex flex-column align-center" Style="gap:1.5rem">
        @if (Theme.LoginLogo is { Length: > 0 } logo)
        {
            <img src="@logo" alt="@Config.SiteName" class="signin-logo" />
        }
        else
        {
            <MudText Typo="Typo.h1" Align="Align.Center">@Config.SiteName</MudText>
        }
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
            @Config.Tagline
        </MudText>

        @if (Unauthorized)
        {
            <MudAlert Severity="Severity.Error" Dense="true">
                Your account isn't authorized to use this instance. Ask an
                administrator to invite you to a project, then sign in again.
            </MudAlert>
        }

        @if (!Config.ProviderConfigured)
        {
            <MudAlert Severity="Severity.Error" Dense="true">
                No identity provider is configured on this instance.
            </MudAlert>
        }
        else if (Config.IsGoogle)
        {
            @* Google renders its own button and calls back with an ID token. *@
            <GoogleSignInButton OnSignedIn="@GoToReturnUrl" />

            @* Checked: the credential persists across browser restarts and is
               renewed silently on return. Unchecked: it lives with the tab. *@
            <MudCheckBox T="bool" Value="_staySignedIn" ValueChanged="@SetStaySignedIn"
                         Label="Stay signed in on this device" Dense="true" />
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       StartIcon="@ProviderIcon" OnClick="@BeginSignIn">
                Continue with @Config.ProviderName
            </MudButton>
        }
    </MudPaper>
</MudContainer>

@code {
    private bool _staySignedIn = true;

    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += OnThemeChanged;

        if (Config.IsGoogle)
        {
            _staySignedIn = await Google.GetRememberAsync();
        }
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Theme.Changed -= OnThemeChanged;

    /// <summary>
    /// The theme's login background as custom properties for
    /// <c>.signin-backdrop</c>. Empty when the theme ships no image, which
    /// leaves the CSS on the palette background.
    /// </summary>
    private string BackdropStyle
    {
        get
        {
            if (Theme.LoginBackground is not { Image: { Length: > 0 } image } background)
            {
                return string.Empty;
            }

            // Absolute, not the app-relative path the API returns. A relative
            // url() inside a custom property resolves against the stylesheet
            // that *consumes* the variable — app.css, under /css/ — rather than
            // the document base, so the relative form 404s.
            //
            // The URL comes from the instance's own theme catalog, which only
            // ever yields api/themes/... paths, so there is nothing here for a
            // quote to break out of.
            var url = Navigation.ToAbsoluteUri(image);
            var style = $"--signin-image:url('{url}');--signin-size:{Size(background.Fit)};";

            if (background.Position is { Length: > 0 } position)
            {
                style += $"--signin-position:{position};";
            }

            if (background.Scrim > 0)
            {
                style += $"--signin-scrim:{background.Scrim.ToString(CultureInfo.InvariantCulture)};";
            }

            if (background.Color is { Length: > 0 } color)
            {
                style += $"--signin-color:{color};";
            }

            return style;
        }
    }

    /// <summary>
    /// Fit mode to <c>background-size</c>. Width and Height pin one axis and let
    /// the other follow the aspect ratio; Cover and Contain let the browser
    /// choose which axis that is.
    /// </summary>
    private static string Size(ThemeBackgroundFit fit) => fit switch
    {
        ThemeBackgroundFit.Contain => "contain",
        ThemeBackgroundFit.Width => "100% auto",
        ThemeBackgroundFit.Height => "auto 100%",
        ThemeBackgroundFit.Stretch => "100% 100%",
        _ => "cover",
    };

    private async Task SetStaySignedIn(bool value)
    {
        _staySignedIn = value;
        await Google.SetRememberAsync(value);
    }

    private string ProviderIcon => Config.Auth?.Provider?.ToLowerInvariant() switch
    {
        "google" => Icons.Custom.Brands.Google,
        "microsoft" => Icons.Custom.Brands.Microsoft,
        _ => Icons.Material.Filled.Login,
    };

    /// <summary>Set when the app signed the user out because their account can reach nothing.</summary>
    private bool Unauthorized => QueryString.Value(Navigation.Uri, "error") == "unauthorized";

    /// <summary>Where the user was headed before the guard bounced them here.</summary>
    private string ReturnUrl => QueryString.Value(Navigation.Uri, "returnUrl") is { Length: > 0 } url ? url : "/";

    /// <summary>Google signs in without a redirect, so we do the navigation ourselves.</summary>
    private void GoToReturnUrl() => Navigation.NavigateTo(ReturnUrl, replace: true);

    private void BeginSignIn() =>
        Navigation.NavigateToLogin("authentication/login", new InteractiveRequestOptions
        {
            Interaction = InteractionType.SignIn,
            ReturnUrl = Navigation.ToAbsoluteUri(ReturnUrl).ToString(),
        });
}
