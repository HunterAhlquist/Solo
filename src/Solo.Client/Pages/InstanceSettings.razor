@page "/settings"
@attribute [Authorize]
@inject ApiClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ThemeState Theme
@inject IDialogService Dialogs

<PageTitle>Admin settings · Solo</PageTitle>

<MudText Typo="Typo.h1" Class="mb-4">Admin settings</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_settings is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Elevation="1" Class="pa-4 mb-4" Style="max-width:32rem">
        <MudText Typo="Typo.h4" Class="mb-1">Audit retention</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Audit entries older than this are pruned automatically.
        </MudText>

        @* Blur commits — no save-per-keystroke. *@
        <MudNumericField T="int" @bind-Value="_retentionDays" Label="Days" Variant="Variant.Outlined"
                         Margin="Margin.Dense" Min="1" Max="3650" Immediate="false" OnBlur="@SaveAsync" />

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-4 d-block">
            Setup completed: @(_settings.SetupCompleted ? "yes" : "no")
        </MudText>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-4" Style="max-width:32rem">
        <div class="d-flex align-center mb-1">
            <MudText Typo="Typo.h4">Theme</MudText>
            <MudSpacer />
            <MudTooltip Text="Re-read the themes directory">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                               Disabled="@_rescanning" OnClick="@RescanAsync" aria-label="Rescan themes" />
            </MudTooltip>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Applies to everyone on this instance. Each person still chooses light
            or dark for themselves, from their profile menu.
        </MudText>

        @* The chosen theme's package is gone from the themes directory. The
           setting is deliberately left pointing at it: restore the package and
           it comes back, whereas silently rewriting the choice would lose it. *@
        @if (Theme.IsFallback)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                @Theme.FallbackMessage Restore its package in the themes directory
                and rescan, or choose another theme below.
            </MudAlert>
        }

        @if (_themes is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudRadioGroup T="string" Value="@_themeId" ValueChanged="@SelectThemeAsync">
                @foreach (var theme in _themes.Themes)
                {
                    <MudRadio T="string" Value="@theme.Id" Dense="true" Class="mb-2">
                        <div>
                            <MudText Typo="Typo.body1">
                                @theme.Name
                                @if (theme.IsBuiltIn)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">built-in</MudText>
                                }
                            </MudText>
                            @if (theme.Description is { Length: > 0 })
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@theme.Description</MudText>
                            }
                        </div>
                    </MudRadio>
                }
            </MudRadioGroup>

            @* A rejected package is invisible otherwise: the operator dropped a
               file in and nothing appeared. Say which file and why. *@
            @if (_themes.Errors.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                    <MudText Typo="Typo.body2" Class="mb-1">Some packages were not loaded:</MudText>
                    @foreach (var failure in _themes.Errors)
                    {
                        <MudText Typo="Typo.caption" Class="d-block"><b>@failure.File</b> — @failure.Message</MudText>
                    }
                </MudAlert>
            }

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-4 d-block">
                Add a theme by copying its .zip into the instance's themes directory,
                then rescanning. Reload the page to see a change applied.
            </MudText>
        }
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-4 mt-4" Style="max-width:44rem">
        <MudText Typo="Typo.h4" Class="mb-1">Extensions</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Packages in the extensions directory. Installing, updating or removing one
            takes a restart — unlike themes, there is no rescan.
        </MudText>

        @if (_extensions is null)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
        }
        else
        {
            @if (_extensions.Extensions.Count == 0 && _extensions.Failures.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No extensions installed.</MudText>
            }

            @foreach (var extension in _extensions.Extensions)
            {
                <div class="d-flex align-center py-2">
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.body1">
                            @(extension.DisplayName ?? extension.ExtensionId)
                            <MudChip T="string" Size="Size.Small" Class="ml-2"
                                     Color="@StateColour(extension.State)">@StateLabel(extension)</MudChip>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @extension.ExtensionId@(extension.Version is null ? "" : $" · {extension.Version}")
                            @(extension.SchemaName is null ? "" : $" · {extension.SchemaName}")
                        </MudText>

                        @if (extension.FailureReason is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">
                                @extension.FailureReason
                            </MudText>
                        }

                        @* Which extensions sit on which write path. Without this,
                           "why can't I move this card?" has no quick answer. *@
                        @if (extension.Hooks.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                Intercepts: @string.Join(", ", extension.Hooks)
                            </MudText>
                        }
                    </div>

                    @if (extension.CanPurge)
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                   OnClick="@(() => PurgeAsync(extension))">
                            Delete data
                        </MudButton>
                    }
                </div>
                <MudDivider />
            }

            @foreach (var failure in _extensions.Failures)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                    <strong>@failure.Source</strong> — @failure.Reason
                </MudAlert>
            }
        }
    </MudPaper>

    @* MCP tokens. Only rendered when the extension is installed — the audit is
       served by the package, so without it there is nothing to show and nothing
       to revoke. Deliberately metadata only: the instance stores hashes, so
       there is no token here for an admin to read. *@
    @if (_mcpTokens is not null)
    {
        <MudPaper Elevation="1" Class="pa-4 mt-4" Style="max-width:44rem">
            <div class="d-flex align-center mb-1">
                <MudText Typo="Typo.h4">MCP tokens</MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                           Disabled="@(LiveTokenCount == 0)"
                           StartIcon="@Icons.Material.Filled.Block" OnClick="@RevokeAllTokensAsync">
                    Revoke all
                </MudButton>
            </div>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                Credentials people have generated to connect an AI assistant. Each one acts as its
                owner and reaches only their projects. You can see that a token exists and how much
                it is used — never what it is.
            </MudText>

            @if (_mcpTokens.Tokens.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">Nobody has generated one yet.</MudText>
            }
            else
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">Requests, last 24 hours</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                    Every request a token authenticated, per hour, across the instance. One tool call
                    makes more than one — the endpoint re-enters the API for each read and write it does.
                </MudText>
                <div class="usage-bars mb-4" role="img"
                     aria-label="@($"{TotalRequests} requests in the last 24 hours")">
                    @for (var hour = 0; hour < HourlyTotals.Count; hour++)
                    {
                        var count = HourlyTotals[hour];
                        var at = _mcpTokens.WindowStart.AddHours(hour).ToLocalTime().ToString("t");
                        <MudTooltip Text="@($"{at} — {count} request{(count == 1 ? "" : "s")}")">
                            <div class="usage-bars__slot">
                                <div class="usage-bars__bar" style="@BarHeight(count, PeakHour)"></div>
                            </div>
                        </MudTooltip>
                    }
                </div>

                <MudSimpleTable Dense="true" Elevation="0">
                    <thead>
                        <tr>
                            <th>Owner</th>
                            <th>Created</th>
                            <th>Last used</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var token in _mcpTokens.Tokens)
                        {
                            <tr>
                                <td>
                                    <MudText Typo="Typo.body2">
                                        @(token.UserDisplayName ?? token.UserEmail ?? "unknown")
                                    </MudText>
                                    @if (token.Description is { Length: > 0 } label)
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@label</MudText>
                                    }
                                </td>
                                <td><MudText Typo="Typo.body2">@Local(token.CreatedAt)</MudText></td>
                                <td>
                                    <MudText Typo="Typo.body2">
                                        @(token.LastUsedAt is { } used ? Local(used) : "never")
                                    </MudText>
                                </td>
                                <td>
                                    @if (token.RevokedAt is { } revoked)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default">
                                            @RevocationLabel(token.RevokedReason)
                                        </MudChip>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                            @Local(revoked)
                                        </MudText>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success">live</MudChip>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    }
}

@code {
    private InstanceSettingsDto? _settings;
    private ThemeScanResultDto? _themes;
    private ExtensionAdminDto? _extensions;
    private McpTokenAdminDto? _mcpTokens;
    private int _retentionDays;
    private string? _themeId;
    private bool _rescanning;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _settings = await Api.GetInstanceSettingsAsync();
            _retentionDays = _settings.AuditRetentionDays;
            _themes = await Api.GetThemesAsync();
            // Null means "the default": show which theme that resolved to rather
            // than an empty radio group.
            _themeId = _settings.ThemeId ?? _themes.Themes.FirstOrDefault(t => t.IsActive)?.Id;
            _extensions = await Api.GetExtensionsAsync();
            _mcpTokens = await LoadMcpTokensAsync();
        }
        catch (ApiException e)
        {
            // The endpoint is super-admin only; a 403 here is a legitimate answer.
            _error = e.StatusCode == System.Net.HttpStatusCode.Forbidden
                ? "Only the instance super admin can change these settings."
                : e.Detail ?? "Couldn't load instance settings.";
        }
    }

    private async Task SelectThemeAsync(string themeId)
    {
        if (_settings is null || themeId == _themeId)
        {
            return;
        }

        var previous = _themeId;
        _themeId = themeId;

        if (!await SaveAsync())
        {
            _themeId = previous;
            return;
        }

        // The theme is fetched once during bootstrap, so the running app is
        // still on the old one. Reload rather than leave the admin looking at a
        // setting that hasn't visibly taken.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task<bool> SaveAsync()
    {
        if (_settings is null)
        {
            return false;
        }

        if (_retentionDays == _settings.AuditRetentionDays && _themeId == _settings.ThemeId)
        {
            return false;
        }

        try
        {
            _settings = await Api.UpdateInstanceSettingsAsync(new UpdateInstanceSettingsRequest
            {
                AuditRetentionDays = _retentionDays,
                ThemeId = _themeId,
                Version = _settings.Version,
            });
            _retentionDays = _settings.AuditRetentionDays;
            _themeId = _settings.ThemeId ?? _themeId;
            Snackbar.Add("Saved.", Severity.Success);
            return true;
        }
        catch (ApiConflictException)
        {
            await ReloadAsync();
            Snackbar.Add("Updated by someone else — your view was refreshed.", Severity.Info);
            return false;
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "That didn't save.", Severity.Error);
            await ReloadAsync();
            return false;
        }
    }

    /// <summary>
    /// Confirms with a retyped id, then drops the schema and the extension's
    /// keys from core's field bags. Only offered for an extension that is not
    /// loaded this boot — which is what makes the drop safe without locking.
    /// </summary>
    private async Task PurgeAsync(ExtensionRegistrationDto extension)
    {
        var dialog = await Dialogs.ShowAsync<TextPromptDialog>(
            $"Delete {extension.DisplayName ?? extension.ExtensionId} data",
            new DialogParameters
            {
                [nameof(TextPromptDialog.Message)] =
                    $"This drops the schema {extension.SchemaName ?? "(none)"} and every row in it, and removes "
                    + "this extension's custom fields from tasks, epics and boards. It cannot be undone — take a "
                    + $"pg_dump -n {extension.SchemaName} first if you might want the data back. "
                    + $"Type {extension.ExtensionId} to confirm.",
                [nameof(TextPromptDialog.Label)] = "Extension id",
                [nameof(TextPromptDialog.MaxLength)] = 64,
                [nameof(TextPromptDialog.SaveText)] = "Delete data",
            });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data?.ToString() != extension.ExtensionId)
        {
            return;
        }

        try
        {
            await Api.PurgeExtensionAsync(extension.ExtensionId);
            Snackbar.Add($"{extension.ExtensionId} data deleted.", Severity.Success);
            _extensions = await Api.GetExtensionsAsync();
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't delete that extension's data.", Severity.Error);
        }
    }

    // -- MCP tokens ---------------------------------------------------------
    // Served by the mcp extension package, so absence is normal rather than an
    // error: an instance without it simply has no section here.

    private int LiveTokenCount => _mcpTokens?.Tokens.Count(t => t.RevokedAt is null) ?? 0;

    /// <summary>Requests per hour across every token — the instance-wide series.</summary>
    private IReadOnlyList<int> HourlyTotals => _mcpTokens is null || _mcpTokens.Tokens.Count == 0
        ? []
        : Enumerable.Range(0, _mcpTokens.Tokens.Max(t => t.Usage.Count))
            .Select(hour => _mcpTokens.Tokens.Sum(t => hour < t.Usage.Count ? t.Usage[hour] : 0))
            .ToList();

    private int PeakHour => HourlyTotals.Count == 0 ? 0 : HourlyTotals.Max();

    private int TotalRequests => HourlyTotals.Sum();

    private async Task<McpTokenAdminDto?> LoadMcpTokensAsync()
    {
        try
        {
            return await Api.GetMcpTokenAuditAsync();
        }
        catch (ApiException e) when (e.StatusCode is System.Net.HttpStatusCode.NotFound
                                         or System.Net.HttpStatusCode.ServiceUnavailable)
        {
            // The extension is not installed, or is disabled by a failed
            // migration — the extensions list above already says which.
            return null;
        }
    }

    /// <summary>
    /// Bar height as a share of the busiest hour, with a floor so an hour that
    /// saw traffic never renders as indistinguishable from one that saw none.
    /// </summary>
    private static string BarHeight(int count, int peak) => count == 0
        ? "height:2px"
        : $"height:{Math.Max(8, (int)Math.Round(count * 100.0 / Math.Max(peak, 1)))}%";

    private static string RevocationLabel(string? reason) => reason switch
    {
        "Regenerated" => "replaced",
        "RevokedByOwner" => "revoked by owner",
        "RevokedByAdmin" => "revoked by admin",
        _ => "revoked",
    };

    private static string Local(DateTimeOffset value) => value.ToLocalTime().ToString("g");

    /// <summary>
    /// The emergency lever. Blunt on purpose — everyone has to generate a new
    /// token afterwards — so it asks for the phrase rather than a single click.
    /// </summary>
    private async Task RevokeAllTokensAsync()
    {
        const string phrase = "revoke all tokens";
        var dialog = await Dialogs.ShowAsync<TextPromptDialog>(
            "Revoke every MCP token",
            new DialogParameters
            {
                [nameof(TextPromptDialog.Message)] =
                    $"This blocks all {LiveTokenCount} live token(s) on the instance at once. Every "
                    + "connected assistant stops working immediately, and each owner has to generate a "
                    + $"new token from their MCP access page. Type {phrase} to confirm.",
                [nameof(TextPromptDialog.Label)] = "Confirmation",
                [nameof(TextPromptDialog.MaxLength)] = 64,
                [nameof(TextPromptDialog.SaveText)] = "Revoke all",
            });

        var result = await dialog.Result;
        if (result is null || result.Canceled ||
            !string.Equals(result.Data?.ToString(), phrase, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        try
        {
            var revoked = await Api.RevokeAllMcpTokensAsync(phrase);
            Snackbar.Add($"Revoked {revoked.Revoked} MCP token(s).", Severity.Success);
            _mcpTokens = await LoadMcpTokensAsync();
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't revoke the tokens.", Severity.Error);
        }
    }

    private static Color StateColour(string state) => state switch
    {
        "Loaded" => Color.Success,
        "Failed" => Color.Error,
        _ => Color.Warning,
    };

    /// <summary>"Absent" is the interesting one: data present, package gone.</summary>
    private static string StateLabel(ExtensionRegistrationDto extension) => extension.State switch
    {
        "Loaded" => "loaded",
        "Failed" => "disabled",
        _ => "data present, package missing",
    };

    private async Task ReloadAsync()
    {
        _settings = await Api.GetInstanceSettingsAsync();
        _retentionDays = _settings.AuditRetentionDays;
        _themeId = _settings.ThemeId ?? _themes?.Themes.FirstOrDefault(t => t.IsActive)?.Id;
    }

    private async Task RescanAsync()
    {
        _rescanning = true;
        try
        {
            _themes = await Api.RescanThemesAsync();
            Snackbar.Add($"{_themes.Themes.Count} theme(s) available.", Severity.Success);
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't rescan themes.", Severity.Error);
        }
        finally
        {
            _rescanning = false;
        }
    }
}
