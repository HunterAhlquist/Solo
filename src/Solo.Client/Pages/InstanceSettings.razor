@page "/settings"
@attribute [Authorize]
@implements IDisposable
@using System.Reflection
@using Solo.Client.Extensions
@using Solo.Shared.Extensibility
@inject ApiClient Api
@inject IServiceProvider Services
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ThemeState Theme
@inject IDialogService Dialogs
@inject AppConfig Config

<PageTitle>Admin settings · @Config.SiteName</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Gutters="false">
<MudText Typo="Typo.h1" Class="mb-4">Admin settings</MudText>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_settings is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudText Typo="Typo.h4" Class="mb-1">Branding</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            What this instance is called: in the app bar, on the sign-in page and
            in page titles, and in the desktop app's list of instances. The
            tagline is the line under the name on the sign-in page. Leave either
            empty for the default.
        </MudText>

        @* Saved by the button rather than on blur, unlike the fields below: a
           new name reloads the page for everyone looking at it to take, which
           is not something to set off by tabbing out of a half-typed word.
           Immediate, so the button knows there is something to save. *@
        <MudTextField T="string" @bind-Value="_displayName" Label="Name" Variant="Variant.Outlined"
                      Margin="Margin.Dense" MaxLength="@InstanceBranding.MaxDisplayNameLength"
                      Placeholder="@InstanceBranding.ProductName" Immediate="true" Class="mb-3" />
        <MudTextField T="string" @bind-Value="_tagline" Label="Tagline" Variant="Variant.Outlined"
                      Margin="Margin.Dense" MaxLength="@InstanceBranding.MaxTaglineLength"
                      Placeholder="@InstanceBranding.DefaultTagline" Immediate="true" />

        <div class="d-flex justify-end mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="@(!BrandingChanged || _savingBranding)" OnClick="@SaveBrandingAsync">
                Save changes
            </MudButton>
        </div>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <MudText Typo="Typo.h4" Class="mb-1">Audit retention</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Audit entries older than this are deleted automatically.
        </MudText>

        @* Blur commits — no save-per-keystroke. *@
        <MudNumericField T="int" @bind-Value="_retentionDays" Label="Days" Variant="Variant.Outlined"
                         Margin="Margin.Dense" Min="1" Max="3650" Immediate="false" OnBlur="@SaveAsync" />

        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-4 d-block">
            Setup completed: @(_settings.SetupCompleted ? "yes" : "no")
        </MudText>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-4">
        <div class="d-flex align-center mb-1">
            <MudText Typo="Typo.h4">Theme</MudText>
            <MudSpacer />
            <MudTooltip Text="Reload themes from disk">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                               Disabled="@_rescanning" OnClick="@RescanAsync" aria-label="Rescan themes" />
            </MudTooltip>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Sets the theme for everyone on this instance. Each person can still
            choose light or dark from the profile menu.
        </MudText>

        @* The chosen theme's package is gone from the themes directory. The
           setting is deliberately left pointing at it: restore the package and
           it comes back, whereas silently rewriting the choice would lose it. *@
        @if (Theme.IsFallback)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
                @Theme.FallbackMessage Restore its package in the themes directory
                and rescan, or select another theme below.
            </MudAlert>
        }

        @if (_themes is null)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            <MudRadioGroup T="string" Value="@_themeId" ValueChanged="@SelectThemeAsync">
                @foreach (var theme in _themes.Themes)
                {
                    <MudRadio T="string" Value="@theme.Id" Dense="true" Class="mb-2">
                        <div>
                            <MudText Typo="Typo.body1">
                                @theme.Name
                                @if (theme.IsBuiltIn)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">built-in</MudText>
                                }
                            </MudText>
                            @if (theme.Description is { Length: > 0 })
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@theme.Description</MudText>
                            }
                        </div>
                    </MudRadio>
                }
            </MudRadioGroup>

            @* A rejected package is invisible otherwise: the operator dropped a
               file in and nothing appeared. Say which file and why. *@
            @if (_themes.Errors.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">
                    <MudText Typo="Typo.body2" Class="mb-1">Could not load these packages:</MudText>
                    @foreach (var failure in _themes.Errors)
                    {
                        <MudText Typo="Typo.caption" Class="d-block"><b>@failure.File:</b> @failure.Message</MudText>
                    }
                </MudAlert>
            }

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-4 d-block">
                To add a theme, copy its .zip file into the instance's themes directory
                and rescan. Reload the page to apply the change.
            </MudText>
        }
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-4 mt-4">
        <MudText Typo="Typo.h4" Class="mb-1">Extensions</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Extension packages are installed in the extensions directory. Installing,
            updating, or removing one requires a restart; extensions cannot be rescanned.
        </MudText>

        @if (_extensions is null)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
        }
        else
        {
            @if (_extensions.Extensions.Count == 0 && _extensions.Failures.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No extensions installed.</MudText>
            }

            @foreach (var extension in _extensions.Extensions)
            {
                <div class="d-flex align-center py-2">
                    <div class="flex-grow-1">
                        <MudText Typo="Typo.body1">
                            @(extension.DisplayName ?? extension.ExtensionId)
                            <MudChip T="string" Size="Size.Small" Class="ml-2"
                                     Color="@StateColour(extension.State)">@StateLabel(extension)</MudChip>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @extension.ExtensionId@(extension.Version is null ? "" : $" · {extension.Version}")
                            @(extension.SchemaName is null ? "" : $" · {extension.SchemaName}")
                        </MudText>

                        @if (extension.FailureReason is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">
                                @extension.FailureReason
                            </MudText>
                        }

                        @if (Catalog?.Skipped.FirstOrDefault(e => e.Id == extension.ExtensionId) is { } skipped)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="extension-client-warning mt-2">
                                Client pages unavailable: @skipped.Reason
                            </MudAlert>
                        }

                        @* Which extensions sit on which write path. Without this,
                           "why can't I move this card?" has no quick answer. *@
                        @if (extension.Hooks.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                Intercepts: @string.Join(", ", extension.Hooks)
                            </MudText>
                        }

                        @* The extension's own settings, from its client half. Only a
                           loaded extension has one to offer: a disabled one's routes
                           answer 503, and a missing package has no assembly at all. *@
                        @if (extension.State == "Loaded")
                        {
                            @foreach (var panel in SettingsPanels(extension.ExtensionId))
                            {
                                <div class="extension-settings mt-3">
                                    <ErrorBoundary @key="(extension.ExtensionId, panel)">
                                        <ChildContent>
                                            <DynamicComponent Type="@panel"
                                                              Parameters="@PanelParameters(extension.ExtensionId)" />
                                        </ChildContent>
                                        <ErrorContent>
                                            <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block">
                                                This extension's settings couldn't load.
                                            </MudText>
                                        </ErrorContent>
                                    </ErrorBoundary>
                                </div>
                            }
                        }
                    </div>

                    @if (extension.CanPurge)
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                   OnClick="@(() => PurgeAsync(extension))">
                            Delete data
                        </MudButton>
                    }
                </div>
                <MudDivider />
            }

            @foreach (var failure in _extensions.Failures)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                    <strong>@failure.Source:</strong> @failure.Reason
                </MudAlert>
            }
        }
    </MudPaper>

    <AdminUsersPanel />
}
</MudContainer>

@code {
    private InstanceSettingsDto? _settings;
    private ThemeScanResultDto? _themes;
    private ExtensionAdminDto? _extensions;
    private int _retentionDays;
    private string? _themeId;
    private string? _displayName;
    private string? _tagline;
    private bool _savingBranding;
    private bool _rescanning;
    private string? _error;

    private ExtensionCatalog? Catalog => Services.GetService<ExtensionCatalog>();

    /// <summary>Components the extension's own loaded client assembly marks as its settings.</summary>
    private IEnumerable<Type> SettingsPanels(string extensionId) =>
        (Catalog?.Loaded ?? [])
        .Where(e => e.Descriptor.Id == extensionId)
        .SelectMany(e => e.Assembly.GetExportedTypes())
        .Where(t => !t.IsAbstract && typeof(IComponent).IsAssignableFrom(t) &&
                    t.IsDefined(typeof(ExtensionSettingsAttribute)));

    private static IDictionary<string, object> PanelParameters(string extensionId) =>
        new Dictionary<string, object> { ["ExtensionId"] = extensionId };

    /// <summary>Client halves load after sign-in, possibly after this page first rendered.</summary>
    private void OnCatalogChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (Catalog is { } catalog)
        {
            catalog.Changed -= OnCatalogChanged;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (Catalog is { } catalog)
        {
            catalog.Changed += OnCatalogChanged;
        }

        try
        {
            _settings = await Api.GetInstanceSettingsAsync();
            _retentionDays = _settings.AuditRetentionDays;
            _displayName = _settings.DisplayName;
            _tagline = _settings.Tagline;
            _themes = await Api.GetThemesAsync();
            // Null means "the default": show which theme that resolved to rather
            // than an empty radio group.
            _themeId = _settings.ThemeId ?? _themes.Themes.FirstOrDefault(t => t.IsActive)?.Id;
            _extensions = await Api.GetExtensionsAsync();
        }
        catch (ApiException e)
        {
            // The endpoint is super-admin only; a 403 here is a legitimate answer.
            _error = e.StatusCode == System.Net.HttpStatusCode.Forbidden
                ? "Only the instance super admin can change these settings."
                : e.Detail ?? "Couldn't load instance settings.";
        }
    }

    private async Task SelectThemeAsync(string themeId)
    {
        if (_settings is null || themeId == _themeId)
        {
            return;
        }

        var previous = _themeId;
        _themeId = themeId;

        if (!await SaveAsync())
        {
            _themeId = previous;
            return;
        }

        // The theme is fetched once during bootstrap, so the running app is
        // still on the old one. Reload rather than leave the admin looking at a
        // setting that hasn't visibly taken.
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    /// <summary>A branding field as it would be stored: trimmed, and empty for none.</summary>
    private static string Stored(string? text) => text?.Trim() ?? string.Empty;

    private bool DisplayNameChanged => Stored(_displayName) != (_settings?.DisplayName ?? string.Empty);

    private bool BrandingChanged =>
        DisplayNameChanged || Stored(_tagline) != (_settings?.Tagline ?? string.Empty);

    private async Task SaveBrandingAsync()
    {
        if (_settings is null || !BrandingChanged)
        {
            return;
        }

        var nameChanged = DisplayNameChanged;
        _savingBranding = true;
        try
        {
            // The other settings go as they were last saved, not as the fields
            // above them currently read: this button saves the branding.
            var saved = await PutAsync(new UpdateInstanceSettingsRequest
            {
                AuditRetentionDays = _settings.AuditRetentionDays,
                ThemeId = _settings.ThemeId,
                // Empty rather than null to clear one: null is what a client
                // from before these fields existed sends, and leaves them be.
                DisplayName = Stored(_displayName),
                Tagline = Stored(_tagline),
                Version = _settings.Version,
            });
            if (!saved)
            {
                return;
            }

            _displayName = _settings.DisplayName;
            _tagline = _settings.Tagline;
        }
        finally
        {
            _savingBranding = false;
        }

        if (nameChanged)
        {
            // Read once during bootstrap, like the theme: reload rather than
            // leave the admin looking at an app bar that still has the old
            // name. In the desktop app the reload is also what tells the shell
            // to look again. The tagline is only on the sign-in page, which
            // fetches it fresh, so a change to it alone needs no reload.
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
    }

    /// <summary>Audit retention and the theme, which commit as they are changed.</summary>
    private async Task<bool> SaveAsync()
    {
        if (_settings is null)
        {
            return false;
        }

        if (_retentionDays == _settings.AuditRetentionDays && _themeId == _settings.ThemeId)
        {
            return false;
        }

        // No branding: whatever is typed there waits for its own button.
        var saved = await PutAsync(new UpdateInstanceSettingsRequest
        {
            AuditRetentionDays = _retentionDays,
            ThemeId = _themeId,
            Version = _settings.Version,
        });
        if (saved)
        {
            _retentionDays = _settings!.AuditRetentionDays;
            _themeId = _settings.ThemeId ?? _themeId;
        }
        return saved;
    }

    private async Task<bool> PutAsync(UpdateInstanceSettingsRequest request)
    {
        try
        {
            _settings = await Api.UpdateInstanceSettingsAsync(request);
            Snackbar.Add("Saved.", Severity.Success);
            return true;
        }
        catch (ApiConflictException)
        {
            await ReloadAsync();
            Snackbar.Add("Settings changed elsewhere. This page has been refreshed.", Severity.Info);
            return false;
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "That didn't save.", Severity.Error);
            await ReloadAsync();
            return false;
        }
    }

    /// <summary>
    /// Confirms with a retyped id, then drops the schema and the extension's
    /// keys from core's field bags. Only offered for an extension that is not
    /// loaded this boot — which is what makes the drop safe without locking.
    /// </summary>
    private async Task PurgeAsync(ExtensionRegistrationDto extension)
    {
        var dialog = await Dialogs.ShowAsync<TextPromptDialog>(
            $"Delete {extension.DisplayName ?? extension.ExtensionId} data",
            new DialogParameters
            {
                [nameof(TextPromptDialog.Message)] =
                    $"This permanently deletes schema {extension.SchemaName ?? "(none)"} and every row in it, and removes "
                    + "this extension's custom fields from tasks, epics, and boards. To keep a backup, run "
                    + $"pg_dump -n {extension.SchemaName} before continuing. "
                    + $"Type {extension.ExtensionId} to confirm.",
                [nameof(TextPromptDialog.Label)] = "Extension ID",
                [nameof(TextPromptDialog.MaxLength)] = 64,
                [nameof(TextPromptDialog.SaveText)] = "Delete data",
            });

        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data?.ToString() != extension.ExtensionId)
        {
            return;
        }

        try
        {
            await Api.PurgeExtensionAsync(extension.ExtensionId);
            Snackbar.Add($"{extension.ExtensionId} data deleted.", Severity.Success);
            _extensions = await Api.GetExtensionsAsync();
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't delete that extension's data.", Severity.Error);
        }
    }

    private static Color StateColour(string state) => state switch
    {
        "Loaded" => Color.Success,
        "Failed" => Color.Error,
        _ => Color.Warning,
    };

    /// <summary>"Absent" is the interesting one: data present, package gone.</summary>
    private static string StateLabel(ExtensionRegistrationDto extension) => extension.State switch
    {
        "Loaded" => "loaded",
        "Failed" => "disabled",
        _ => "data present, package missing",
    };

    private async Task ReloadAsync()
    {
        _settings = await Api.GetInstanceSettingsAsync();
        _retentionDays = _settings.AuditRetentionDays;
        _displayName = _settings.DisplayName;
        _tagline = _settings.Tagline;
        _themeId = _settings.ThemeId ?? _themes?.Themes.FirstOrDefault(t => t.IsActive)?.Id;
    }

    private async Task RescanAsync()
    {
        _rescanning = true;
        try
        {
            _themes = await Api.RescanThemesAsync();
            Snackbar.Add($"{_themes.Themes.Count} theme(s) available.", Severity.Success);
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't rescan themes.", Severity.Error);
        }
        finally
        {
            _rescanning = false;
        }
    }
}
