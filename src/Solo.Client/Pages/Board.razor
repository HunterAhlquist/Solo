@page "/projects/{ProjectAlias}/boards/{BoardAlias}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject ApiClient Api
@inject BoardStore Store
@inject IBoardHubClient Hub
@inject UserSession Session
@inject SaveGuard Guard
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject RecentProjectsStore Recent
@inject NavigationManager Nav
@inject DragBridge Drag

<PageTitle>@(Store.Board?.Name ?? "Board") · Solo</PageTitle>

@if (Store.Board is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* Wraps rather than crushes: on a narrow screen the title keeps the first
       row and the create buttons drop to a row of their own, instead of the
       three of them squeezing each other down to a letter apiece. *@
    <div class="board-header">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small"
                       Href="@($"projects/{ProjectAlias}")" aria-label="Back to project" />
        <EntityIcon ImageId="@Store.Board.ImageId" Icon="@Store.Board.Icon" Color="Color.Primary" />
        <MudText Typo="Typo.h1" Class="board-header__title">@Store.Board.Name</MudText>

        @if (!Store.Board.IsOpen)
        {
            <MudChip T="string" Size="Size.Small" Label="true" Color="Color.Default">Closed</MudChip>
        }

        <MudSpacer />
        <PresenceCluster Entries="@Store.PresenceOn(EntityTypes.Board, Store.Board.Id)" MaxVisible="5" />

        @if (CanWrite)
        {
            <div class="board-header__actions">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@CreateEpicAsync">
                    Epic
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => CreateTaskAsync(null))">
                    Task
                </MudButton>
            </div>
        }
    </div>

    @* The board is a plain grid of drop zones; the dragging itself lives in
       js/drag.js, which reads the data-drag-* attributes below and reports a
       finished drop back through DragBridge. Two groups overlap here: the epic
       bands reorder within the board, and the cards move between the columns
       inside them. A zone only accepts its own group, so the two never collide. *@
    <div class="kanban" data-drag-zone="epics" data-drag-group="epic">

        @* Board-wide column titles, over the gutter-plus-three-columns grid.
           The phone layout hides this: once the columns become a carousel
           nothing lines up under a shared header, so each column names
           itself instead (see KanbanZone). *@
        <div class="kanban-header">
            <div></div>
            <div class="kanban-header__columns">
                @foreach (var status in BoardZones.Statuses)
                {
                    <MudText Typo="Typo.overline" Color="Color.Secondary" Class="px-2">
                        @BoardZones.Title(status) (@_ordered.Count(t => t.Status == status))
                    </MudText>
                }
            </div>
        </div>

        @foreach (var epic in Store.Board.Epics)
        {
            @* The whole gutter is the "open epic" target; its own controls
               (collapse chevron, action icons) stop the click instead. It is
               also where a reorder drag may begin — from anywhere on it after a
               press, or straight away from the six-dot handle. *@
            <div class="kanban-lane" @key="epic.Id"
                 data-drag-item="@(CanWrite ? epic.Id.ToString() : null)"
                 data-drag-from=".kanban-lane__gutter"
                 data-drag-preview=".kanban-lane__gutter">
                <div class="kanban-lane__gutter kanban-lane__gutter--openable"
                     @onclick="@(() => OpenEpic(epic))"
                     role="button" aria-label="@($"Open epic {epic.Name}")">
                    <div class="kanban-lane__title">
                        <span class="d-inline-flex" @onclick:stopPropagation>
                            <MudIconButton Size="Size.Small" Class="kanban-lane__collapse"
                                           Icon="@(IsCollapsed(epic.Id) ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)"
                                           OnClick="@(() => ToggleCollapsed(epic.Id))"
                                           aria-label="Collapse epic" />
                        </span>
                        <MudText Typo="Typo.subtitle2" Class="kanban-lane__name flex-grow-1">@epic.Name</MudText>
                    </div>

                    <div class="d-flex align-center" style="gap:.35rem">
                        <MudSpacer />
                        <PresenceCluster Entries="@Store.PresenceOn(EntityTypes.Epic, epic.Id)" MaxVisible="2" />
                        <span class="presence-cluster">
                            @foreach (var assignee in MembersOf(epic.AssigneeIds).Take(3))
                            {
                                <UserAvatar UserId="@(assignee.UserId ?? assignee.Id)"
                                            DisplayName="@(assignee.DisplayName ?? assignee.Email)"
                                            AvatarUrl="@assignee.AvatarUrl" />
                            }
                        </span>
                    </div>

                    @if (CanWrite)
                    {
                        <div class="kanban-lane__actions" @onclick:stopPropagation>
                            <MudTooltip Text="Drag to reorder">
                                <span class="kanban-lane__drag-handle" data-drag-handle
                                      aria-label="@($"Drag to reorder {epic.Name}")">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                             Size="Size.Small" Color="Color.Secondary" />
                                </span>
                            </MudTooltip>
                            <MudTooltip Text="Add task">
                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                               OnClick="@(() => CreateTaskAsync(epic.Id))" aria-label="Add task" />
                            </MudTooltip>
                            <MudTooltip Text="Delete epic">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               OnClick="@(() => DeleteEpicAsync(epic))" aria-label="Delete epic" />
                            </MudTooltip>
                        </div>
                    }
                </div>

                @if (IsCollapsed(epic.Id))
                {
                    <div class="kanban-zone">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @TasksOfEpic(epic.Id).Count task(s) hidden
                        </MudText>
                    </div>
                }
                else
                {
                    <div class="kanban-lane__zones">
                        @foreach (var status in BoardZones.Statuses)
                        {
                            <KanbanZone Identifier="@BoardZones.Id(epic.Id, status)"
                                        Title="@BoardZones.Title(status)"
                                        Count="@ZoneCount(epic.Id, status)"
                                        HiddenCount="@HiddenCount(epic.Id, status)"
                                        OnExpand="@(() => ExpandFinished(epic.Id))">
                                @foreach (var task in CardsIn(epic.Id, status))
                                {
                                    @Card(task)
                                }
                            </KanbanZone>
                        }
                    </div>
                }
            </div>
        }

        @* The ad-hoc band: tasks that belong to no epic. Dropping here detaches.
           Not a drag item — it has no rank of its own and always comes last. *@
        <div class="kanban-lane kanban-lane--adhoc">
            <div class="kanban-lane__gutter">
                <div class="kanban-lane__title">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Small" Color="Color.Secondary" />
                    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">No epic</MudText>
                </div>
            </div>

            <div class="kanban-lane__zones">
                @foreach (var status in BoardZones.Statuses)
                {
                    <KanbanZone Identifier="@BoardZones.Id(null, status)"
                                Title="@BoardZones.Title(status)"
                                Count="@ZoneCount(null, status)"
                                HiddenCount="@HiddenCount(null, status)"
                                OnExpand="@(() => ExpandFinished(null))">
                        @foreach (var task in CardsIn(null, status))
                        {
                            @Card(task)
                        }
                    </KanbanZone>
                }
            </div>
        </div>

        @if (Store.Board.Epics.Count == 0 && _ordered.Count == 0)
        {
            <EmptyState Message="This board is empty."
                        Icon="@Icons.Material.Filled.ViewKanban"
                        ActionText="@(CanWrite ? "Add a task" : null)"
                        OnAction="@(() => CreateTaskAsync(null))"
                        SecondaryActionText="@(CanWrite ? "Add an epic" : null)"
                        OnSecondaryAction="@CreateEpicAsync" />
        }
    </div>

    @* Column-swap targets for a drag on the phone carousel: the column you want
       is usually off-screen when you pick a card up, so holding it against
       either edge steps that band along. Painted here, lit from js/drag.js —
       the drag reports a position every frame, which is no way to drive a
       render. pointer-events:none, so they can never take the drop themselves. *@
    <div class="board-edge board-edge--left" aria-hidden="true"></div>
    <div class="board-edge board-edge--right" aria-hidden="true"></div>

    <DetailDrawer Task="@_openTask" Epic="@_openEpic" CanWrite="@CanWrite"
                  CanModerate="@_canModerate" OnClose="@CloseDrawerAsync" />
}

@code {
    private List<TaskDto> _ordered = [];
    private readonly HashSet<Guid> _collapsed = [];
    private readonly HashSet<Guid> _expandedFinished = [];
    private readonly HashSet<Guid> _pulsing = [];
    private HashSet<Guid> _folded = [];
    private TaskDto? _openTask;
    private EpicDto? _openEpic;
    private bool _canWrite;
    private bool _canModerate;

    [Parameter]
    public string ProjectAlias { get; set; } = string.Empty;

    [Parameter]
    public string BoardAlias { get; set; } = string.Empty;

    /// <summary>
    /// Landing spot for ||serial|| links: ?task=N opens that task's drawer.
    /// Bound as a string — a mistyped URL must not crash the route binder.
    /// </summary>
    [Parameter]
    [SupplyParameterFromQuery(Name = "task")]
    public string? TaskQuery { get; set; }

    private bool CanWrite => _canWrite && (Store.Board?.IsOpen ?? false);

    private Guid BoardId => Store.Board?.Id ?? Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        Store.Pulsed += OnPulsed;
        await Drag.RegisterAsync("task", OnTaskDropAsync);
        await Drag.RegisterAsync("epic", OnEpicDropAsync);

        if (Session.Current is null)
        {
            try
            {
                await Session.LoadAsync();
            }
            catch (ApiException)
            {
                // The board load below reports the real problem.
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        var isCurrent = Store.Board is { } current &&
            string.Equals(current.ProjectAlias, ProjectAlias, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(current.Alias, BoardAlias, StringComparison.OrdinalIgnoreCase);

        if (!isCurrent)
        {
            try
            {
                await Store.LoadAsync(ProjectAlias, BoardAlias);
                // The API's write policy accepts the owner flag or a read/write role;
                // the super admin's blanket rights stop at the owner surface, which
                // on a board means comment moderation only.
                var me = Store.Members.FirstOrDefault(m => m.UserId == Session.UserId);
                _canWrite = (me?.IsOwner ?? false) || me?.Role == ProjectRole.ReadWrite;
                _canModerate = Session.IsSuperAdmin || (me?.IsOwner ?? false);
                Rebuild();
            }
            catch (ApiException e)
            {
                Snackbar.Add(e.Detail ?? "Couldn't open that board.", Severity.Error);
                return;
            }
        }

        await OpenLinkedTaskAsync();
    }

    /// <summary>
    /// Resolves a ?task=N query to its drawer, then strips the query (replacing
    /// the history entry) so the plain board URL remains — and so clicking the
    /// same link again is a fresh navigation rather than a no-op.
    /// </summary>
    private async Task OpenLinkedTaskAsync()
    {
        if (TaskQuery is null || Store.Board is not { } board)
        {
            return;
        }

        if (int.TryParse(TaskQuery, out var number))
        {
            if (board.Tasks.FirstOrDefault(t => t.Number == number) is { } task)
            {
                await OpenTask(task);
            }
            else
            {
                Snackbar.Add(
                    $"{Aliases.Serial(board.ProjectAlias, board.Alias, number)} isn't on this board — " +
                    "the task may have been deleted.", Severity.Warning);
            }
        }

        Nav.NavigateTo($"projects/{board.ProjectAlias}/boards/{board.Alias}", replace: true);
    }

    // -- Rendering ----------------------------------------------------------

    /// <summary>
    /// The cards one zone shows, in rank order — everything a folded Finished
    /// column has tucked away stays reachable behind its expander.
    /// </summary>
    private List<TaskDto> CardsIn(Guid? epicId, TaskState status) =>
        _ordered
            .Where(t => t.EpicId == epicId && t.Status == status && !_folded.Contains(t.Id))
            .ToList();

    /// <summary>
    /// One card in a column. The wrapper, not the card itself, is the drag item:
    /// it is what the engine fades in place, clones under the pointer and counts
    /// when working out which slot the pointer is asking for.
    /// </summary>
    private RenderFragment<TaskDto> Card => task =>
        @<div class="kanban-card-slot" @key="task.Id"
              data-drag-item="@(CanWrite ? task.Id.ToString() : null)">
            <TaskCard Task="@task"
                      Label="@LabelOf(task)"
                      Assignees="@MembersOf(task.AssigneeIds)"
                      Presence="@Store.EditorsOn(EntityTypes.Task, task.Id)"
                      Pulse="@_pulsing.Contains(task.Id)"
                      OnOpen="@OpenTask" />
        </div>;

    private void Rebuild()
    {
        _ordered = (Store.Board?.Tasks ?? []).OrderBy(t => t.Rank).ToList();

        // Finished-column hygiene: past 25 cards the overflow folds away.
        _folded = [];
        foreach (var group in _ordered.Where(t => t.Status == TaskState.Finished).GroupBy(t => t.EpicId))
        {
            var key = group.Key ?? Guid.Empty;
            if (_expandedFinished.Contains(key))
            {
                continue;
            }

            foreach (var task in group.Skip(BoardZones.FinishedVisibleLimit))
            {
                _folded.Add(task.Id);
            }
        }

    }

    private Guid _recordedProject;

    /// <summary>Remember this board's project so the sidebar can unfold recent work.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The route only carries aliases; the project's id arrives with the payload.
        if (Store.Board is not { } board || _recordedProject == board.ProjectId)
        {
            return;
        }

        _recordedProject = board.ProjectId;
        try
        {
            await Recent.RecordAsync(board.ProjectId);
        }
        catch (JSException)
        {
            // Storage unavailable — recents are best-effort.
        }
    }

    /// <summary>What the column heading counts — folded cards included.</summary>
    private int ZoneCount(Guid? epicId, TaskState status) =>
        _ordered.Count(t => t.EpicId == epicId && t.Status == status);

    private int HiddenCount(Guid? epicId, TaskState status) =>
        status != TaskState.Finished
            ? 0
            : _ordered.Count(t => t.EpicId == epicId && t.Status == status && _folded.Contains(t.Id));

    private void ExpandFinished(Guid? epicId)
    {
        _expandedFinished.Add(epicId ?? Guid.Empty);
        Rebuild();
    }

    private List<TaskDto> TasksOfEpic(Guid? epicId) => _ordered.Where(t => t.EpicId == epicId).ToList();

    private LabelDto? LabelOf(TaskDto task) =>
        task.LabelId is null ? null : Store.Board?.Labels.FirstOrDefault(l => l.Id == task.LabelId);

    private List<ProjectMemberDto> MembersOf(IReadOnlyList<Guid> userIds) =>
        Store.Members.Where(m => m.UserId is not null && userIds.Contains(m.UserId.Value)).ToList();

    private bool IsCollapsed(Guid epicId) => _collapsed.Contains(epicId);

    private void ToggleCollapsed(Guid epicId)
    {
        if (!_collapsed.Add(epicId))
        {
            _collapsed.Remove(epicId);
        }
    }

    // -- Drag & drop --------------------------------------------------------
    //
    // js/drag.js does the gesture; both handlers below are called once, after a
    // card or a band has been let go. Nothing about a drop is trusted: the ids
    // and the zone come back from the browser, so every one of them is looked up
    // again before anything is written.

    private async Task OnTaskDropAsync(DragDrop drop)
    {
        var task = Store.Board?.Tasks.FirstOrDefault(t => t.Id == drop.ItemGuid);
        if (task is null || !CanWrite || !BoardZones.TryParse(drop.ZoneId, out var epicId, out var status))
        {
            return;
        }

        var plan = DropPlan.For(task, epicId, status);

        // Order matters: the task must belong to the target lane and column before
        // its rank is interpreted relative to that zone's neighbours.
        if (plan.ChangeEpic)
        {
            var moved = await Guard.RunAsync(() => Api.SetTaskEpicAsync(task.Id, epicId), Store.RefreshAsync);
            if (moved is null)
            {
                return;
            }

            Store.ApplyTask(moved);
        }

        if (plan.ChangeStatus)
        {
            var moved = await Guard.RunAsync(() => Api.SetTaskStatusAsync(task.Id, status), Store.RefreshAsync);
            if (moved is null)
            {
                return;
            }

            Store.ApplyTask(moved);
        }

        await RerankAsync(task, epicId, status, drop.Index);
        StateHasChanged();
    }

    /// <summary>
    /// The drop's index counts the zone's <em>other</em> cards, so it is already
    /// an insertion point among them and the neighbours are simply the pair
    /// either side of that slot.
    /// </summary>
    private async Task RerankAsync(TaskDto task, Guid? epicId, TaskState status, int indexInZone)
    {
        var others = _ordered
            .Where(t => t.Id != task.Id && t.EpicId == epicId && t.Status == status)
            .OrderBy(t => t.Rank)
            .Select(t => t.Id)
            .ToList();

        var (preceding, following) = RankNeighbors.Compute(others, indexInZone);
        if (preceding is null && following is null)
        {
            return;
        }

        var ranked = await Guard.RunAsync(
            () => Api.RerankTaskAsync(task.Id, preceding, following), Store.RefreshAsync);
        if (ranked is not null)
        {
            Store.ApplyTask(ranked);
        }
    }

    // -- Epics --------------------------------------------------------------

    private async Task CreateEpicAsync()
    {
        var name = await PromptAsync("New epic", "Epic name");
        if (name is null)
        {
            return;
        }

        var created = await Guard.RunAsync(() => Api.CreateEpicAsync(BoardId, new CreateEpicRequest { Name = name }));
        if (created is not null)
        {
            await Store.RefreshAsync();
        }
    }

    // -- Epic reordering ----------------------------------------------------

    /// <summary>
    /// The bands are their own drag group, so a card dropped between two of them
    /// never reaches this — the engine only offers a zone to items of its own
    /// group, and the card columns are zones of another.
    /// </summary>
    private async Task OnEpicDropAsync(DragDrop drop)
    {
        var epics = Store.Board?.Epics.ToList();
        if (epics is null || !CanWrite || drop.ItemGuid is not { } draggedId)
        {
            return;
        }

        var sourceIndex = epics.FindIndex(e => e.Id == draggedId);
        if (sourceIndex < 0)
        {
            return;
        }

        var others = epics.Where(e => e.Id != draggedId).Select(e => e.Id).ToList();
        var insertionIndex = Math.Clamp(drop.Index, 0, others.Count);
        if (insertionIndex == sourceIndex)
        {
            return;
        }

        var (preceding, following) = RankNeighbors.Compute(others, insertionIndex);

        var moved = await Guard.RunAsync(
            () => Api.RerankEpicAsync(draggedId, preceding, following), Store.RefreshAsync);
        if (moved is not null)
        {
            Store.ApplyEpic(moved);
        }

        StateHasChanged();
    }

    private async Task DeleteEpicAsync(EpicDto epic)
    {
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>(
            "Delete epic",
            new DialogParameters<ConfirmDialog>
            {
                { d => d.Message, $"Delete the epic \"{epic.Name}\"? Its tasks move to the ad-hoc band." },
            });

        if (await dialog.Result is not { Canceled: false })
        {
            return;
        }

        await Guard.RunAsync(() => Api.DeleteEpicAsync(epic.Id));
        await Store.RefreshAsync();
    }

    // -- Tasks --------------------------------------------------------------

    private async Task CreateTaskAsync(Guid? epicId)
    {
        var name = await PromptAsync("New task", "Task name");
        if (name is null)
        {
            return;
        }

        var created = await Guard.RunAsync(() =>
            Api.CreateTaskAsync(BoardId, new CreateTaskRequest { Name = name, EpicId = epicId }));
        if (created is not null)
        {
            Store.ApplyTask(created);
        }
    }

    private async Task<string?> PromptAsync(string title, string label)
    {
        var dialog = await Dialogs.ShowAsync<TextPromptDialog>(
            title, new DialogParameters<TextPromptDialog> { { d => d.Label, label } });
        return await dialog.Result is { Canceled: false, Data: string name } ? name : null;
    }

    // -- Drawer -------------------------------------------------------------

    private async Task OpenTask(TaskDto task)
    {
        _openEpic = null;
        _openTask = task;
        await Hub.SetPresence(EntityTypes.Task, task.Id, PresenceMode.Viewing);
    }

    private async Task OpenEpic(EpicDto epic)
    {
        _openTask = null;
        _openEpic = epic;
        await Hub.SetPresence(EntityTypes.Epic, epic.Id, PresenceMode.Viewing);
    }

    private async Task CloseDrawerAsync()
    {
        _openTask = null;
        _openEpic = null;
        await Hub.SetPresence(EntityTypes.Board, BoardId, PresenceMode.None);
    }

    // -- Live updates -------------------------------------------------------

    private void OnStoreChanged() => InvokeAsync(() =>
    {
        // Keep the open drawer pointed at the freshly fetched instance.
        if (_openTask is not null)
        {
            _openTask = Store.Board?.Tasks.FirstOrDefault(t => t.Id == _openTask.Id);
        }

        if (_openEpic is not null)
        {
            _openEpic = Store.Board?.Epics.FirstOrDefault(e => e.Id == _openEpic.Id);
        }

        Rebuild();
        StateHasChanged();
    });

    /// <summary>Remote changes apply silently; the card flashes its outline once.</summary>
    private void OnPulsed(string entityType, Guid entityId) => _ = InvokeAsync(async () =>
    {
        if (entityType != EntityTypes.Task)
        {
            return;
        }

        _pulsing.Add(entityId);
        StateHasChanged();
        await Task.Delay(650);
        _pulsing.Remove(entityId);
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Store.Changed -= OnStoreChanged;
        Store.Pulsed -= OnPulsed;
        Drag.Unregister("task", OnTaskDropAsync);
        Drag.Unregister("epic", OnEpicDropAsync);
        await Store.DetachAsync();
    }
}
