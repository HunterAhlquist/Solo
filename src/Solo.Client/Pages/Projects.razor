@page "/"
@attribute [Authorize]
@using Solo.Client.Extensions
@implements IDisposable
@inject ApiClient Api
@inject ExtensionCatalog Extensions
@inject UserSession Session
@inject ProjectNavStore Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AppConfig Config

<PageTitle>Projects · @Config.SiteName</PageTitle>

<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h1">Projects</MudText>
</div>

@if (_projects is null)
{
    <div class="grid-inset">
    <MudGrid>
        @for (var i = 0; i < 3; i++)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="96px" />
            </MudItem>
        }
    </MudGrid>
    </div>
}
else if (_projects.Count == 0)
{
    <EmptyState Message="No projects yet."
                Icon="@Icons.Material.Filled.Dashboard"
                ActionText="@(Session.IsSuperAdmin ? "Create one" : null)"
                OnAction="@CreateProjectAsync" />

    @if (!Session.IsSuperAdmin)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-3">
            Ask an administrator to invite you to a project.
        </MudText>
    }
}
else
{
    <div class="grid-inset">
    <MudGrid>
        @foreach (var project in _projects)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="1" Class="h-100">
                    <MudCardContent>
                        <div class="d-flex align-center" style="gap:.75rem">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined">
                                <EntityIcon ImageId="@project.ImageId" Icon="@project.Icon" />
                            </MudAvatar>
                            <div class="flex-grow-1" style="min-width:0">
                                <MudText Typo="Typo.h4" Class="text-truncate">@project.Name</MudText>
                                <div class="d-flex align-center mt-1" style="gap:.35rem">
                                    @if (project.IsOwner)
                                    {
                                        <MudChip T="string" Size="Size.Small" Label="true"
                                                 Color="Color.Primary" Class="ma-0">Owner</MudChip>
                                    }
                                    <MudChip T="string" Size="Size.Small" Label="true"
                                             Color="Color.Default" Class="ma-0">
                                        @(project.Role == ProjectRole.ReadWrite ? "Read/write" : "Read only")
                                    </MudChip>
                                </div>
                            </div>
                        </div>

                        @* Open boards only, as in the sidebar: closed ones stay folded
                           away on the project home. *@
                        <div class="project-card__boards">
                            @{
                                var boards = Nav.BoardsOf(project.Id);
                            }
                            @if (CardSections.Count > 0)
                            {
                                <div class="project-card__surface-title">Boards</div>
                            }
                            @if (boards is null)
                            {
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="60%" />
                                <MudSkeleton SkeletonType="SkeletonType.Text" Width="45%" />
                            }
                            else if (boards.Count == 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">No open boards.</MudText>
                            }
                            else
                            {
                                @foreach (var board in boards)
                                {
                                    <a class="project-card__board" href="@BoardHref(project, board)">
                                        <EntityIcon ImageId="@board.ImageId" Icon="@board.Icon"
                                                    Size="Size.Small" Color="Color.Primary" />
                                        <span class="text-truncate">@board.Name</span>
                                    </a>
                                }
                            }
                        </div>

                        @* Each extension's own surface, styled like the boards above it;
                           the component fills it, core titles and bounds it. *@
                        @foreach (var contributed in CardSections)
                        {
                            <div class="project-card__boards">
                                <div class="project-card__surface-title">@contributed.Title</div>
                                <ErrorBoundary @key="(project.Id, contributed.Component)">
                                    <ChildContent>
                                        <DynamicComponent Type="@contributed.Component"
                                                          Parameters="@SectionParameters(project)" />
                                    </ChildContent>
                                    <ErrorContent>
                                        <MudText Typo="Typo.caption" Color="Color.Error" Class="px-1">
                                            @contributed.Title couldn't load.
                                        </MudText>
                                    </ErrorContent>
                                </ErrorBoundary>
                            </div>
                        }
                    </MudCardContent>

                    @* The only way into the project home from here: the card itself is
                       not a link, so a click anywhere on it does nothing surprising. *@
                    <MudCardActions Class="justify-end">
                        <MudTooltip Text="Project settings">
                            <MudIconButton Icon="@Icons.Material.Filled.Tune" Size="Size.Small"
                                           aria-label="@($"{project.Name} settings")"
                                           OnClick="@(() => OpenProject(project))" />
                        </MudTooltip>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
        @if (Session.IsSuperAdmin)
        {
            <MudItem xs="12" sm="6" md="4">
                <AddCard Label="New project" OnClick="@CreateProjectAsync" />
            </MudItem>
        }
    </MudGrid>
    </div>
}

@code {
    private IReadOnlyList<ProjectSummaryDto>? _projects;

    protected override async Task OnInitializedAsync()
    {
        // Each card's board list arrives after the card does; the store announces
        // each project's boards as they land.
        Nav.Changed += OnNavChanged;
        Extensions.Changed += OnExtensionsChanged;

        // The layout also loads the session, but a direct hit on this page can
        // race it — and the "New project" button depends on IsSuperAdmin.
        if (Session.Current is null)
        {
            try
            {
                await Session.LoadAsync();
            }
            catch (ApiException)
            {
                // Non-fatal: the page still lists whatever projects they can see.
            }
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _projects = await Api.GetProjectsAsync();
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't load projects.", Severity.Error);
            _projects = [];
        }

        // The cards list boards, so this page is the one place that wants all of
        // them at once. They go through the sidebar's store rather than a second
        // fetch: whichever surface asks first, the other reads the same cache.
        // Not awaited — a card should paint with its name and chips immediately
        // and fill its list in as that project's boards arrive.
        foreach (var project in _projects)
        {
            _ = Nav.EnsureBoardsAsync(project.Id);
        }
    }

    private void OnNavChanged() => InvokeAsync(StateHasChanged);

    private void OpenProject(ProjectSummaryDto project) =>
        Navigation.NavigateTo($"projects/{project.Alias}");

    private static string BoardHref(ProjectSummaryDto project, BoardDto board) =>
        $"projects/{project.Alias}/boards/{board.Alias}";

    private async Task CreateProjectAsync()
    {
        var dialog = await Dialogs.ShowAsync<NameIconDialog>(
            "New project",
            new DialogParameters<NameIconDialog> { { d => d.SaveText, "Create" } });

        if (await dialog.Result is not { Canceled: false, Data: NameIconDialog.NameIcon created })
        {
            return;
        }

        try
        {
            var project = await Api.CreateProjectAsync(new CreateProjectRequest
            {
                Name = created.Name,
                Alias = created.Alias,
                Icon = created.Icon,
                ImageId = created.ImageId,
            });
            await Nav.RefreshProjectsAsync();
            Navigation.NavigateTo($"projects/{project.Alias}");
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't create the project.", Severity.Error);
        }
    }

    private IReadOnlyList<ContributedSection>? _sections;

    private IReadOnlyList<ContributedSection> CardSections => _sections ??=
        ContributedSections.Find<Solo.Shared.Extensibility.ProjectCardSectionAttribute>(
            Extensions, a => a.Title, a => a.Order);

    private static IDictionary<string, object> SectionParameters(ProjectSummaryDto project) =>
        new Dictionary<string, object>
        {
            ["Project"] = project,
            ["CanWrite"] = ProjectNavStore.CanWrite(project),
        };

    private void OnExtensionsChanged()
    {
        _sections = null;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.Changed -= OnNavChanged;
        Extensions.Changed -= OnExtensionsChanged;
    }
}
