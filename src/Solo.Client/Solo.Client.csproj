<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <UserSecretsId>4fceb2f8-d72b-4025-9056-abc6e3c24000</UserSecretsId>
    <!-- Extension client assemblies are loaded at runtime and compiled against
         MudBlazor and framework APIs this app may not itself call. The trimmer
         removes exactly those, so a trimmed Release build fails an extension
         with MissingMethodException — in production only, with a stack trace
         pointing nowhere useful. Off is the honest trade for a login-gated
         small-team tool; the alternative is a hand-maintained root descriptor
         pinning the whole guaranteed surface. Revisit if the payload hurts.
         The Electron shell serves this same published output, so it inherits
         the decision automatically. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Solo.Shared\Solo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <!-- Held at 9.0.0. 9.10 drops highlight.js for a C# highlighter covering
         eight languages (none of C++, GDScript, HLSL, Python, SQL) and no
         longer injects a colour theme, so every code block in a description
         would render uncoloured. MarkdownHostPageTests fails on the switch. -->
    <PackageReference Include="MudBlazor.Markdown" Version="9.0.0" />
  </ItemGroup>

</Project>
