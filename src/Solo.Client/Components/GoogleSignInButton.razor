@implements IDisposable
@inject GoogleIdentityService Google
@inject ThemeState Theme

@*
    Two renderings of the same sign-in. On the web, Google renders the button
    itself inside the div below — its branding rules require it, and it's what
    carries the FedCM/One Tap plumbing; the credential arrives via a JS
    callback. In the desktop shell, Google refuses to run its widget at all,
    so a plain button hands the flow to the system browser and the shell
    injects the credential into the same callback when the browser finishes.
*@
<div class="d-flex flex-column align-center" style="gap:.5rem">
    @if (_desktop)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.OpenInNew"
                   OnClick="@BeginBrowserSignIn">
            Authorize in browser
        </MudButton>

        @if (_browserOpened)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center">
                Finish signing in in your browser — Solo picks it up automatically.
            </MudText>
        }
    }
    else
    {
        @* color-scheme: light whatever the app's scheme, because Google's
           personalized "Continue as …" iframe declares light: when an iframe's
           scheme differs from its embedder's, the browser paints it on an
           opaque canvas, which showed as a white box around the pill. Matched,
           the iframe stays transparent and any card tint shows around it. The
           pill's own colors come from the GIS theme, not the scheme. *@
        <div @ref="_container" style="color-scheme:light"></div>
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
    }
</div>

@code {
    private ElementReference _container;
    private string? _error;
    private bool _desktop;
    private bool _browserOpened;

    // The scheme the GIS button was last drawn for; null until it is drawn.
    private bool? _renderedDark;

    /// <summary>Fires once a credential has been received and stored.</summary>
    [Parameter]
    public EventCallback OnSignedIn { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Google.SignedInChanged += OnSignedInChanged;
        Google.SignInFailed += OnSignInFailed;
        Theme.Changed += OnThemeChanged;

        _desktop = await Google.IsDesktopAsync();
        if (_desktop)
        {
            // Register the credential receiver up front: the browser flow can
            // complete while this component is simply sitting here.
            await Google.InitializeAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _desktop)
        {
            return;
        }

        try
        {
            await Google.InitializeAsync();
            await RenderButtonAsync();
        }
        catch (JSException)
        {
            // Google's script is blocked or unreachable (offline, content blocker).
            _error = "Couldn't load Google sign-in. Check your connection or any content blocker.";
            StateHasChanged();
        }
    }

    // GIS offers a black or a white pill and nothing in between, so the
    // scheme picks one; the surrounding tint is whatever the card is.
    private async Task RenderButtonAsync()
    {
        _renderedDark = Theme.IsDarkMode;
        await Google.RenderButtonAsync(_container, _renderedDark.Value);
    }

    // Google draws the button once, so a scheme change (the system flipping
    // while the page is open) has to redraw it.
    private void OnThemeChanged() => _ = InvokeAsync(async () =>
    {
        if (_renderedDark is { } dark && dark != Theme.IsDarkMode)
        {
            try
            {
                await RenderButtonAsync();
            }
            catch (JSException)
            {
                // Keep the button already drawn.
            }
        }
    });

    private async Task BeginBrowserSignIn()
    {
        _browserOpened = true;
        await Google.BeginBrowserSignInAsync();
    }

    private void OnSignedInChanged() => _ = InvokeAsync(async () =>
    {
        if (await Google.GetTokenAsync() is not null)
        {
            _error = null;
            await OnSignedIn.InvokeAsync();
        }

        StateHasChanged();
    });

    private void OnSignInFailed(string message) => _ = InvokeAsync(() =>
    {
        _browserOpened = false;
        _error = message;
        StateHasChanged();
    });

    public void Dispose()
    {
        Google.SignedInChanged -= OnSignedInChanged;
        Google.SignInFailed -= OnSignInFailed;
        Theme.Changed -= OnThemeChanged;
    }
}
