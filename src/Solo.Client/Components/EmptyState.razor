@*
    Empty states get one obvious action, never a shrug.
*@
<MudPaper Elevation="0" Class="pa-8 d-flex flex-column align-center justify-center"
          Style="border:1px dashed var(--mud-palette-lines-default);gap:.75rem">
    <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Secondary" />
    <MudText Typo="Typo.body1" Color="Color.Secondary">@Message</MudText>
    <div class="d-flex align-center" style="gap:.75rem">
        @if (SecondaryActionText is not null && OnSecondaryAction.HasDelegate)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OnSecondaryAction">
                @SecondaryActionText
            </MudButton>
        }
        @if (ActionText is not null && OnAction.HasDelegate)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@OnAction">
                @ActionText
            </MudButton>
        }
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public required string Message { get; set; }

    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.Inbox;

    [Parameter]
    public string? ActionText { get; set; }

    [Parameter]
    public EventCallback OnAction { get; set; }

    /// <summary>Optional second, outlined action beside the primary one.</summary>
    [Parameter]
    public string? SecondaryActionText { get; set; }

    [Parameter]
    public EventCallback OnSecondaryAction { get; set; }
}
