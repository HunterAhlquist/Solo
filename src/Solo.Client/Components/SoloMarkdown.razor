@*
    MudMarkdown plus Solo's task-link syntax: ||PROJECT-BOARD-N|| becomes a link
    to that task, served by the board page's ?task= handler. Task links render
    as root-relative hrefs, so the Blazor router keeps them in-app — in the
    browser and in the desktop shell alike; external links keep MudMarkdown's
    default new-tab behaviour, which the desktop shell reroutes to the system
    browser. (MudMarkdown's own link Command hook is off-limits: its
    MudLinkButton is compiled against internal MudBlazor API and throws under
    the MudBlazor version this app ships.)

    Every render goes through SoloMarkdownPipeline, which strips raw HTML and
    neutralises javascript:/data: destinations — user markdown is hostile input
    and MudMarkdown's default pipeline renders both verbatim.

    Links an extension owns (ISoloMarkdownLinkProvider, contract 1.10) show the
    label it supplies: the text renders as written first, then again once the
    providers answer. Without the extension, the label stays as it was written.
*@
@using Solo.Client.Extensions
@using Microsoft.Extensions.DependencyInjection
@inject IServiceProvider Services

@if (NavigationLocked)
{
    <div class="markdown-locked">
        <MudMarkdown Value="@Rendered" MarkdownPipeline="@SoloMarkdownPipeline.Instance" />
    </div>
}
else
{
    <MudMarkdown Value="@Rendered" MarkdownPipeline="@SoloMarkdownPipeline.Instance" />
}

@code {
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Set while the surrounding editor holds an unsaved draft: solo-interop's
    /// capture-phase click shim swallows link clicks inside .markdown-locked,
    /// so a preview click can't navigate away and drop the draft.
    /// </summary>
    [Parameter]
    public bool NavigationLocked { get; set; }

    private string? _relabelledFor;
    private string? _relabelled;

    private string Rendered => Value is null
        ? string.Empty
        : _relabelledFor == Value && _relabelled is not null ? _relabelled : LinkifySerials(Value);

    protected override async Task OnParametersSetAsync()
    {
        // Optional: a host that renders markdown without the extension catalog
        // (a test, say) renders it as written.
        var contributions = Services.GetService<MarkdownContributions>();
        if (Value is not { } value || contributions is null || !contributions.HasLinkProviders)
        {
            _relabelledFor = null;
            _relabelled = null;
            return;
        }

        // Asked on every render with new text; the providers cache.
        var relabelled = await contributions.RelabelAsync(LinkifySerials(value));
        if (Value == value)
        {
            _relabelledFor = value;
            _relabelled = relabelled;
        }
    }

    /// <summary>Rewrites ||serial|| tokens into markdown links to the board's ?task= route.</summary>
    public static string LinkifySerials(string markdown) =>
        TaskReferences.Replace(markdown, reference =>
            $"[{reference.Serial}]" +
            $"(/projects/{reference.ProjectAlias}/boards/{reference.BoardAlias}?task={reference.Number})");
}
