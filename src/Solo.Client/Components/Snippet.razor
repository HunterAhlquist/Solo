@*
    A block of configuration the reader is meant to copy verbatim: monospaced,
    horizontally scrollable rather than wrapped (a wrapped command line invites
    pasting a broken one), with a copy button.
*@

<div class="snippet mb-3">
    <div class="snippet__header">
        <MudText Typo="Typo.caption" Color="Color.Secondary">@Title</MudText>
        <MudSpacer />
        <MudTooltip Text="Copy">
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small"
                           OnClick="@(() => OnCopy.InvokeAsync(Text))"
                           aria-label="@($"Copy {Title}")" />
        </MudTooltip>
    </div>
    <pre class="snippet__body"><code>@Text</code></pre>
</div>

@code {
    [Parameter, EditorRequired]
    public required string Title { get; set; }

    [Parameter, EditorRequired]
    public required string Text { get; set; }

    [Parameter]
    public EventCallback<string> OnCopy { get; set; }
}
