@*
    Create/rename for the two things that have a name, an alias and an icon:
    projects and boards. Dialog close is the save event.
*@
<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" AutoFocus="true" MaxLength="FieldLimits.EntityName" Class="mb-3"
                      OnKeyUp="@OnKeyUp" />
        <MudTextField @bind-Value="_alias" Label="Alias" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" MaxLength="Aliases.MaxLength" Class="mb-3"
                      HelperText="Stands in for the id in links and serial numbers — capital letters and digits, max 8."
                      Error="@(!AliasEmpty && !AliasValid)"
                      ErrorText="@Aliases.PatternError"
                      OnKeyUp="@OnKeyUp" />
        <IconImagePicker @bind-Icon="_icon" @bind-ImageId="_imageId" />
        @ChildContent
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@(!CanSave)" OnClick="@Save">
            @SaveText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _name = string.Empty;
    private string _alias = string.Empty;
    private string? _icon;
    private Guid? _imageId;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? Alias { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public Guid? ImageId { get; set; }

    [Parameter]
    public string SaveText { get; set; } = "Create";

    /// <summary>
    /// Anything more the caller shows under the icon — a board's extension
    /// sections. It saves on its own terms; Save here only closes with the name,
    /// alias and icon.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string NormalizedAlias => Aliases.Normalize(_alias);

    private bool AliasEmpty => string.IsNullOrWhiteSpace(_alias);

    private bool AliasValid =>
        System.Text.RegularExpressions.Regex.IsMatch(NormalizedAlias, Aliases.Pattern);

    private bool CanSave => !string.IsNullOrWhiteSpace(_name) && AliasValid;

    protected override void OnInitialized()
    {
        _name = Name ?? string.Empty;
        _alias = Alias ?? string.Empty;
        _icon = Icon;
        _imageId = ImageId;
    }

    /// <summary>
    /// Enter commits a single-line edit — on keyup, not keydown: closing on keydown
    /// hands focus back to the button that opened the dialog while Enter is still
    /// held, and the tail of the press clicks it and reopens the dialog.
    /// </summary>
    private void OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && CanSave)
        {
            Save();
        }
    }

    private void Save() =>
        Dialog.Close(DialogResult.Ok(new NameIcon(_name.Trim(), NormalizedAlias, _icon, _imageId)));

    private void Cancel() => Dialog.Cancel();

    public sealed record NameIcon(string Name, string Alias, string? Icon, Guid? ImageId);
}
