<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_text" Label="@Label" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" AutoFocus="true" MaxLength="@MaxLength" OnKeyUp="@OnKeyUp" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrWhiteSpace(_text)" OnClick="@Save">
            @SaveText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _text = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public required string Label { get; set; }

    [Parameter]
    public string SaveText { get; set; } = "Create";

    /// <summary>Every current caller prompts for an epic/task name.</summary>
    [Parameter]
    public int MaxLength { get; set; } = FieldLimits.ItemName;

    /// <summary>
    /// Enter commits a single-line edit — on keyup, not keydown: closing on keydown
    /// hands focus back to the button that opened the dialog while Enter is still
    /// held, and the tail of the press clicks it and reopens the dialog.
    /// </summary>
    private void OnKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_text))
        {
            Save();
        }
    }

    private void Save() => Dialog.Close(DialogResult.Ok(_text.Trim()));

    private void Cancel() => Dialog.Cancel();
}
