@using Solo.Client.Extensions
@using Solo.Shared.Extensibility
@inject IDialogService Dialogs
@inject IJSRuntime Js
@inject MarkdownContributions Contributions
@inject ISnackbar Snackbar
@implements IAsyncDisposable

@*
    Write/preview toggle. The save event is an explicit Save (or drawer close);
    Esc cancels. Never per keystroke. Reused for descriptions and comments.
*@
<div class="@Class" @ref="_root">
    @if (_editing)
    {
        <MudTabs Elevation="0" Rounded="true" Class="mb-2" @bind-ActivePanelIndex="_tab">
            <MudTabPanel Text="Write" Icon="@Icons.Material.Filled.Edit">
                @if (_buttons.Count > 0)
                {
                    @* What extensions add: each inserts its text at the cursor. *@
                    <div class="markdown-editor__actions">
                        @foreach (var (id, button, _) in _buttons)
                        {
                            @if (button.Icon is { } icon)
                            {
                                <MudTooltip Text="@button.Label">
                                    <MudIconButton Icon="@icon" Size="Size.Small" aria-label="@button.Label"
                                                   OnClick="@(() => ChooseAsync(id))" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ChooseAsync(id))">
                                    @button.Label
                                </MudButton>
                            }
                        }
                    </div>
                }
                @* Immediate keeps the counter honest per keystroke; saving stays explicit. *@
                <MudTextField @bind-Value="_draft" Lines="@Lines" MaxLines="24" Variant="Variant.Outlined"
                              Margin="Margin.Dense" Immediate="true" MaxLength="@MaxLength" Counter="@MaxLength"
                              Style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:.8rem"
                              Placeholder="@Placeholder" @onkeydown="@OnKeyDown" />
            </MudTabPanel>
            <MudTabPanel Text="Preview" Icon="@Icons.Material.Filled.Visibility">
                <MudPaper Elevation="0" Class="pa-2"
                          Style="border:1px solid var(--mud-palette-lines-default);min-height:6rem">
                    @if (string.IsNullOrWhiteSpace(_draft))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Nothing to preview.</MudText>
                    }
                    else
                    {
                        @* Locked: a task link in your own preview must not navigate away mid-draft. *@
                        <SoloMarkdown Value="@_draft" NavigationLocked="true" />
                    }
                </MudPaper>
            </MudTabPanel>
        </MudTabs>

        <div class="d-flex" style="gap:.5rem">
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveAsync">
                @SaveText
            </MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@CancelAsync">Cancel</MudButton>
            <MudSpacer />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="align-self-center">
                <MudLink Typo="Typo.caption" Underline="Underline.Always" Color="Color.Secondary"
                         OnClick="@ShowCheatsheetAsync">Markdown</MudLink> · Esc to cancel
            </MudText>
        </div>
    }
    else
    {
        @* A one-line label is a poor click target — give the reader a real box. *@
        <div class="markdown-read markdown-clickable @(CanWrite ? "markdown-read--editable" : null)"
             @onclick="@BeginEditAsync">
            @if (string.IsNullOrWhiteSpace(Value))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @(CanWrite ? EmptyPrompt : "No description.")
                </MudText>
            }
            else
            {
                <SoloMarkdown Value="@Value" />
            }
        </div>
    }
</div>

@code {
    private bool _editing;
    private int _tab;
    private string _draft = string.Empty;
    private ElementReference _root;
    private IReadOnlyList<ISoloMarkdownEditorAction> _actions = [];
    private IReadOnlyList<(string Id, MarkdownEditorButton Button, ISoloMarkdownEditorAction Action)> _buttons = [];

    /// <summary>
    /// The project the edited text belongs to. With <see cref="Surface"/> set as
    /// well, extensions' editor actions are offered; without, the editor is core's alone.
    /// </summary>
    [Parameter]
    public Guid? ProjectId { get; set; }

    [Parameter]
    public MarkdownSurface? Surface { get; set; }

    /// <summary>The task or epic whose text this is (for a new comment, its task).</summary>
    [Parameter]
    public Guid EntityId { get; set; }

    [Parameter]
    public string? Value { get; set; }

    /// <summary>Passed through to the root element, so callers can space it like any component.</summary>
    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool CanWrite { get; set; }

    [Parameter]
    public int Lines { get; set; } = 6;

    [Parameter]
    public int MaxLength { get; set; } = FieldLimits.Description;

    [Parameter]
    public string Placeholder { get; set; } = "Write markdown…";

    [Parameter]
    public string EmptyPrompt { get; set; } = "Add a description…";

    [Parameter]
    public string SaveText { get; set; } = "Save";

    /// <summary>Clears the editor after a successful save — used for the comment composer.</summary>
    [Parameter]
    public bool ResetAfterSave { get; set; }

    /// <summary>Starts in edit mode and never collapses back to a read view.</summary>
    [Parameter]
    public bool AlwaysEditing { get; set; }

    [Parameter]
    public EventCallback<string> OnSave { get; set; }

    /// <summary>Opening the editor reports Editing presence; closing it clears.</summary>
    [Parameter]
    public EventCallback<bool> OnEditingChanged { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (AlwaysEditing && !_editing)
        {
            _editing = true;
            _draft = Value ?? string.Empty;
            await LoadActionsAsync();
        }
    }

    private MarkdownEditorContext? Context(string? selected = null) =>
        ProjectId is { } projectId && Surface is { } surface
            ? new MarkdownEditorContext(projectId, surface, EntityId, selected)
            : null;

    /// <summary>Asks each contributed action for its buttons as the editor opens.</summary>
    private async Task LoadActionsAsync()
    {
        if (Context() is not { } context || Contributions.ActionTypes.Count == 0)
        {
            return;
        }

        await ReleaseActionsAsync();
        _actions = Contributions.CreateActions();
        _buttons = await Contributions.ButtonsAsync(_actions, context);
    }

    private async Task ReleaseActionsAsync()
    {
        var actions = _actions;
        _actions = [];
        _buttons = [];
        await MarkdownContributions.DisposeAllAsync(actions);
    }

    private async Task ChooseAsync(string id)
    {
        if (_buttons.FirstOrDefault(b => b.Id == id) is not { Action: { } action, Button: { } button })
        {
            return;
        }

        var selected = await Js.InvokeAsync<string?>("solo.markdown.selectedText", _root);
        if (Context(selected) is not { } context)
        {
            return;
        }

        string? text;
        try
        {
            text = await action.OnChosenAsync(button.Id, context, CancellationToken.None);
        }
        catch (Exception e) when (e is not OperationCanceledException)
        {
            Snackbar.Add($"{button.Label} failed: {e.Message}", Severity.Error);
            return;
        }

        if (string.IsNullOrEmpty(text))
        {
            return;
        }

        var outcome = await Js.InvokeAsync<string>("solo.markdown.insertAtCursor", _root, text, MaxLength);
        if (outcome == "too-long")
        {
            Snackbar.Add($"That doesn't fit: the text can be at most {MaxLength:N0} characters.", Severity.Warning);
        }
    }

    public async ValueTask DisposeAsync() => await ReleaseActionsAsync();

    private Task ShowCheatsheetAsync() =>
        Dialogs.ShowAsync<MarkdownCheatsheetDialog>("Markdown cheatsheet");

    private async Task BeginEditAsync()
    {
        if (!CanWrite || _editing)
        {
            return;
        }

        // Following a link in the rendered markdown must not also throw the
        // reader into edit mode; solo-interop's capture-phase shim saw the
        // click before Blazor dispatched it here.
        if (await Js.InvokeAsync<bool>("solo.markdown.wasLinkClick"))
        {
            return;
        }

        _draft = Value ?? string.Empty;
        _editing = true;
        _tab = 0;
        await OnEditingChanged.InvokeAsync(true);
        await LoadActionsAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await CancelAsync();
        }
    }

    private async Task SaveAsync()
    {
        await OnSave.InvokeAsync(_draft);

        if (ResetAfterSave)
        {
            _draft = string.Empty;
        }

        if (!AlwaysEditing)
        {
            _editing = false;
            await OnEditingChanged.InvokeAsync(false);
            await ReleaseActionsAsync();
        }
    }

    private async Task CancelAsync()
    {
        _draft = Value ?? string.Empty;

        if (!AlwaysEditing)
        {
            _editing = false;
            await OnEditingChanged.InvokeAsync(false);
            await ReleaseActionsAsync();
        }
    }
}
