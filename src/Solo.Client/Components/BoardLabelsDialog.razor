@*
    The board's label config, reached from the project's board listing. Labels
    belong to the board, so this is where they are edited; the project only holds
    the defaults a board is stamped from and can be reset to.
*@
<MudDialog>
    <DialogContent>
        <LabelsTab ProjectId="@ProjectId" BoardId="@BoardId" CanWrite="@CanWrite" Changed="@OnChanged" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@Close">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _changed;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    [Parameter, EditorRequired]
    public Guid BoardId { get; set; }

    [Parameter]
    public bool CanWrite { get; set; }

    private void OnChanged() => _changed = true;

    /// <summary>Reports whether anything changed, so a host holding board state can refetch.</summary>
    private void Close() => Dialog.Close(DialogResult.Ok(_changed));
}
