@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    One cell of the swimlane × column grid, and one drop zone for js/drag.js: the
    identifier is what comes back with a drop, and data-drag-outline is what asks
    the drag to paint this column as somewhere a card can land.

    The heading above the drop zone is the phone layout's half of the board
    header: there the three columns become a swipeable carousel, so no shared
    header row can line up with them and each column has to name itself. It is
    hidden on the desktop grid, where .kanban-header names all three at once.
*@
<div class="kanban-column @(IsCollapsed ? "kanban-column--collapsed" : null)">
    <div class="kanban-column__header">
        <MudText Typo="Typo.overline" Color="Color.Secondary">@Title</MudText>
        <MudText Typo="Typo.overline" Color="Color.Secondary">@Count</MudText>
    </div>

    @if (_overflows)
    {
        <MudButton Class="kanban-column__toggle" Variant="Variant.Text" Size="Size.Small"
                   StartIcon="@(IsCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)"
                   aria-expanded="@(!IsCollapsed ? "true" : "false")" aria-controls="@_zoneId"
                   OnClick="@(() => _expanded = !_expanded)">
            @(IsCollapsed ? "Show finished" : "Hide finished") (@Count)
        </MudButton>
    }

    <div @ref="_zone" id="@_zoneId" class="kanban-zone @(IsFinished ? "kanban-zone--finished" : null)"
         data-drag-zone="@Identifier" data-drag-group="@(IsCollapsed ? null : "task")" data-drag-outline
         aria-hidden="@(IsCollapsed ? "true" : null)">
        <div @ref="_content" class="kanban-zone__content">
            @ChildContent

            @if (HiddenCount > 0)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" Style="opacity:.65"
                           StartIcon="@Icons.Material.Filled.UnfoldMore" OnClick="@OnExpand">
                    Show all @(HiddenCount + BoardZones.FinishedVisibleLimit)
                </MudButton>
            }
        </div>
    </div>
</div>

@code {
    private readonly string _zoneId = $"kanban-zone-{Guid.NewGuid():N}";
    private ElementReference _zone;
    private ElementReference _content;
    private IJSObjectReference? _module;
    private DotNetObjectReference<KanbanZone>? _self;
    private bool _overflows;
    private bool _expanded;
    private bool _disposed;

    private bool IsCollapsed => _overflows && !_expanded;

    [Parameter, EditorRequired]
    public required string Identifier { get; set; }

    /// <summary>The column's name, shown by the phone layout's per-column heading.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Cards in this zone, folded ones included — the heading's count.</summary>
    [Parameter]
    public int Count { get; set; }

    [Parameter]
    public bool IsFinished { get; set; }

    /// <summary>Cards folded away behind the expander; zero for every non-Finished zone.</summary>
    [Parameter]
    public int HiddenCount { get; set; }

    [Parameter]
    public EventCallback OnExpand { get; set; }

    /// <summary>The cards themselves — each one a drag item.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !IsFinished)
        {
            return;
        }

        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/finished-column.js");
        if (_disposed)
        {
            await module.DisposeAsync();
            return;
        }

        _module = module;
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("observe", _zone, _content, _self);
    }

    [JSInvokable]
    public Task OverflowChanged(bool overflows) => InvokeAsync(() =>
    {
        if (_disposed || _overflows == overflows)
        {
            return;
        }

        _overflows = overflows;
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disconnect", _zone);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser may already be gone during navigation or shutdown.
            }
        }

        _self?.Dispose();
    }
}
