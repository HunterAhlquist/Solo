@*
    A card is: name, label, deadline countdown, assignees, sub-task progress,
    presence, and whatever extensions add beside the countdown. It flashes its
    outline once when a remote change lands on it.
*@
<MudPaper Elevation="1"
          Class="@CardClass"
          Style="@CardStyle"
          @onclick="@(() => OnOpen.InvokeAsync(Task))">

    <div class="d-flex align-start mb-1" style="gap:.35rem">
        <MudText Typo="Typo.body2" Class="flex-grow-1">@Task.Name</MudText>

        @if (Label is not null)
        {
            <div class="kanban-card__labels">
                <LabelChip Label="@Label" IconOnly="true" />
            </div>
        }
    </div>

    <div class="d-flex align-center" style="gap:.35rem">
        @if (ShowDeadline)
        {
            <MudTooltip Text="@DeadlineTooltip">
                <div class="@($"deadline-ring{(IsOverdue ? " deadline-ring--overdue" : string.Empty)}")"
                     aria-label="@DeadlineTooltip">
                    @* The same component the sub-task rollup uses, so the two rings on
                       a card share a size, a stroke and a cap. Only the colour differs:
                       MudBlazor strokes the arc in currentColor, so the countdown
                       colour rides in on the card's --deadline-color. *@
                    <MudProgressCircular Size="Size.Small" Value="@RemainingPercent"
                                         Style="color:var(--deadline-color)" />
                    @if (DaysLeftText is not null)
                    {
                        <span class="deadline-ring__days">@DaysLeftText</span>
                    }
                </div>
            </MudTooltip>
        }
        @if (Extensions.Count > 0)
        {
            <span class="kanban-card__extensions">
                @foreach (var contribution in Extensions)
                {
                    @* A card has no room for a sentence: a broken contribution is an icon. *@
                    <ErrorBoundary @key="contribution">
                        <ChildContent>
                            <DynamicComponent Type="@contribution" Parameters="@ExtensionParameters" />
                        </ChildContent>
                        <ErrorContent>
                            <MudTooltip Text="An extension couldn't draw its part of this card.">
                                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Color="Color.Error" />
                            </MudTooltip>
                        </ErrorContent>
                    </ErrorBoundary>
                }
            </span>
        }

        <MudSpacer />

        @if (Task.SubTasks.Count > 0)
        {
            <MudTooltip Text="@($"{FinishedCount} of {Task.SubTasks.Count} sub-tasks done — status follows sub-tasks")">
                <div class="d-flex align-center" style="gap:.25rem">
                    <MudProgressCircular Size="Size.Small" Color="@ProgressColor" Value="@ProgressPercent" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @FinishedCount/@Task.SubTasks.Count
                    </MudText>
                </div>
            </MudTooltip>
        }

        <PresenceCluster Entries="@Presence" MaxVisible="2" />

        @if (Assignees.Count > 0)
        {
            <span class="presence-cluster">
                @foreach (var assignee in Assignees.Take(3))
                {
                    <UserAvatar UserId="@(assignee.UserId ?? assignee.Id)"
                                DisplayName="@(assignee.DisplayName ?? assignee.Email)"
                                AvatarUrl="@assignee.AvatarUrl" />
                }
            </span>
        }
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public required TaskDto Task { get; set; }

    [Parameter]
    public LabelDto? Label { get; set; }

    [Parameter]
    public IReadOnlyList<ProjectMemberDto> Assignees { get; set; } = [];

    [Parameter]
    public IReadOnlyList<PresenceEntry> Presence { get; set; } = [];

    /// <summary>A remote change just landed here.</summary>
    [Parameter]
    public bool Pulse { get; set; }

    [Parameter]
    public EventCallback<TaskDto> OnOpen { get; set; }

    /// <summary>The project the card's board belongs to, handed to extension contributions.</summary>
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public bool CanWrite { get; set; }

    /// <summary>
    /// Components extensions contribute to every card (<c>[TaskCardExtension]</c>),
    /// found once by the board rather than by each of its cards.
    /// </summary>
    [Parameter]
    public IReadOnlyList<Type> Extensions { get; set; } = [];

    private IDictionary<string, object> ExtensionParameters => new Dictionary<string, object>
    {
        ["Task"] = Task, ["ProjectId"] = ProjectId, ["CanWrite"] = CanWrite,
    };

    private int FinishedCount => Task.SubTasks.Count(s => s.IsFinished);

    private double ProgressPercent =>
        Task.SubTasks.Count == 0 ? 0 : FinishedCount * 100.0 / Task.SubTasks.Count;

    private Color ProgressColor => FinishedCount == Task.SubTasks.Count ? Color.Success : Color.Primary;

    /// <summary>A finished card has nothing left to run down, so it dims and drops its deadline.</summary>
    private bool IsFinished => Task.Status == TaskState.Finished;

    // -- Deadline countdown ---------------------------------------------------
    // The ring sits bottom-left (where the serial number used to be) and drains
    // as the start→deadline window burns down; its colour — shared with the
    // card outline via --deadline-color — slides green→red over the same window.
    // The start is StartAt when the task has one, and its creation otherwise.

    /// <summary>
    /// The deadline is only news while the task is open and its window has begun;
    /// before a future start date the countdown would just be a full green ring.
    /// </summary>
    private bool ShowDeadline => Task.DeadlineAt is not null && !IsFinished && !IsNotStarted;

    private bool IsNotStarted => Task.StartAt is { } start && Today < start;

    private DateOnly Today => DateOnly.FromDateTime(DateTime.Now);

    private int DaysLeft => Task.DeadlineAt!.Value.DayNumber - Today.DayNumber;

    /// <summary>A deadline covers its whole day; it is only missed once the day ends.</summary>
    private bool IsOverdue => DaysLeft < 0;

    /// <summary>
    /// Fraction of the start→end-of-deadline-day window already elapsed, clamped
    /// to [0,1].
    /// </summary>
    private double ElapsedFraction
    {
        get
        {
            var start = Task.StartAt?.ToDateTime(TimeOnly.MinValue) ?? Task.CreatedAt.ToLocalTime();
            var end = Task.DeadlineAt!.Value.AddDays(1).ToDateTime(TimeOnly.MinValue);
            var total = (end - start).TotalSeconds;
            return total <= 0 ? 1 : Math.Clamp((DateTime.Now - start).TotalSeconds / total, 0, 1);
        }
    }

    private string DeadlineColor => $"hsl({120 * (1 - ElapsedFraction):F0} 72% 45%)";

    /// <summary>Overdue shows a full ring (and blinks); otherwise the arc is the time left.</summary>
    private double RemainingPercent => IsOverdue ? 100 : (1 - ElapsedFraction) * 100;

    /// <summary>Only room for two digits; 100+ days out the ring speaks for itself.</summary>
    private string? DaysLeftText
    {
        get
        {
            var days = Math.Max(DaysLeft, 0);
            return days <= 99 ? days.ToString() : null;
        }
    }

    private string DeadlineTooltip
    {
        get
        {
            var days = DaysLeft;
            var when = days switch
            {
                < -1 => $"overdue by {-days} days",
                -1 => "overdue by 1 day",
                0 => "due today",
                1 => "1 day left",
                _ => $"{days} days left",
            };
            var due = $"Due {Task.DeadlineAt!.Value:d MMM yyyy} — {when}";
            return Task.StartAt is { } start ? $"Starts {start:d MMM yyyy}. {due}" : due;
        }
    }

    private string CardClass =>
        "kanban-card pa-2" +
        (ShowDeadline ? " kanban-card--deadline" : string.Empty) +
        (IsFinished ? " kanban-card--finished" : string.Empty) +
        (Pulse ? " solo-pulse" : string.Empty);

    private string? CardStyle =>
        ShowDeadline ? $"--deadline-color:{DeadlineColor}" : null;
}
