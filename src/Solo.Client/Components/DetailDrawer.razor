@using Solo.Shared.Extensibility
@inject ApiClient Api
@inject BoardStore Store
@inject IBoardHubClient Hub
@inject SaveGuard Guard
@inject IDialogService Dialogs
@inject NavigationManager Nav
@inject TaskMenuService TaskMenu

@*
    The right-hand detail drawer for a task or an epic. Every field commits on a
    save event — blur, dropdown selection, or an explicit Save. Opening an editor
    reports Editing presence, which is what warns the next person off.
*@

@* While a description draft is open, clicking off must not throw it away.
   The width holds until the screen is narrower than it is — see .detail-drawer
   in app.css, where a phone takes the drawer full-bleed rather than letting
   most of it hang off the left edge. *@
<MudDrawer Open="@IsOpen" Anchor="Anchor.Right" Elevation="3" Variant="DrawerVariant.Temporary"
           Class="detail-drawer" Width="34rem"
           OverlayAutoClose="@(!_editingDescription)" OpenChanged="@OnOpenChanged">
    @if (Entity is not null)
    {
        <MudDrawerHeader Class="detail-drawer__header d-flex align-center">
            <MudText Typo="Typo.subtitle1" Class="flex-grow-1">
                @HeaderText
            </MudText>
            <PresenceCluster Entries="@PresenceEntries" MaxVisible="4" />
            @* The task menu's way in where there's no right click: a touchscreen,
               or a task opened over a page that isn't a board. *@
            @if (Task is not null && TaskMenu.HasContributors)
            {
                <MudIconButton Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small"
                               OnClick="@ShowTaskMenuAsync" aria-label="More actions" />
            }
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                           OnClick="@CloseAsync" aria-label="Close" />
        </MudDrawerHeader>

        <div class="detail-drawer__body pa-4">
            <EditingWarning Editors="@Editors" />

            @* -- Name: blur commits ------------------------------------------- *@
            <MudTextField T="string" Value="@_name" ValueChanged="@OnNameChanged" Label="Name"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="false"
                          MaxLength="FieldLimits.ItemName"
                          Disabled="@(!CanWrite)" OnKeyDown="@OnNameKeyDown" Class="mb-3" />

            @if (Task is not null)
            {
                @* Wraps: side by side these two need ~24rem, which a phone-width
                   drawer doesn't have. *@
                <div class="d-flex flex-wrap mb-3" style="gap:.75rem">
                    <MudSelect T="Guid?" Value="@Task.LabelId" Label="Label" Variant="Variant.Outlined"
                               Margin="Margin.Dense" Clearable="true" Disabled="@(!CanWrite)"
                               ValueChanged="@OnLabelChanged" Class="flex-grow-1" Style="min-width:11rem">
                        @foreach (var label in TaskLabels)
                        {
                            <MudSelectItem T="Guid?" Value="@label.Id">@label.Name</MudSelectItem>
                        }
                    </MudSelect>

                    <MudTooltip Text="@StatusTooltip" Disabled="@(Task.SubTasks.Count == 0)">
                        <MudSelect T="TaskState" Value="@Task.Status" Label="Status" Variant="Variant.Outlined"
                                   Margin="Margin.Dense" Style="min-width:11rem"
                                   Disabled="@(!CanWrite || Task.SubTasks.Count > 0)"
                                   ValueChanged="@OnStatusChanged">
                            @foreach (var status in BoardZones.Statuses)
                            {
                                <MudSelectItem T="TaskState" Value="@status">@BoardZones.Title(status)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTooltip>
                </div>

                <div class="detail-drawer__ownership mb-4">
                    <div class="detail-drawer__assignees">
                        <AssigneePicker Members="@Store.Members" AssigneeIds="@AssigneeIds"
                                        CanWrite="@CanWrite" OnChanged="@OnAssigneesChanged" />
                    </div>

                    @* Width via Class, not Style: MudPicker copies Style onto the calendar
                       popup's paper too, where a fixed width crops the Fri/Sat columns.
                       A start only means something against a deadline, so it waits for one. *@
                    <div class="detail-drawer__dates">
                        <MudDatePicker Date="@StartDate" DateChanged="@OnStartChanged" Label="Start"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                       Editable="true" Placeholder="@StartPlaceholder" MaxDate="@DeadlineDate"
                                       Disabled="@(!CanWrite || Task.DeadlineAt is null)"
                                       Class="start-picker" />
                        <MudDatePicker Date="@DeadlineDate" DateChanged="@OnDeadlineChanged" Label="Deadline"
                                       Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                                       Editable="true" Placeholder="No deadline" Disabled="@(!CanWrite)"
                                       Class="deadline-picker" />
                    </div>
                </div>
            }
            else
            {
                <div class="mb-4">
                    <AssigneePicker Members="@Store.Members" AssigneeIds="@AssigneeIds"
                                    CanWrite="@CanWrite" OnChanged="@OnAssigneesChanged" />
                </div>
            }

            @if (Task is not null)
            {
                <TaskDetailExtensions Task="@Task" CanWrite="@CanWrite" OnChanged="@RefreshTaskAsync" />
            }

            <MudText Typo="Typo.subtitle2" Class="mb-1">Description</MudText>
            @* Keyed so switching entity (e.g. via a task link) can't carry a draft across. *@
            <MarkdownEditor @key="@EntityId" Value="@Description" CanWrite="@CanWrite"
                            MaxLength="FieldLimits.Description" OnSave="@OnDescriptionSaved"
                            OnEditingChanged="@ReportEditingAsync" Class="mb-4"
                            ProjectId="@Store.Board?.ProjectId" EntityId="@EntityId"
                            Surface="@(Task is not null ? MarkdownSurface.TaskDescription : MarkdownSurface.EpicDescription)" />

            <MudDivider Class="my-4" />

            @if (Task is not null)
            {
                <SubTaskList TaskId="@Task.Id" SubTasks="@Task.SubTasks" CanWrite="@CanWrite"
                             OnChanged="@RefreshTaskAsync" />
                <MudDivider Class="my-4" />
            }

            <CommentThread TaskId="@Task?.Id" EpicId="@Epic?.Id" ProjectId="@Store.Board?.ProjectId" CanModerate="@CanModerate"
                           CanComment="@CanComment" />

            @if (CanWrite)
            {
                <MudDivider Class="my-4" />
                <div class="d-flex flex-wrap" style="gap:.5rem">
                    @if (Task is not null)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.DriveFileMove" OnClick="@MoveAsync">
                            Move to board
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Delete" OnClick="@DeleteAsync">
                        Delete @(Task is not null ? "task" : "epic")
                    </MudButton>
                </div>
            }
        </div>
    }
</MudDrawer>

@code {
    private string _name = string.Empty;
    private Guid? _boundTo;
    private bool _editingDescription;

    [Parameter]
    public TaskDto? Task { get; set; }

    [Parameter]
    public EpicDto? Epic { get; set; }

    [Parameter]
    public bool CanWrite { get; set; }

    /// <summary>Project owner or super admin: may delete any comment.</summary>
    [Parameter]
    public bool CanModerate { get; set; }

    /// <summary>
    /// False on a closed board. Separate from <see cref="CanWrite"/> because the
    /// two answer different questions: commenting asks whether the board is open,
    /// not whether this member may edit it.
    /// </summary>
    [Parameter]
    public bool CanComment { get; set; } = true;

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// A delete or a board move, announced before the card leaves the store —
    /// by then the drawer is the only one who knows which of the two it was.
    /// </summary>
    [Parameter]
    public EventCallback<TaskDrawerChange> OnTaskChanged { get; set; }

    private bool IsOpen => Entity is not null;

    private object? Entity => (object?)Task ?? Epic;

    private Guid EntityId => Task?.Id ?? Epic!.Id;

    private string EntityType => Task is not null ? EntityTypes.Task : EntityTypes.Epic;

    /// <summary>A task announces itself by serial number; epics have none.</summary>
    private string HeaderText =>
        Task is { } task && Store.Board is { } board
            ? Aliases.Serial(board.ProjectAlias, board.Alias, task.Number)
            : Task is not null ? "Task" : "Epic";

    private string? Description => Task?.Description ?? Epic?.Description;

    private IReadOnlyList<Guid> AssigneeIds => Task?.AssigneeIds ?? Epic?.AssigneeIds ?? [];

    /// <summary>MudDatePicker speaks DateTime; the deadline is a plain date.</summary>
    private DateTime? DeadlineDate => Task?.DeadlineAt?.ToDateTime(TimeOnly.MinValue);

    private DateTime? StartDate => Task?.StartAt?.ToDateTime(TimeOnly.MinValue);

    /// <summary>With no start set, the countdown runs from creation — so that is what the empty field says.</summary>
    private string StartPlaceholder => Task is { } task ? $"Created {task.CreatedAt.ToLocalTime():d MMM}" : "";

    private IReadOnlyList<PresenceEntry> PresenceEntries =>
        Entity is null ? [] : Store.PresenceOn(EntityType, EntityId);

    private IReadOnlyList<PresenceEntry> Editors =>
        Entity is null ? [] : Store.EditorsOn(EntityType, EntityId);

    /// <summary>Only task-kind labels apply to tasks.</summary>
    private IEnumerable<LabelDto> TaskLabels =>
        (Store.Board?.Labels ?? []).Where(l => l.Kind == LabelKind.Task);

    private const string StatusTooltip = "Status follows sub-tasks — tick them off instead.";

    protected override void OnParametersSet()
    {
        // Re-seed the local edit buffer only when the drawer switches entity, so a
        // live refetch never clobbers what the user is mid-way through typing.
        if (Entity is null)
        {
            _boundTo = null;
            _editingDescription = false;
            return;
        }

        if (_boundTo != EntityId)
        {
            _boundTo = EntityId;
            _name = Task?.Name ?? Epic!.Name;
            _editingDescription = false;
        }
    }

    // -- Presence -----------------------------------------------------------

    private Task ReportEditingAsync(bool editing)
    {
        _editingDescription = editing;
        return Hub.SetPresence(EntityType, EntityId, editing ? PresenceMode.Editing : PresenceMode.Viewing);
    }

    private async Task OnOpenChanged(bool open)
    {
        if (open)
        {
            return;
        }

        // Belt to OverlayAutoClose's braces: whatever asked us to close mid-draft
        // is refused, and the re-render re-asserts Open on the drawer.
        if (_editingDescription)
        {
            StateHasChanged();
            return;
        }

        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        // Esc and overlay-click both land here; the board clears presence.
        await OnClose.InvokeAsync();
    }

    // -- Save events --------------------------------------------------------

    private async Task OnNameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await OnNameChanged(_name);
        }
    }

    private async Task OnNameChanged(string name)
    {
        _name = name;
        if (string.IsNullOrWhiteSpace(name) || name == (Task?.Name ?? Epic!.Name))
        {
            return;
        }

        await SaveAsync(name.Trim(), Description);
    }

    private Task OnDescriptionSaved(string description) =>
        SaveAsync(Task?.Name ?? Epic!.Name, description);

    private async Task SaveAsync(string name, string? description)
    {
        if (Task is { } task)
        {
            await SaveTaskAsync(task, name, task.LabelId, description, task.DeadlineAt);
        }
        else if (Epic is { } epic)
        {
            var saved = await Guard.RunAsync(
                () => Api.UpdateEpicAsync(epic.Id, new UpdateEpicRequest
                {
                    Name = name,
                    Description = description,
                    Version = epic.Version,
                }),
                Store.RefreshAsync);

            if (saved is not null)
            {
                Store.ApplyEpic(saved);
            }
        }
    }

    private async Task OnLabelChanged(Guid? labelId)
    {
        if (Task is not { } task)
        {
            return;
        }

        await SaveTaskAsync(task, task.Name, labelId, task.Description, task.DeadlineAt);
    }

    private async Task OnDeadlineChanged(DateTime? date)
    {
        var deadline = date is { } d ? DateOnly.FromDateTime(d) : (DateOnly?)null;
        if (Task is not { } task || task.DeadlineAt == deadline)
        {
            return;
        }

        // The server's rule for a plain update, applied here too: a start left
        // with no deadline, or stranded past a new one, goes rather than blocks.
        var start = deadline is { } end && task.StartAt <= end ? task.StartAt : null;
        await SaveScheduleAsync(task, start, deadline);
    }

    private async Task OnStartChanged(DateTime? date)
    {
        var start = date is { } d ? DateOnly.FromDateTime(d) : (DateOnly?)null;
        if (Task is not { } task || task.StartAt == start)
        {
            return;
        }

        await SaveScheduleAsync(task, start, task.DeadlineAt);
    }

    private async Task SaveScheduleAsync(TaskDto task, DateOnly? start, DateOnly? deadline)
    {
        var saved = await Guard.RunAsync(
            () => Api.SetTaskScheduleAsync(task.Id, start, deadline, task.Version),
            Store.RefreshAsync);

        if (saved is not null)
        {
            Store.ApplyTask(saved);
        }
    }

    /// <summary>
    /// Every task edit on this drawer sends the whole DTO with one field swapped,
    /// so the save sits here once and each caller passes what it changed. The
    /// fields stay explicit rather than defaulted: clearing a label or a deadline
    /// has to stay distinguishable from leaving it alone.
    /// </summary>
    private async Task SaveTaskAsync(
        TaskDto task, string name, Guid? labelId, string? description, DateOnly? deadline)
    {
        var saved = await Guard.RunAsync(
            () => Api.UpdateTaskAsync(task.Id, new UpdateTaskRequest
            {
                Name = name,
                LabelId = labelId,
                Description = description,
                DeadlineAt = deadline,
                Version = task.Version,
            }),
            Store.RefreshAsync);

        if (saved is not null)
        {
            Store.ApplyTask(saved);
        }
    }

    private async Task OnStatusChanged(TaskState status)
    {
        if (Task is not { } task || task.Status == status)
        {
            return;
        }

        var saved = await Guard.RunAsync(() => Api.SetTaskStatusAsync(task.Id, status), Store.RefreshAsync);
        if (saved is not null)
        {
            Store.ApplyTask(saved);
        }
    }

    private async Task OnAssigneesChanged(IReadOnlyList<Guid> userIds)
    {
        if (Task is { } task)
        {
            var saved = await Guard.RunAsync(
                () => Api.SetTaskAssigneesAsync(task.Id, userIds), Store.RefreshAsync);
            if (saved is not null)
            {
                Store.ApplyTask(saved);
            }
        }
        else if (Epic is { } epic)
        {
            var saved = await Guard.RunAsync(
                () => Api.SetEpicAssigneesAsync(epic.Id, userIds), Store.RefreshAsync);
            if (saved is not null)
            {
                Store.ApplyEpic(saved);
            }
        }
    }

    /// <summary>A checklist change re-derives the task's status server-side.</summary>
    private async Task RefreshTaskAsync()
    {
        if (Task is { } task)
        {
            Store.ApplyTask(await Api.GetTaskAsync(task.Id));
        }
    }

    /// <summary>
    /// Transfer to another board in the project, then follow the task there. The
    /// serial number moved with it, so the destination's ?task= link is what
    /// still points at the card — and landing on the board it went to is the
    /// only way to see that the move did what was asked.
    /// </summary>
    private async Task MoveAsync()
    {
        if (Task is not { } task || Store.Board is not { } board)
        {
            return;
        }

        var dialog = await Dialogs.ShowAsync<MoveTaskDialog>(
            "Move task",
            new DialogParameters<MoveTaskDialog>
            {
                { d => d.ProjectId, board.ProjectId },
                { d => d.CurrentBoardId, board.Id },
            });

        if (await dialog.Result is not { Canceled: false, Data: MoveTaskDialog.Target target })
        {
            return;
        }

        var moved = await Guard.RunAsync(
            () => Api.MoveTaskAsync(task.Id, target.Board.Id, target.EpicId), Store.RefreshAsync);
        if (moved is null)
        {
            return;
        }

        await OnTaskChanged.InvokeAsync(new TaskDrawerChange(TaskDrawerChangeKind.Moved, task.Id, moved));

        // Drop the card from the board being left before navigating, so it can't
        // flash back in the frame between the save and the new board's load.
        Store.RemoveTask(task.Id);
        await CloseAsync();
        Nav.NavigateTo($"projects/{board.ProjectAlias}/boards/{target.Board.Alias}?task={moved.Number}");
    }

    private async Task DeleteAsync()
    {
        var noun = Task is not null ? "task" : "epic";
        var name = Task?.Name ?? Epic!.Name;

        var dialog = await Dialogs.ShowAsync<ConfirmDialog>(
            $"Delete {noun}",
            new DialogParameters<ConfirmDialog>
            {
                { d => d.Message, $"Delete the {noun} \"{name}\"?" },
            });

        if (await dialog.Result is not { Canceled: false })
        {
            return;
        }

        if (Task is { } task)
        {
            if (await Guard.RunAsync(() => Api.DeleteTaskAsync(task.Id)))
            {
                await OnTaskChanged.InvokeAsync(new TaskDrawerChange(TaskDrawerChangeKind.Deleted, task.Id, null));
            }

            Store.RemoveTask(task.Id);
        }
        else if (Epic is { } epic)
        {
            await Guard.RunAsync(() => Api.DeleteEpicAsync(epic.Id));
            await Store.RefreshAsync();
        }

        await CloseAsync();
    }

    private Task ShowTaskMenuAsync(MouseEventArgs e) =>
        Task is { } task && Store.Board is { } board
            ? TaskMenu.ShowAsync(e.ClientX, e.ClientY, new TaskMenuContext(task, board.ProjectId, CanWrite))
            : System.Threading.Tasks.Task.CompletedTask;
}
