@inject ApiClient Api
@inject SaveGuard Guard
@inject BoardStore Store

@*
    A task with sub-tasks has a derived status: the checklist drives it. Ticking a
    box applies the roll-up locally for instant feedback, then reconciles from the
    server's response — which is authoritative.
*@

<div class="d-flex align-center mb-1">
    <MudText Typo="Typo.subtitle2">Sub-tasks</MudText>
    @if (SubTasks.Count > 0)
    {
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">
            @SubTasks.Count(s => s.IsFinished)/@SubTasks.Count
        </MudText>
    }
</div>

@if (SubTasks.Count == 0)
{
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
        None. Adding one makes this task's status follow the checklist.
    </MudText>
}
else
{
    <MudList T="string" Dense="true" Class="pa-0">
        @foreach (var subTask in Ordered)
        {
            <MudListItem T="string" Class="pa-0">
                @* The row is a reorder drop target; the handle beside it is the drag
                   source. See the reordering region below for why this is hand-rolled. *@
                <div class="@RowClass(subTask)"
                     @ondragenter="@(() => EnterDrag(subTask))"
                     @ondragover:preventDefault="@(_dragged is not null)"
                     @ondrop:preventDefault="true"
                     @ondrop="@(() => DropAsync(subTask))">
                    @if (CanReorder)
                    {
                        <MudTooltip Text="Drag to reorder">
                            <span class="subtask-drag-handle" draggable="true" aria-hidden="true"
                                  @ondragstart="@(() => StartDrag(subTask))"
                                  @ondragend="@EndDrag">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator"
                                         Size="Size.Small" Color="Color.Secondary" />
                            </span>
                        </MudTooltip>
                    }

                    <MudCheckBox T="bool" Value="@subTask.IsFinished" Dense="true" Color="Color.Primary"
                                 Disabled="@(!CanWrite)"
                                 ValueChanged="@(finished => ToggleAsync(subTask, finished))" />

                    @* Click the name to rename in place — the drawer's convention:
                       blur or Enter commits, Escape throws the draft away. *@
                    @if (_editingId == subTask.Id)
                    {
                        <MudTextField @bind-Value="_editName" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Immediate="true" MaxLength="FieldLimits.ItemName" AutoFocus="true"
                                      Class="flex-grow-1" aria-label="Edit sub-task"
                                      OnKeyDown="@(e => OnEditKeyDown(e, subTask))"
                                      OnBlur="@(() => CommitEditAsync(subTask))" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="flex-grow-1" Style="@NameStyle(subTask)"
                                 @onclick="@(() => BeginEdit(subTask))">
                            @subTask.Name
                        </MudText>
                    }

                    @* Click the tag icon to pick a label; once set it shows the label's
                       own icon, with the name in a tooltip. Uses MudMenu's built-in Icon
                       activator (as the epic menu does) — its popover opens reliably in
                       the drawer, unlike an ActivatorContent activator. *@
                    @{
                        var current = LabelOf(subTask);
                    }
                    @if (CanWrite)
                    {
                        <MudTooltip Text="@(current?.Name ?? "Set label")">
                            @* The span carries the label's own colour; Inherit hands it to the icon. *@
                            <span class="subtask-label-menu d-flex align-center"
                                  style="@(current is null ? null : $"color:{current.Color}")">
                                <MudMenu Icon="@ActivatorIcon(current)" Size="Size.Small" Dense="true"
                                         Color="@(current is null ? Color.Default : Color.Inherit)"
                                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <MudMenuItem OnClick="@(() => SetLabelAsync(subTask, null))">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">No label</MudText>
                                    </MudMenuItem>
                                    @foreach (var label in SubTaskLabels)
                                    {
                                        <MudMenuItem OnClick="@(() => SetLabelAsync(subTask, label.Id))">
                                            <LabelChip Label="@label" />
                                        </MudMenuItem>
                                    }
                                </MudMenu>
                            </span>
                        </MudTooltip>
                    }
                    else if (current is not null)
                    {
                        <LabelChip Label="@current" IconOnly="true" />
                    }

                    @if (CanWrite)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => DeleteAsync(subTask))" aria-label="Delete sub-task" />
                    }
                </div>
            </MudListItem>
        }
    </MudList>
}

@if (CanWrite)
{
    <div class="d-flex align-center mt-2" style="gap:.5rem">
        <MudTextField @bind-Value="_newName" Placeholder="Add a sub-task…" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Immediate="true" MaxLength="FieldLimits.ItemName"
                      OnKeyDown="@OnKeyDown" Class="flex-grow-1" />
        <MudIconButton Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Size="Size.Small"
                       Disabled="@string.IsNullOrWhiteSpace(_newName)" OnClick="@AddAsync"
                       aria-label="Add sub-task" />
    </div>
}

@code {
    private string _newName = string.Empty;
    private Guid? _editingId;
    private string _editName = string.Empty;
    private SubTaskDto? _dragged;
    private Guid? _dropTarget;

    [Parameter, EditorRequired]
    public Guid TaskId { get; set; }

    [Parameter, EditorRequired]
    public required IReadOnlyList<SubTaskDto> SubTasks { get; set; }

    [Parameter]
    public bool CanWrite { get; set; }

    /// <summary>Sub-task edits change the parent task's status, so the drawer refetches it.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>Rank is the checklist's order; everything renders from it.</summary>
    private List<SubTaskDto> Ordered => SubTasks.OrderBy(s => s.Rank).ToList();

    /// <summary>A single item has nothing to swap with, so it gets no handle.</summary>
    private bool CanReorder => CanWrite && SubTasks.Count > 1;

    private LabelDto? LabelOf(SubTaskDto subTask) =>
        subTask.LabelId is null ? null : Store.Board?.Labels.FirstOrDefault(l => l.Id == subTask.LabelId);

    /// <summary>Only sub-task-kind labels apply to a checklist item.</summary>
    private IEnumerable<LabelDto> SubTaskLabels =>
        (Store.Board?.Labels ?? []).Where(l => l.Kind == LabelKind.SubTask);

    /// <summary>
    /// The picker's icon: the label's own icon/image when it has one, a filled tag
    /// when a plain label is set, an outlined tag when there's no label yet.
    /// </summary>
    private static string ActivatorIcon(LabelDto? label) => label switch
    {
        null => Icons.Material.Outlined.Label,
        { ImageId: not null } or { Icon: not null } => SoloIcons.Resolve(label.ImageId, label.Icon),
        _ => Icons.Material.Filled.Label,
    };

    private string? NameStyle(SubTaskDto subTask)
    {
        var strike = subTask.IsFinished ? "text-decoration:line-through;opacity:.6;" : null;
        var cursor = CanWrite ? "cursor:text" : null;
        return strike is null && cursor is null ? null : $"{strike}{cursor}";
    }

    private void BeginEdit(SubTaskDto subTask)
    {
        if (!CanWrite)
        {
            return;
        }

        _editingId = subTask.Id;
        _editName = subTask.Name;
    }

    private async Task OnEditKeyDown(KeyboardEventArgs e, SubTaskDto subTask)
    {
        if (e.Key == "Enter")
        {
            await CommitEditAsync(subTask);
        }
        else if (e.Key == "Escape")
        {
            _editingId = null;
        }
    }

    private async Task CommitEditAsync(SubTaskDto subTask)
    {
        // Enter commits and removes the field; a straggling blur must not re-commit.
        if (_editingId != subTask.Id)
        {
            return;
        }

        _editingId = null;
        var name = _editName.Trim();
        if (name.Length == 0 || name == subTask.Name)
        {
            return;
        }

        await Guard.RunAsync(
            () => Api.UpdateSubTaskAsync(subTask.Id, new UpdateSubTaskRequest
            {
                Name = name,
                LabelId = subTask.LabelId,
                Version = subTask.Version,
            }),
            OnChanged.InvokeAsync);

        await OnChanged.InvokeAsync();
    }

    private async Task SetLabelAsync(SubTaskDto subTask, Guid? labelId)
    {
        if (subTask.LabelId == labelId)
        {
            return;
        }

        await Guard.RunAsync(
            () => Api.UpdateSubTaskAsync(subTask.Id, new UpdateSubTaskRequest
            {
                Name = subTask.Name,
                LabelId = labelId,
                Version = subTask.Version,
            }),
            OnChanged.InvokeAsync);

        await OnChanged.InvokeAsync();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AddAsync();
        }
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            return;
        }

        var name = _newName.Trim();
        _newName = string.Empty;

        await Guard.RunAsync(() => Api.CreateSubTaskAsync(TaskId, new CreateSubTaskRequest { Name = name }));
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// Ticking boxes no longer forces the column — status is manual now. The one
    /// automatic move remains: completing the last box sends the card to Finished,
    /// as a client-driven status change (the server just stores what it's told).
    /// Un-ticking never moves it back out; that's a manual choice.
    /// </summary>
    private async Task ToggleAsync(SubTaskDto subTask, bool isFinished)
    {
        var task = Store.Board?.Tasks.FirstOrDefault(t => t.Id == TaskId);
        var updated = task?.SubTasks
            .Select(s => s.Id == subTask.Id ? s with { IsFinished = isFinished } : s)
            .ToList();
        var allDone = updated is { Count: > 0 } && updated.TrueForAll(s => s.IsFinished);
        var autoFinish = allDone && task!.Status != TaskState.Finished;

        // Optimistic: reflect the tick (and the auto-finish) before the round trip.
        if (task is not null)
        {
            Store.ApplyTask(task with
            {
                SubTasks = updated!,
                Status = autoFinish ? TaskState.Finished : task.Status,
            });
        }

        await Guard.RunAsync(() => Api.SetSubTaskFinishedAsync(subTask.Id, isFinished));
        if (autoFinish)
        {
            await Guard.RunAsync(() => Api.SetTaskStatusAsync(TaskId, TaskState.Finished));
        }

        await OnChanged.InvokeAsync();
    }

    private async Task DeleteAsync(SubTaskDto subTask)
    {
        await Guard.RunAsync(() => Api.DeleteSubTaskAsync(subTask.Id));
        await OnChanged.InvokeAsync();
    }

    // -- Reordering ---------------------------------------------------------
    //
    // Hand-rolled HTML5 drag & drop, as the epic bands use: a MudDropContainer
    // here would be a nested container inside the board's, and the two fight
    // for the same pointer events. Only the handle is draggable, so the row's
    // own controls (checkbox, label menu, rename field) keep their gestures.

    private string RowClass(SubTaskDto subTask)
    {
        var dragging = _dragged?.Id == subTask.Id ? " subtask-row--dragging" : null;
        var target = _dropTarget == subTask.Id ? " subtask-row--drop-target" : null;
        return $"subtask-row d-flex align-center{dragging}{target}";
    }

    private void StartDrag(SubTaskDto subTask)
    {
        if (CanReorder)
        {
            _dragged = subTask;
            _dropTarget = null;
        }
    }

    /// <summary>
    /// dragenter, not dragover: it fires once per element entered, and every child
    /// of a row reports the same sub-task, so the highlight never flickers.
    /// </summary>
    private void EnterDrag(SubTaskDto subTask)
    {
        if (_dragged is not null && _dragged.Id != subTask.Id)
        {
            _dropTarget = subTask.Id;
        }
    }

    private void EndDrag()
    {
        _dragged = null;
        _dropTarget = null;
    }

    /// <summary>
    /// Dropping on a row puts the dragged item in its place: dragging down lands
    /// after the target, dragging up lands before it. The parent task refetches,
    /// which is what re-sorts the list.
    /// </summary>
    private async Task DropAsync(SubTaskDto target)
    {
        var dragged = _dragged;
        EndDrag();

        if (dragged is null || dragged.Id == target.Id || !CanReorder)
        {
            return;
        }

        var ordered = Ordered;
        var index = ordered.FindIndex(s => s.Id == target.Id);
        var others = ordered.Where(s => s.Id != dragged.Id).Select(s => s.Id).ToList();
        if (index < 0 || others.Count != ordered.Count - 1)
        {
            return;
        }

        var (preceding, following) = RankNeighbors.Compute(others, index);
        if (preceding is null && following is null)
        {
            return;
        }

        await Guard.RunAsync(
            () => Api.RerankSubTaskAsync(dragged.Id, preceding, following),
            OnChanged.InvokeAsync);

        await OnChanged.InvokeAsync();
    }
}
