@inject ApiClient Api
@inject ProjectNavStore Nav
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@*
    Fold, don't hide: closed boards live in a faded foldout with one-click
    reopen. Everything stays reachable.
*@

@if (_boards is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @if (CanWrite)
    {
        <div class="d-flex justify-end mb-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="@CreateBoardAsync">
                New board
            </MudButton>
        </div>
    }

    @if (_open.Count == 0)
    {
        <EmptyState Message="No boards yet."
                    Icon="@Icons.Material.Filled.ViewKanban"
                    ActionText="@(CanWrite ? "Create one" : null)"
                    OnAction="@CreateBoardAsync" />
    }
    else
    {
        <div class="grid-inset">
        <MudGrid>
            @foreach (var board in _open)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="1">
                        <MudCardContent Class="d-flex align-center" Style="gap:.75rem;cursor:pointer"
                                        @onclick="@(() => Open(board))">
                            <EntityIcon ImageId="@board.ImageId" Icon="@board.Icon" Color="Color.Primary" />
                            <MudText Typo="Typo.h4" Class="text-truncate flex-grow-1">@board.Name</MudText>
                        </MudCardContent>
                        @if (CanWrite)
                        {
                            <MudCardActions>
                                <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Settings"
                                           OnClick="@(() => RenameBoardAsync(board))">Board settings</MudButton>
                                <MudSpacer />
                                <MudButton Size="Size.Small" Color="Color.Default"
                                           OnClick="@(() => SetOpenAsync(board, false))">
                                    Close
                                </MudButton>
                            </MudCardActions>
                        }
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
        </div>
    }

    @if (_closed.Count > 0)
    {
        <MudExpansionPanels Class="mt-6" Elevation="0">
            <MudExpansionPanel Style="opacity:.65">
                <TitleContent>
                    <div class="d-flex align-center" style="gap:.5rem">
                        <MudIcon Icon="@Icons.Material.Filled.Archive" Size="Size.Small" />
                        <MudText Typo="Typo.body2">Closed boards (@_closed.Count)</MudText>
                    </div>
                </TitleContent>
                <ChildContent>
                    <MudList T="string" Dense="true">
                        @foreach (var board in _closed)
                        {
                            <MudListItem T="string" Icon="@SoloIcons.Resolve(board.ImageId, board.Icon)">
                                <div class="d-flex align-center">
                                    <MudText Typo="Typo.body2" Class="flex-grow-1">@board.Name</MudText>
                                    @if (CanWrite)
                                    {
                                        <MudButton Size="Size.Small" Color="Color.Primary"
                                                   OnClick="@(() => SetOpenAsync(board, true))">
                                            Reopen
                                        </MudButton>
                                    }
                                    <MudButton Size="Size.Small" OnClick="@(() => Open(board))">View</MudButton>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
}

@code {
    private IReadOnlyList<BoardDto>? _boards;

    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    [Parameter]
    public bool CanWrite { get; set; }

    private List<BoardDto> _open = [];
    private List<BoardDto> _closed = [];

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _boards = await Api.GetBoardsAsync(ProjectId);
            _open = _boards.Where(b => b.IsOpen).OrderBy(b => b.Name).ToList();
            _closed = _boards.Where(b => !b.IsOpen).OrderBy(b => b.Name).ToList();
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't load boards.", Severity.Error);
            _boards = [];
        }
    }

    private void Open(BoardDto board) => Navigation.NavigateTo($"projects/{ProjectId}/boards/{board.Id}");

    private async Task CreateBoardAsync()
    {
        var dialog = await Dialogs.ShowAsync<NameIconDialog>(
            "New board",
            new DialogParameters<NameIconDialog> { { d => d.SaveText, "Create" } });

        if (await dialog.Result is not { Canceled: false, Data: NameIconDialog.NameIcon created })
        {
            return;
        }

        try
        {
            var board = await Api.CreateBoardAsync(ProjectId,
                new CreateBoardRequest { Name = created.Name, Icon = created.Icon, ImageId = created.ImageId });
            await Nav.RefreshBoardsAsync(ProjectId);
            Open(board);
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't create the board.", Severity.Error);
        }
    }

    private async Task RenameBoardAsync(BoardDto board)
    {
        var dialog = await Dialogs.ShowAsync<NameIconDialog>(
            "Board settings",
            new DialogParameters<NameIconDialog>
            {
                { d => d.Name, board.Name },
                { d => d.Icon, board.Icon },
                { d => d.ImageId, board.ImageId },
                { d => d.SaveText, "Save" },
            });

        if (await dialog.Result is not { Canceled: false, Data: NameIconDialog.NameIcon edited })
        {
            return;
        }

        try
        {
            await Api.UpdateBoardAsync(board.Id, new UpdateBoardRequest
            {
                Name = edited.Name,
                Icon = edited.Icon,
                ImageId = edited.ImageId,
                Version = board.Version,
            });
            await LoadAsync();
            await Nav.RefreshBoardsAsync(ProjectId);
        }
        catch (ApiConflictException)
        {
            Snackbar.Add("Updated by someone else — your view was refreshed.", Severity.Info);
            await LoadAsync();
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't rename the board.", Severity.Error);
        }
    }

    private async Task SetOpenAsync(BoardDto board, bool isOpen)
    {
        try
        {
            await Api.SetBoardOpenAsync(board.Id, isOpen);
            await LoadAsync();
            // Closing a board removes it from the sidebar; reopening puts it back.
            await Nav.RefreshBoardsAsync(ProjectId);
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't update the board.", Severity.Error);
        }
    }
}
