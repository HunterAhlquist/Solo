@inject ApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject SaveGuard Guard

@*
    Labels, split by what they apply to. With a BoardId this edits that board's
    own labels — the ones its items can carry — and offers a reset back to the
    project defaults. Without one it edits the project defaults themselves: the
    template new boards copy, which no existing board follows.
*@

@if (_labels is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    @* grid-inset: without it MudGrid's negative top margin overlays the tab strip. *@
    <div class="grid-inset">
    <div class="d-flex align-center mb-2" style="gap:.75rem">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @(IsBoardScoped
                ? "Only this board uses these labels."
                : "New boards start from these. Boards that already exist keep their own.")
        </MudText>
        <MudSpacer />
        @if (IsBoardScoped && CanWrite)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.SettingsBackupRestore" OnClick="@ResetAsync">
                Reset to project defaults
            </MudButton>
        }
    </div>

    <MudGrid>
        @foreach (var kind in new[] { LabelKind.Task, LabelKind.SubTask })
        {
            <MudItem xs="12" md="6">
                <MudPaper Elevation="1" Class="pa-3">
                    <div class="d-flex align-center mb-3">
                        <MudText Typo="Typo.h4">
                            @(kind == LabelKind.Task ? "Task labels" : "Sub-task labels")
                        </MudText>
                        <MudSpacer />
                        @if (CanWrite)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => CreateAsync(kind))" aria-label="Add label" />
                        }
                    </div>

                    @{
                        var labels = _labels.Where(l => l.Kind == kind).ToList();
                    }
                    @if (labels.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">None yet.</MudText>
                    }
                    else
                    {
                        <MudList T="string" Dense="true">
                            @foreach (var label in labels)
                            {
                                <MudListItem T="string">
                                    <div class="d-flex align-center" style="gap:.6rem">
                                        <LabelChip Label="@label" />
                                        <MudSpacer />
                                        @if (CanWrite)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                           OnClick="@(() => EditAsync(label))" aria-label="Edit label" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                           Color="Color.Error" OnClick="@(() => DeleteAsync(label))"
                                                           aria-label="Delete label" />
                                        }
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
    </div>
}

@code {
    private IReadOnlyList<LabelDto>? _labels;

    [Parameter, EditorRequired]
    public Guid ProjectId { get; set; }

    /// <summary>Set to edit one board's labels; null edits the project defaults.</summary>
    [Parameter]
    public Guid? BoardId { get; set; }

    [Parameter]
    public bool CanWrite { get; set; }

    /// <summary>Raised after every change, so a host holding board state can refetch.</summary>
    [Parameter]
    public EventCallback Changed { get; set; }

    private bool IsBoardScoped => BoardId is not null;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            _labels = BoardId is { } boardId
                ? await Api.GetBoardLabelsAsync(boardId)
                : await Api.GetLabelsAsync(ProjectId);
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't load labels.", Severity.Error);
            _labels = [];
        }
    }

    private async Task CreateAsync(LabelKind kind)
    {
        var dialog = await Dialogs.ShowAsync<LabelDialog>(
            "New label",
            new DialogParameters<LabelDialog> { { d => d.SaveText, "Create" } });

        if (await dialog.Result is not { Canceled: false, Data: LabelDialog.LabelEdit created })
        {
            return;
        }

        var request = new CreateLabelRequest
        {
            Kind = kind,
            Name = created.Name,
            Color = created.Color,
            Icon = created.Icon,
            ImageId = created.ImageId,
        };

        await GuardAsync(() => BoardId is { } boardId
            ? Api.CreateBoardLabelAsync(boardId, request)
            : Api.CreateLabelAsync(ProjectId, request));
    }

    private async Task EditAsync(LabelDto label)
    {
        var dialog = await Dialogs.ShowAsync<LabelDialog>(
            "Edit label",
            new DialogParameters<LabelDialog>
            {
                { d => d.Name, label.Name },
                { d => d.HexColor, label.Color },
                { d => d.Icon, label.Icon },
                { d => d.ImageId, label.ImageId },
                { d => d.SaveText, "Save" },
            });

        if (await dialog.Result is not { Canceled: false, Data: LabelDialog.LabelEdit edited })
        {
            return;
        }

        var request = new UpdateLabelRequest
        {
            Name = edited.Name,
            Color = edited.Color,
            Icon = edited.Icon,
            ImageId = edited.ImageId,
            Version = label.Version,
        };

        await GuardAsync(() => BoardId is { } boardId
            ? Api.UpdateBoardLabelAsync(boardId, label.Id, request)
            : Api.UpdateLabelAsync(ProjectId, label.Id, request));
    }

    private async Task DeleteAsync(LabelDto label)
    {
        var dialog = await Dialogs.ShowAsync<ConfirmDialog>(
            "Delete label",
            new DialogParameters<ConfirmDialog>
            {
                { d => d.Message, $"Delete the label \"{label.Name}\"? Items using it keep their other fields." },
            });

        if (await dialog.Result is not { Canceled: false })
        {
            return;
        }

        await GuardAsync(() => BoardId is { } boardId
            ? Api.DeleteBoardLabelAsync(boardId, label.Id)
            : Api.DeleteLabelAsync(ProjectId, label.Id));
    }

    private async Task ResetAsync()
    {
        if (BoardId is not { } boardId)
        {
            return;
        }

        var dialog = await Dialogs.ShowAsync<ConfirmDialog>(
            "Reset labels",
            new DialogParameters<ConfirmDialog>
            {
                { d => d.Message, "Put this board's labels back to the project defaults? " +
                                  "Edits to them are undone; labels this board added itself are deleted, " +
                                  "and items using those lose their label." },
                { d => d.ConfirmText, "Reset" },
            });

        if (await dialog.Result is not { Canceled: false })
        {
            return;
        }

        await GuardAsync(() => Api.ResetBoardLabelsAsync(boardId));
    }

    private async Task GuardAsync(Func<Task> action)
    {
        await Guard.RunAsync(action);
        await LoadAsync();
        await Changed.InvokeAsync();
    }
}
