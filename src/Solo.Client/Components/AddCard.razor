@*
    Square dashed "add" tile that closes a card grid — as large as its cell
    allows, so it matches the cards beside it without outgrowing them. An
    affordance, not a destination: quiet until hovered, like the sidebar's
    add actions.

    Host it in a MudItem with the same breakpoints as the sibling cards: in a
    size-less (shrink-to-fit) item the cell has no width of its own to
    measure the square against.
*@

<div class="add-card-cell">
    <MudTooltip Text="@Label">
        <button type="button" class="add-card" aria-label="@Label" @onclick="@OnClick">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Large" />
        </button>
    </MudTooltip>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnClick { get; set; }
}
