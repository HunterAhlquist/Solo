@inherits LayoutComponentBase
@implements IDisposable
@inject UserSession Session
@inject AppConfig Config
@inject GoogleIdentityService Google
@inject NavigationManager Navigation
@inject SessionExpiry SessionExpiry
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ThemeState Theme

<SoloThemeProvider />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" CloseOnEscapeKey="true" MaxWidth="MaxWidth.Small" FullWidth="true" />
<MudSnackbarProvider />

<MudLayout>
    @* Height comes from the theme's AppbarHeight (5em), so no Dense here. *@
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Toggle navigation" />
        <MudLink Href="" Underline="Underline.None" Color="Color.Inherit" Class="ml-2">
            <MudText Typo="Typo.h5">Solo</MudText>
        </MudLink>
        <MudSpacer />

        <AuthorizeView Context="auth">
            <Authorized>
                <ConnectionIndicator />
                @* MudMenu's built-in Icon activator (not ActivatorContent, which never
                   opens here). The SSO picture rides in as a circular SVG image; with
                   no picture it falls back to the default account glyph. *@
                <MudMenu Icon="@ProfileIcon" Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudText Typo="Typo.body2" Class="px-4 py-2">@auth.User.Identity?.Name</MudText>
                    <MudDivider />
                    <ColorSchemeMenu />
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="@SignOut">Sign out</MudMenuItem>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <AuthorizeView>
        <Authorized>
            @* Responsive, not Mini: a Mini drawer is icon-only and can't hold a tree. *@
            <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always"
                       Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md">
                <NavMenu />
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>

        <footer class="app-footer">
            <div class="app-footer__copyright">Solo, a simple project management app - 
                <MudLink Target="_blank" Href="https://github.com/HunterAhlquist/Solo">View Source on Github</MudLink></div>
        </footer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    /// <summary>
    /// The menu's activator icon. MudMenu wraps <c>Icon</c> in an
    /// <c>&lt;svg viewBox="0 0 24 24"&gt;</c>, so the SSO picture goes in as a
    /// circular SVG <c>&lt;image&gt;</c>; without one, the default account glyph.
    /// </summary>
    private string ProfileIcon =>
        Session.Current is { AvatarUrl.Length: > 0 } user
            ? $"<image href=\"{ApiClient.AvatarUrl(user.Id)}\" x=\"0\" y=\"0\" width=\"24\" height=\"24\" " +
              "preserveAspectRatio=\"xMidYMid slice\" style=\"clip-path:circle(12px at 12px 12px)\" />"
            : Icons.Material.Filled.AccountCircle;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _expiryDialogOpen;
    private bool _signingOut;

    protected override void OnInitialized()
    {
        SessionExpiry.Expired += OnSessionExpired;
        Session.AccessDenied += OnAccessDenied;
    }

    /// <summary>
    /// Silent renewal failed or the API rejected our token: offer re-sign-in in
    /// place, so an open edit isn't lost to a redirect. Google signs back in via
    /// its callback with no navigation; the dialog just closes and work resumes.
    /// </summary>
    private void OnSessionExpired() => _ = InvokeAsync(async () =>
    {
        if (_expiryDialogOpen)
        {
            return;
        }

        _expiryDialogOpen = true;
        try
        {
            var dialog = await Dialogs.ShowAsync<SessionExpiredDialog>(
                "Session expired",
                new DialogOptions { BackdropClick = false });
            await dialog.Result;
        }
        finally
        {
            _expiryDialogOpen = false;
        }
    });

    /// <summary>
    /// Signed in, but the API says this account can reach nothing: there is no
    /// dialog to offer and nothing to renew. Drop the credential and land back
    /// on sign-in with the unauthorized notice.
    /// </summary>
    private void OnAccessDenied() => _ = InvokeAsync(async () =>
    {
        if (_signingOut)
        {
            return;
        }

        _signingOut = true;
        await SignOutTo("signin?error=unauthorized");
    });

    public void Dispose()
    {
        SessionExpiry.Expired -= OnSessionExpired;
        Session.AccessDenied -= OnAccessDenied;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // The signed-in user's profile: their id drives presence self-exclusion,
        // and IsSuperAdmin gates the admin nav.
        if (AuthenticationStateTask is not null && Session.Current is null)
        {
            var state = await AuthenticationStateTask;
            if (state.User.Identity?.IsAuthenticated == true)
            {
                try
                {
                    await Session.LoadAsync();
                    StateHasChanged();
                }
                catch (ApiException)
                {
                    // Token rejected or user deprovisioned; the route guards
                    // bounce them to sign-in on the next navigation.
                }
            }
        }

        // The instance's theme package has gone missing. Told to the super admin
        // only: they are the one who can restore it or choose another, and for
        // everyone else it is an unactionable complaint about the app looking
        // slightly different. Everyone does get it in the browser console.
        if (Session.IsSuperAdmin && Theme.TryClaimFallbackNotice())
        {
            Snackbar.Add(
                $"{Theme.FallbackMessage} Choose a theme in Admin settings.",
                Severity.Warning,
                config => config.RequireInteraction = true);
        }
    }

    private Task SignOut() => SignOutTo("signin");

    /// <summary>Google has no logout redirect: drop the credential and go to the destination.</summary>
    private async Task SignOutTo(string destination)
    {
        Session.Clear();

        if (Config.IsGoogle)
        {
            await Google.SignOutAsync();
            // forceLoad: a client-side nav would keep the running app — and its cached
            // session/avatar — alive, so signing in as someone else would still show
            // the previous user. A full reload resets everything cleanly.
            Navigation.NavigateTo(destination, forceLoad: true);
            return;
        }

        Navigation.NavigateToLogout("authentication/logout", destination);
    }
}
