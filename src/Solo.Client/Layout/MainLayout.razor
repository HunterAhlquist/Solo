@inherits LayoutComponentBase
@implements IDisposable
@inject UserSession Session
@inject AppConfig Config
@inject GoogleIdentityService Google
@inject NavigationManager Navigation
@inject SessionExpiry SessionExpiry
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject ThemeState Theme
@inject Solo.Client.Extensions.ExtensionCatalog Extensions
@inject WorkspaceState Workspace

<SoloThemeProvider />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" CloseOnEscapeKey="true" MaxWidth="MaxWidth.Small" FullWidth="true" />
<MudSnackbarProvider />
@* Outside AuthorizeView, unlike the task drawer: a menu asked for and never
   drawn would leave its caller waiting for a choice that can't come. *@
<ContextMenuHost />

<MudLayout>
    @* Height comes from the theme's AppbarHeight (5em), so no Dense here. *@
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Toggle navigation" />
        <MudLink Href="" Underline="Underline.None" Color="Color.Inherit" Class="ml-2 app-brand">
            <MudText Typo="Typo.h5">@Config.SiteName</MudText>
        </MudLink>
        <MudSpacer />

        <AuthorizeView Context="auth">
            <Authorized>
                @* Extensions' app bar contributions — an inbox count, a running
                   timer — before core's own. Each failure costs an icon. *@
                @foreach (var contribution in AppBarExtensions)
                {
                    <ErrorBoundary @key="contribution">
                        <ChildContent>
                            <DynamicComponent Type="@contribution" />
                        </ChildContent>
                        <ErrorContent>
                            <MudTooltip Text="An extension couldn't draw its part of the app bar.">
                                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" />
                            </MudTooltip>
                        </ErrorContent>
                    </ErrorBoundary>
                }
                <ConnectionIndicator />
                @* MudMenu's built-in Icon activator (not ActivatorContent, which never
                   opens here). The SSO picture rides in as a circular SVG image; with
                   no picture it falls back to the default account glyph. *@
                <MudMenu Icon="@ProfileIcon" Color="Color.Inherit"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <MudText Typo="Typo.body2" Class="px-4 py-2">@auth.User.Identity?.Name</MudText>
                    <MudDivider />
                    <ColorSchemeMenu />
                    <MudDivider />
                    <MudMenuItem Icon="@Icons.Material.Filled.Devices" OnClick="@ShowDevicesAsync">Signed-in devices</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="@SignOut">Sign out</MudMenuItem>
                </MudMenu>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <AuthorizeView>
        <Authorized>
            @* Responsive, not Mini: a Mini drawer is icon-only and can't hold a tree. *@
            <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always"
                       Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md">
                <NavMenu />
            </MudDrawer>
            <TaskDrawerHost />
        </Authorized>
    </AuthorizeView>

    <MudMainContent Class="@(Workspace.Options.FillHeight ? "workspace-content" : null)">
        <MudContainer MaxWidth="@(Workspace.Options.FullWidth ? MaxWidth.False : MaxWidth.Large)" Class="@(Workspace.Options.FillHeight ? "workspace-container" : "pa-4")">
            <DayRollover>
                @Body
            </DayRollover>
        </MudContainer>

        @if (!Workspace.Options.FillHeight)
        {
            <footer class="app-footer">
                @* The one place that always says Solo: an instance with a name of
                   its own is still running it. *@
                <div class="app-footer__copyright">@(Config.HasOwnName
                        ? $"{Config.SiteName}, powered by Solo."
                        : "Solo, a simple project management app") -
                    <MudLink Target="_blank" Href="https://github.com/HunterAhlquist/Solo">View Source on Github</MudLink></div>
            </footer>
        }
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _workspaceActive;
    private bool _drawerBeforeWorkspace;
    private void OnWorkspaceChanged() => _ = InvokeAsync(() =>
    {
        if (Workspace.IsActive && !_workspaceActive)
        {
            _drawerBeforeWorkspace = _drawerOpen;
            if (Workspace.Options.CollapseNavigation)
            {
                _drawerOpen = false;
            }
        }
        else if (!Workspace.IsActive && _workspaceActive)
        {
            _drawerOpen = _drawerBeforeWorkspace;
        }
        _workspaceActive = Workspace.IsActive;
        StateHasChanged();
    });

    /// <summary>
    /// The menu's activator icon. MudMenu wraps <c>Icon</c> in an
    /// <c>&lt;svg viewBox="0 0 24 24"&gt;</c>, so the SSO picture goes in as a
    /// circular SVG <c>&lt;image&gt;</c>; without one, the default account glyph.
    /// </summary>
    private string ProfileIcon =>
        Session.Current is { AvatarUrl.Length: > 0 } user
            ? $"<image href=\"{ApiClient.AvatarUrl(user.Id)}\" x=\"0\" y=\"0\" width=\"24\" height=\"24\" " +
              "preserveAspectRatio=\"xMidYMid slice\" style=\"clip-path:circle(12px at 12px 12px)\" />"
            : Icons.Material.Filled.AccountCircle;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _expiryDialogOpen;
    private bool _signingOut;

    protected override void OnInitialized()
    {
        SessionExpiry.Expired += OnSessionExpired;
        Session.AccessDenied += OnAccessDenied;
        Extensions.Changed += OnExtensionsChanged;
        Workspace.Changed += OnWorkspaceChanged;
    }

    private IReadOnlyList<Type>? _appBarExtensions;

    private IReadOnlyList<Type> AppBarExtensions => _appBarExtensions ??=
        Solo.Client.Extensions.ContributedSections.Components<Solo.Shared.Extensibility.AppBarExtensionAttribute>(
            Extensions, a => a.Order);

    /// <summary>Extensions load after sign-in, after the layout first renders.</summary>
    private void OnExtensionsChanged()
    {
        _appBarExtensions = null;
        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Silent renewal failed or the API rejected our token: offer re-sign-in in
    /// place, so an open edit isn't lost to a redirect. Google signs back in via
    /// its callback with no navigation; the dialog just closes and work resumes.
    /// </summary>
    private void OnSessionExpired() => _ = InvokeAsync(async () =>
    {
        if (_expiryDialogOpen)
        {
            return;
        }

        _expiryDialogOpen = true;
        try
        {
            var dialog = await Dialogs.ShowAsync<SessionExpiredDialog>(
                "Session expired",
                new DialogOptions { BackdropClick = false });
            await dialog.Result;

            // An app that started on an expired session never got its profile
            // (the first load was refused), so the app bar kept the generic
            // icon until a reload. Signed in again, fetch it now.
            if (Session.Current is null)
            {
                try
                {
                    await Session.LoadAsync();
                    StateHasChanged();
                }
                catch (ApiException)
                {
                    // Still refused: the route guards take it from here.
                }
            }
        }
        finally
        {
            _expiryDialogOpen = false;
        }
    });

    /// <summary>
    /// Signed in, but the API says this account can reach nothing: there is no
    /// dialog to offer and nothing to renew. Drop the credential and land back
    /// on sign-in with the unauthorized notice.
    /// </summary>
    private void OnAccessDenied() => _ = InvokeAsync(async () =>
    {
        if (_signingOut)
        {
            return;
        }

        _signingOut = true;
        await SignOutTo("signin?error=unauthorized");
    });

    public void Dispose()
    {
        SessionExpiry.Expired -= OnSessionExpired;
        Session.AccessDenied -= OnAccessDenied;
        Extensions.Changed -= OnExtensionsChanged;
        Workspace.Changed -= OnWorkspaceChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (AuthenticationStateTask is not null &&
            (await AuthenticationStateTask).User.Identity?.IsAuthenticated == true)
        {
            // The signed-in user's profile: their id drives presence
            // self-exclusion, and IsSuperAdmin gates the admin nav.
            if (Session.Current is null)
            {
                try
                {
                    await Session.LoadAsync();
                    StateHasChanged();
                }
                catch (ApiException)
                {
                    // Token rejected or user deprovisioned; the route guards
                    // bounce them to sign-in on the next navigation.
                }
            }
        }

        // The instance's theme package has gone missing. Told to the super admin
        // only: they are the one who can restore it or choose another, and for
        // everyone else it is an unactionable complaint about the app looking
        // slightly different. Everyone does get it in the browser console.
        if (Session.IsSuperAdmin && Theme.TryClaimFallbackNotice())
        {
            Snackbar.Add(
                $"{Theme.FallbackMessage} Choose a theme in Admin settings.",
                Severity.Warning,
                config => config.RequireInteraction = true);
        }
    }

    private async Task ShowDevicesAsync() =>
        await Dialogs.ShowAsync<SignedInDevicesDialog>("Signed-in devices");

    private Task SignOut() => SignOutTo("signin");

    /// <summary>Google has no logout redirect: drop the credential and go to the destination.</summary>
    private async Task SignOutTo(string destination)
    {
        Session.Clear();

        if (Config.IsGoogle)
        {
            await Google.SignOutAsync();
            // forceLoad: a client-side nav would keep the running app — and its cached
            // session/avatar — alive, so signing in as someone else would still show
            // the previous user. A full reload resets everything cleanly.
            Navigation.NavigateTo(destination, forceLoad: true);
            return;
        }

        Navigation.NavigateToLogout("authentication/logout", destination);
    }
}
