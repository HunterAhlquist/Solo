@using System.Reflection
@implements IDisposable
@inject ProjectNavStore Nav
@inject DragBridge Drag
@inject UserSession Session
@inject ApiClient Api
@inject RecentProjectsStore Recent
@inject ProjectOrderStore ProjectOrder
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject Solo.Client.Extensions.ExtensionCatalog Extensions

@*
    The sidebar is the app's map: every project, and inside each one its open
    boards. Creating things happens where they live — "Add board" sits at the foot
    of a project's boards, "Add project" at the foot of the sidebar. A project's
    links come in labelled sections: Boards, then one per extension that
    contributes a [ProjectNavSection], each owning its own create action.
*@

<div class="nav-shell">
    <MudNavMenu Class="nav-shell__scroll">
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
            All projects
        </MudNavLink>

        <MudDivider Class="my-2" />

        @if (Nav.Projects.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="px-4 py-2">
                No projects yet.
            </MudText>
        }

        @* One drop zone for js/drag.js, holding every project group. A group is
           the drag item, but only its icon starts the drag — everything else in
           the header opens or expands the project. What rides under the pointer
           is the title row alone; the whole group, boards and all, would be a
           preview the size of the sidebar. *@
        <div data-drag-zone="projects" data-drag-group="project">
            @foreach (var project in OrderedProjects)
            {
                <div class="project-nav-group" @key="project.Id" data-drag-item="@project.Id"
                     data-drag-from=".project-nav__drag-handle"
                     data-drag-preview=".project-nav__title">
                    <MudNavGroup Title="@project.Name"
                                 HeaderClass="project-nav__header"
                                 Expanded="@_expanded.Contains(project.Id)"
                                 ExpandedChanged="@(expanded => OnExpandedAsync(project.Id, expanded))">
                        <TitleContent>
                            <span class="project-nav__title">
                                <span class="project-nav__drag-handle" data-drag-handle
                                      title="Drag to reorder projects"
                                      aria-label="@($"Drag to reorder {project.Name}")"
                                      @onclick:stopPropagation="true">
                                    <MudIcon Class="project-nav__entity-icon"
                                             Icon="@SoloIcons.Resolve(project.ImageId, project.Icon)" />
                                    <MudIcon Class="project-nav__drag-indicator"
                                             Icon="@Icons.Material.Filled.DragIndicator" />
                                </span>
                                <span class="project-nav__name">@project.Name</span>
                            </span>
                        </TitleContent>

                        <ChildContent>
                            @{
                                var boards = Nav.BoardsOf(project.Id);
                            }
                            @if (boards is null)
                            {
                                <div class="px-4 py-2">
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                </div>
                            }
                            else
                            {
                                <NavSectionHeader Title="Boards" />
                                @foreach (var board in boards)
                                {
                                    <MudNavLink Href="@BoardHref(project.Alias, board.Alias)"
                                                Match="NavLinkMatch.All"
                                                Icon="@SoloIcons.Resolve(board.ImageId, board.Icon)">
                                        @board.Name
                                    </MudNavLink>
                                }

                                @if (boards.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-4 py-1 d-block">
                                        No open boards.
                                    </MudText>
                                }

                                @if (ProjectNavStore.CanAddBoard(project))
                                {
                                    <MudNavLink Icon="@Icons.Material.Filled.Add" Class="nav-shell__muted"
                                                OnClick="@(() => AddBoardAsync(project))">
                                        Add board
                                    </MudNavLink>
                                }

                                @* Sections contributed by loaded extensions. Each is its own
                                   component under its own boundary, so one that throws costs
                                   a line of error text rather than the rest of the sidebar. *@
                                @foreach (var section in ProjectSections)
                                {
                                    <NavSectionHeader Title="@section.Title" />
                                    <ErrorBoundary @key="(project.Id, section.Component)">
                                        <ChildContent>
                                            <DynamicComponent Type="@section.Component"
                                                              Parameters="@SectionParameters(project)" />
                                        </ChildContent>
                                        <ErrorContent>
                                            <MudText Typo="Typo.caption" Color="Color.Error" Class="px-4 py-1 d-block">
                                                @section.Title couldn't load.
                                            </MudText>
                                        </ErrorContent>
                                    </ErrorBoundary>
                                }

                                <MudDivider DividerType="DividerType.Middle" Class="my-2" />

                                @* Open the project home for members, labels, closed boards. *@
                                <MudNavLink Href="@($"projects/{project.Alias}")" Match="NavLinkMatch.All"
                                            Class="nav-shell__muted" Icon="@Icons.Material.Filled.Tune">
                                    Project settings
                                </MudNavLink>

                                @* Extension pages. These come from the manifest, but only for
                                   extensions whose client assembly actually loaded — an entry
                                   whose route no assembly registered would land on the router's
                                   "that page doesn't exist", which reads as a bug rather than as
                                   a version mismatch. See ExtensionBootstrapper. *@
                                @foreach (var entry in ExtensionNav(project))
                                {
                                    <MudNavLink Href="@ExtensionHref(entry, project)" Match="NavLinkMatch.Prefix"
                                                Icon="@ExtensionIcon(entry)">
                                        @entry.Label
                                    </MudNavLink>
                                }
                            }
                        </ChildContent>
                    </MudNavGroup>
                </div>
            }
        </div>
    </MudNavMenu>

    @* Pinned to the foot of the drawer, below the scrolling tree. Add project
       stays above the divider that separates creation from instance pages. *@
    <div class="nav-shell__footer">
        @if (Session.IsSuperAdmin)
        {
            <MudNavMenu>
                @* Full text colour, like the project and board names: this is the
                   sidebar's own top-level action, not something hanging off one
                   project the way "Add board" does. *@
                <MudNavLink Icon="@Icons.Material.Filled.CreateNewFolder"
                            OnClick="@AddProjectAsync">
                    Add project
                </MudNavLink>
            </MudNavMenu>
        }

        <MudDivider />
        <MudNavMenu>
            @* Instance-level extension pages — a manifest nav entry whose route
               names no project. One entry each, rather than one per project, and
               like every extension entry it appears only when the assembly that
               registers its route actually loaded. *@
            @foreach (var entry in Extensions.InstanceNav)
            {
                <MudNavLink Href="@entry.Route.TrimStart('/')" Match="NavLinkMatch.Prefix"
                            Icon="@ExtensionIcon(entry)">
                    @entry.Label
                </MudNavLink>
            }

            @if (Session.IsSuperAdmin)
            {
                <MudNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
                    Admin settings
                </MudNavLink>
            }
        </MudNavMenu>
    </div>
</div>

@code {
    private readonly HashSet<Guid> _expanded = [];

    /// <summary>
    /// Extension entries this viewer may see on this project. The manifest's
    /// "requires" is checked against the same role the rest of the sidebar uses,
    /// so an extension cannot advertise a page the API would refuse.
    /// </summary>
    private IEnumerable<ClientExtensionNavDto> ExtensionNav(ProjectSummaryDto project) =>
        Extensions.ProjectNav.Where(entry => entry.Requires switch
        {
            "Owner" => project.IsOwner,
            "Write" => ProjectNavStore.CanAddBoard(project),
            _ => true,
        });

    private static string ExtensionHref(ClientExtensionNavDto entry, ProjectSummaryDto project) =>
        entry.Route.TrimStart('/')
            .Replace(Solo.Client.Extensions.ExtensionCatalog.ProjectAliasToken, project.Alias,
                StringComparison.OrdinalIgnoreCase);

    private static string ExtensionIcon(ClientExtensionNavDto entry) =>
        string.IsNullOrWhiteSpace(entry.Icon)
            ? Icons.Material.Filled.Extension
            : SoloIcons.Resolve(null, entry.Icon);

    private sealed record ProjectSection(string Title, Type Component);

    private IReadOnlyList<ProjectSection>? _sections;

    /// <summary>
    /// Reflected once per catalog change rather than per render: the sidebar
    /// re-renders on every navigation, and each project group would otherwise
    /// walk every loaded assembly's exported types again.
    /// </summary>
    private IReadOnlyList<ProjectSection> ProjectSections => _sections ??= Extensions.Loaded
        .SelectMany(e => e.Assembly.GetExportedTypes()
            .Where(t => !t.IsAbstract && typeof(IComponent).IsAssignableFrom(t))
            .Select(t => (e.Descriptor.Id, Type: t,
                Attribute: t.GetCustomAttribute<Solo.Shared.Extensibility.ProjectNavSectionAttribute>()))
            .Where(c => c.Attribute is not null))
        .OrderBy(c => c.Attribute!.Order)
        .ThenBy(c => c.Id, StringComparer.Ordinal)
        .Select(c => new ProjectSection(c.Attribute!.Title, c.Type))
        .ToList();

    private static IDictionary<string, object> SectionParameters(ProjectSummaryDto project) =>
        new Dictionary<string, object>
        {
            ["Project"] = project,
            ["CanWrite"] = ProjectNavStore.CanAddBoard(project),
        };

    private IReadOnlyList<Guid> _recent = [];
    private IReadOnlyList<Guid> _projectOrder = [];
    private bool _autoExpanded;

    protected override async Task OnInitializedAsync()
    {
        Nav.Changed += OnNavChanged;

        // Extension entries arrive after sign-in rather than at boot, so the
        // sidebar can well be on screen before the catalog has anything in it.
        Extensions.Changed += OnExtensionsChanged;

        // The sidebar renders for anyone signed in, but "Add project" is super-admin
        // only — so the session has to be here before the first paint.
        if (Session.Current is null)
        {
            try
            {
                await Session.LoadAsync();
            }
            catch (ApiException)
            {
                // The tree still lists whatever projects they can see.
            }
        }

        await Nav.EnsureProjectsAsync();
        ExpandProjectFromUrl();
    }

    /// <summary>
    /// Sidebar preferences live in localStorage, unreachable until the first
    /// render lands, so they're read here rather than in init.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Drag.RegisterAsync("project", OnProjectDropAsync);

            try
            {
                _recent = await Recent.GetAsync();
                _projectOrder = await ProjectOrder.GetAsync();
            }
            catch (JSException)
            {
                // Storage unavailable — keep the API order and no auto-expansion.
            }

            StateHasChanged();
        }

        await TryAutoExpandAsync();
    }

    /// <summary>
    /// Saved projects lead in their explicit order. New projects, which have no
    /// saved position yet, retain the API's alphabetical order at the end.
    /// </summary>
    private IReadOnlyList<ProjectSummaryDto> OrderedProjects
    {
        get
        {
            if (_projectOrder.Count == 0)
            {
                return Nav.Projects;
            }

            var projectsById = Nav.Projects.ToDictionary(project => project.Id);
            var ordered = _projectOrder
                .Where(projectsById.ContainsKey)
                .Select(id => projectsById[id])
                .ToList();
            var placed = ordered.Select(project => project.Id).ToHashSet();
            ordered.AddRange(Nav.Projects.Where(project => !placed.Contains(project.Id)));
            return ordered;
        }
    }

    /// <summary>
    /// The sidebar's order is this browser's alone — it lives in localStorage,
    /// not on the server, so a drop here rewrites the saved list and nothing more.
    /// The drop's index counts the <em>other</em> projects, so it is already the
    /// slot to insert into.
    /// </summary>
    private async Task OnProjectDropAsync(DragDrop drop)
    {
        var projects = OrderedProjects.ToList();
        var sourceIndex = projects.FindIndex(project => project.Id == drop.ItemGuid);
        if (sourceIndex < 0)
        {
            return;
        }

        var dragged = projects[sourceIndex];
        var others = projects.Where(project => project.Id != dragged.Id).ToList();
        var insertionIndex = Math.Clamp(drop.Index, 0, others.Count);
        if (insertionIndex == sourceIndex)
        {
            return;
        }

        others.Insert(insertionIndex, dragged);
        _projectOrder = others.Select(project => project.Id).ToList();
        StateHasChanged();

        try
        {
            await ProjectOrder.SetAsync(_projectOrder);
        }
        catch (JSException)
        {
            // Keep the in-memory order for this session if storage is unavailable.
        }
    }

    /// <summary>Unfold the last few opened projects — once, once both lists are ready.</summary>
    private async Task TryAutoExpandAsync()
    {
        if (_autoExpanded || _recent.Count == 0 || Nav.Projects.Count == 0)
        {
            return;
        }

        _autoExpanded = true;
        var toExpand = _recent
            .Where(id => Nav.Projects.Any(p => p.Id == id))
            .Take(RecentProjectsStore.AutoExpandCount)
            .ToList();
        foreach (var id in toExpand)
        {
            await OnExpandedAsync(id, true);
        }
    }

    private static string BoardHref(string projectAlias, string boardAlias) =>
        $"projects/{projectAlias}/boards/{boardAlias}";

    private void OnNavChanged() => InvokeAsync(StateHasChanged);

    private void OnExtensionsChanged()
    {
        _sections = null;
        OnNavChanged();
    }

    /// <summary>Deep-linking straight to a board should reveal it in the tree.</summary>
    private void ExpandProjectFromUrl()
    {
        // Routes carry the project's alias; the tree is keyed by id, so map it
        // through the (already loaded) project list.
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments is ["projects", var alias, ..] &&
            Nav.Projects.FirstOrDefault(p =>
                string.Equals(p.Alias, Uri.UnescapeDataString(alias), StringComparison.OrdinalIgnoreCase))
                is { } project)
        {
            _ = OnExpandedAsync(project.Id, true);
        }
    }

    /// <summary>Boards load on first expand, not on sign-in.</summary>
    private async Task OnExpandedAsync(Guid projectId, bool expanded)
    {
        if (!expanded)
        {
            _expanded.Remove(projectId);
            StateHasChanged();
            return;
        }

        _expanded.Add(projectId);
        StateHasChanged();
        await Nav.EnsureBoardsAsync(projectId);
    }

    private async Task AddProjectAsync()
    {
        var dialog = await Dialogs.ShowAsync<NameIconDialog>(
            "New project",
            new DialogParameters<NameIconDialog> { { d => d.SaveText, "Create" } });

        if (await dialog.Result is not { Canceled: false, Data: NameIconDialog.NameIcon created })
        {
            return;
        }

        try
        {
            var project = await Api.CreateProjectAsync(new CreateProjectRequest
            {
                Name = created.Name,
                Alias = created.Alias,
                Icon = created.Icon,
                ImageId = created.ImageId,
            });
            await Nav.RefreshProjectsAsync();
            Navigation.NavigateTo($"projects/{project.Alias}");
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't create the project.", Severity.Error);
        }
    }

    private async Task AddBoardAsync(ProjectSummaryDto project)
    {
        var dialog = await Dialogs.ShowAsync<NameIconDialog>(
            $"New board in {project.Name}",
            new DialogParameters<NameIconDialog> { { d => d.SaveText, "Create" } });

        if (await dialog.Result is not { Canceled: false, Data: NameIconDialog.NameIcon created })
        {
            return;
        }

        try
        {
            var board = await Api.CreateBoardAsync(project.Id,
                new CreateBoardRequest
                {
                    Name = created.Name,
                    Alias = created.Alias,
                    Icon = created.Icon,
                    ImageId = created.ImageId,
                });
            await Nav.RefreshBoardsAsync(project.Id);
            Navigation.NavigateTo(BoardHref(project.Alias, board.Alias));
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't create the board.", Severity.Error);
        }
    }

    public void Dispose()
    {
        Nav.Changed -= OnNavChanged;
        Extensions.Changed -= OnExtensionsChanged;
        Drag.Unregister("project", OnProjectDropAsync);
    }
}
