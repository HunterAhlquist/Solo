@implements IDisposable
@inject ProjectNavStore Nav
@inject UserSession Session
@inject ApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

@*
    The sidebar is the app's map: every project, and inside each one its open
    boards. Creating things happens where they live — "Add board" sits at the foot
    of a project's boards, "Add project" at the foot of the sidebar.
*@

<div class="nav-shell">
    <MudNavMenu Class="nav-shell__scroll">
        <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
            All projects
        </MudNavLink>

        <MudDivider Class="my-2" />

        @if (Nav.Projects.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="px-4 py-2">
                No projects yet.
            </MudText>
        }

        @foreach (var project in Nav.Projects)
        {
            <MudNavGroup Title="@project.Name"
                         Icon="@SoloIcons.Resolve(project.Icon)"
                         Expanded="@_expanded.Contains(project.Id)"
                         ExpandedChanged="@(expanded => OnExpandedAsync(project.Id, expanded))">

                @{
                    var boards = Nav.BoardsOf(project.Id);
                }
                @if (boards is null)
                {
                    <div class="px-4 py-2">
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    </div>
                }
                else
                {
                    @foreach (var board in boards)
                    {
                        <MudNavLink Href="@BoardHref(project.Id, board.Id)"
                                    Match="NavLinkMatch.All"
                                    Icon="@SoloIcons.Resolve(board.Icon)">
                            @board.Name
                        </MudNavLink>
                    }

                    @if (boards.Count == 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-4 py-1 d-block">
                            No open boards.
                        </MudText>
                    }

                    @* Open the project home for members, labels, closed boards. *@
                    <MudNavLink Href="@($"projects/{project.Id}")" Match="NavLinkMatch.All"
                                Icon="@Icons.Material.Filled.Tune">
                        Project settings
                    </MudNavLink>

                    @if (ProjectNavStore.CanAddBoard(project, Session.IsSuperAdmin))
                    {
                        <MudNavLink Icon="@Icons.Material.Filled.Add" Class="nav-shell__add"
                                    OnClick="@(() => AddBoardAsync(project))">
                            Add board
                        </MudNavLink>
                    }
                }
            </MudNavGroup>
        }
    </MudNavMenu>

    @* Pinned to the foot of the drawer, below the scrolling tree. *@
    <div class="nav-shell__footer">
        <MudDivider />
        <MudNavMenu>
            @if (Session.IsSuperAdmin)
            {
                <MudNavLink Icon="@Icons.Material.Filled.CreateNewFolder" Class="nav-shell__add"
                            OnClick="@AddProjectAsync">
                    Add project
                </MudNavLink>

                <MudNavLink Href="settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
                    Instance settings
                </MudNavLink>
            }
        </MudNavMenu>
    </div>
</div>

@code {
    private readonly HashSet<Guid> _expanded = [];

    protected override async Task OnInitializedAsync()
    {
        Nav.Changed += OnNavChanged;

        // The sidebar renders for anyone signed in, but "Add project" is super-admin
        // only — so the session has to be here before the first paint.
        if (Session.Current is null)
        {
            try
            {
                await Session.LoadAsync();
            }
            catch (ApiException)
            {
                // The tree still lists whatever projects they can see.
            }
        }

        await Nav.EnsureProjectsAsync();
        ExpandProjectFromUrl();
    }

    private static string BoardHref(Guid projectId, Guid boardId) =>
        $"projects/{projectId}/boards/{boardId}";

    private void OnNavChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Deep-linking straight to a board should reveal it in the tree.</summary>
    private void ExpandProjectFromUrl()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments is ["projects", var id, ..] && Guid.TryParse(id, out var projectId))
        {
            _ = OnExpandedAsync(projectId, true);
        }
    }

    /// <summary>Boards load on first expand, not on sign-in.</summary>
    private async Task OnExpandedAsync(Guid projectId, bool expanded)
    {
        if (!expanded)
        {
            _expanded.Remove(projectId);
            StateHasChanged();
            return;
        }

        _expanded.Add(projectId);
        StateHasChanged();
        await Nav.EnsureBoardsAsync(projectId);
    }

    private async Task AddProjectAsync()
    {
        var dialog = await Dialogs.ShowAsync<NameIconDialog>(
            "New project",
            new DialogParameters<NameIconDialog> { { d => d.SaveText, "Create" } });

        if (await dialog.Result is not { Canceled: false, Data: NameIconDialog.NameIcon created })
        {
            return;
        }

        try
        {
            var project = await Api.CreateProjectAsync(new CreateProjectRequest
            {
                Name = created.Name,
                Icon = created.Icon,
            });
            await Nav.RefreshProjectsAsync();
            Navigation.NavigateTo($"projects/{project.Id}");
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't create the project.", Severity.Error);
        }
    }

    private async Task AddBoardAsync(ProjectSummaryDto project)
    {
        var dialog = await Dialogs.ShowAsync<NameIconDialog>(
            $"New board in {project.Name}",
            new DialogParameters<NameIconDialog> { { d => d.SaveText, "Create" } });

        if (await dialog.Result is not { Canceled: false, Data: NameIconDialog.NameIcon created })
        {
            return;
        }

        try
        {
            var board = await Api.CreateBoardAsync(project.Id,
                new CreateBoardRequest { Name = created.Name, Icon = created.Icon });
            await Nav.RefreshBoardsAsync(project.Id);
            Navigation.NavigateTo(BoardHref(project.Id, board.Id));
        }
        catch (ApiException e)
        {
            Snackbar.Add(e.Detail ?? "Couldn't create the board.", Severity.Error);
        }
    }

    public void Dispose() => Nav.Changed -= OnNavChanged;
}
