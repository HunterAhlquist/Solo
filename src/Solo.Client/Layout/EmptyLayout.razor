@inherits LayoutComponentBase

@*
    Chrome-free layout for sign-in, the auth redirects, and the setup wizard —
    all of which run before there's a signed-in user to build chrome around.
*@
<MudThemeProvider Theme="@SoloTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider CloseButton="true" CloseOnEscapeKey="true" />
<MudSnackbarProvider />

<MudLayout>
    @* Desktop shell only (see "Desktop shell chrome" in app.css): with no app
       bar there is nothing to drag the frameless window by, so this fills the
       band MudBlazor already leaves clear at the top. Inert in a browser. *@
    <div class="solo-titlebar"></div>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>
