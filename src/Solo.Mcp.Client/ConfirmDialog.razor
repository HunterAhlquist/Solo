@*
    Yes/no for a destructive action. The host's own confirm dialog lives in
    Solo.Client, which an extension cannot reference, so this package brings its
    own — MudBlazor's dialog service is resolved from the host either way.
*@

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">@Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled"
                   OnClick="@(() => Dialog.Close(DialogResult.Ok(true)))">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public required string Message { get; set; }

    [Parameter]
    public string ConfirmText { get; set; } = "Confirm";
}
