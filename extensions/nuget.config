<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Where the extensions under this folder get the contract they compile
       against. NuGet finds this file by walking up from a solution, so it
       applies to every extension here and to nothing in src/.

       Until the public launch the HunterAhlquist.Solo.* packages exist only as
       what build/pack-contract.sh writes to artifacts/nuget, so that folder is
       their one source: run the script before the first restore, and again
       after changing the contract. The mapping also means a package of the same
       name on nuget.org can never stand in for the one built from src/. After
       the launch, listing the same pattern under nuget.org as well lets a
       published version satisfy a pin the local folder no longer holds. -->

  <packageSources>
    <clear />
    <add key="contract" value="../artifacts/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="contract">
      <package pattern="HunterAhlquist.Solo.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
