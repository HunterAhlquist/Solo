<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Where the extensions under this folder get the contract they compile
       against. NuGet finds this file by walking up from a solution, so it
       applies to every extension here and to nothing in src/.

       The HunterAhlquist.Solo.* packages are on nuget.org, but the folder
       build/pack-contract.sh writes, artifacts/nuget, is their one source
       here: run the script before the first restore, and again after changing
       the contract. The mapping means a published package of the same name can
       never stand in for the one built from src/. Listing the same pattern
       under nuget.org as well would let a published version satisfy a pin the
       local folder no longer holds. -->

  <packageSources>
    <clear />
    <add key="contract" value="../artifacts/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="contract">
      <package pattern="HunterAhlquist.Solo.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
