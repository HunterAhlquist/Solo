<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Design Docs extension's tests, against the real host: the package loaded,
       migrated and called over HTTP and SignalR, and its pages rendered under
       bUnit. Its internals are tested without a host in Solo.DesignDocs.Data.Tests.

       This is where the extension's build reaches into src/: for the host the
       package runs in, and for the harnesses core's own tests use. The
       extension projects themselves stay on the contract packages, kept private
       so this project sees only the host's Solo.Extensibility and Solo.Shared —
       the copies the package binds to once loaded. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.11.3" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Solo.Api.Testing" />
    <Using Include="Solo.Client.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Solo.Api\Solo.Api.csproj" />
    <ProjectReference Include="..\..\..\tests\Solo.Api.Testing\Solo.Api.Testing.csproj" />
    <ProjectReference Include="..\..\..\tests\Solo.Client.Testing\Solo.Client.Testing.csproj" />
    <!-- Built and staged, never referenced: a reference would load the server
         half into the default context, and the loader would never be exercised. -->
    <ProjectReference Include="..\Solo.DesignDocs\Solo.DesignDocs.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!-- Referenced: bUnit renders its components directly. The host never loads
         a client half itself, only serves it. -->
    <ProjectReference Include="..\Solo.DesignDocs.Client\Solo.DesignDocs.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The URL rule's shared table, also read by js/test/markdown.test.js. -->
    <None Include="..\Solo.DesignDocs.Client\js\test\fixtures\safe-urls.json" Link="fixtures\safe-urls.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Lay the package out under the test output as a release ships it — both
       halves plus content/ — so Extensions:DevelopmentDirectories can point at
       it, and the tests exercise the archive a release actually ships. -->
  <Target Name="StageDesignDocsExtension" AfterTargets="Build">
    <MSBuild Projects="..\Solo.DesignDocs\Solo.DesignDocs.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="DesignDocsAssembly" />
    </MSBuild>
    <MSBuild Projects="..\Solo.DesignDocs.Client\Solo.DesignDocs.Client.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="DesignDocsClientAssembly" />
    </MSBuild>
    <ItemGroup>
      <DesignDocsContent Include="..\Solo.DesignDocs\content\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DesignDocsAssembly)"
          DestinationFolder="$(OutDir)extension-fixtures\design-docs\server" />
    <Copy SourceFiles="@(DesignDocsClientAssembly)"
          DestinationFolder="$(OutDir)extension-fixtures\design-docs\client" />
    <Copy SourceFiles="@(DesignDocsContent)"
          DestinationFolder="$(OutDir)extension-fixtures\design-docs\content\%(RecursiveDir)" />
    <Copy SourceFiles="..\Solo.DesignDocs\extension.json"
          DestinationFolder="$(OutDir)extension-fixtures\design-docs" />
  </Target>

</Project>
