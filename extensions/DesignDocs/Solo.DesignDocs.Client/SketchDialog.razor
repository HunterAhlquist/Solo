@implements IAsyncDisposable
@inject ISoloClientApi HostApi
@inject ISoloLiveTopics Live
@inject IJSRuntime Js
@inject IDialogService Dialogs
<MudDialog Class="design-docs-sketch-dialog">
    <TitleContent>
        <div class="design-docs-sketch-title"><MudText Typo="Typo.h6">@Sketch.Name</MudText><DocPresenceStrip ProjectId="ProjectId" Entries="_presence" /><MudIconButton Class="mud-button-close" Icon="@Icons.Material.Filled.Close" OnClick="RequestClose" aria-label="Close" /></div>
    </TitleContent>
    <DialogContent>
        <SaveBeforeLeave @ref="_saveGuard" Save="SaveBeforeClose" ContentName="sketch" OnNavigating="CloseSaved" />
        <div class="design-docs-sketch-shell">
            <EditorSurface Ready="Mount" />
            <MudPaper Class="design-docs-sketch-palette design-docs-sketch-tool-palette" Elevation="4" role="toolbar" aria-label="Drawing tools">
                @foreach(var item in Tools) {
                    <MudTooltip Text="@item.Label" Placement="Placement.Right"><MudIconButton Icon="@item.Icon" Color="@(_tool==item.Id?Color.Primary:Color.Default)" Class="@(_tool==item.Id?"is-selected":null)" Disabled="@(!_writable)" OnClick="@(()=>SetTool(item.Id))" aria-label="@item.Label" aria-pressed="@(_tool==item.Id)" /></MudTooltip>
                }
                <MudDivider />
                @if(_supportsTouch){
                <MudTooltip Text="@(_touchDrawing?"Touch drawing on — tap to use one finger to pan":"Touch drawing off — one finger pans, Pencil draws")" Placement="Placement.Right"><MudIconButton Icon="@Icons.Material.Filled.TouchApp" Color="@(_touchDrawing?Color.Primary:Color.Default)" OnClick="ToggleTouchDrawing" aria-label="Draw with touch" aria-pressed="@(_touchDrawing.ToString().ToLowerInvariant())" /></MudTooltip>
                }
                <MudTooltip Text="Constrain shapes (or hold Shift)" Placement="Placement.Right"><MudIconButton Icon="@Icons.Material.Filled.AspectRatio" Color="@(_constrain?Color.Primary:Color.Default)" Disabled="@(!_writable)" OnClick="Constrain" aria-label="Constrain shapes" aria-pressed="@_constrain" /></MudTooltip>
                <MudTooltip Text="Page settings" Placement="Placement.Right"><MudIconButton Icon="@Icons.Material.Filled.Settings" Disabled="@(!_writable)" OnClick='@(()=>Command("settings"))' aria-label="Page settings" /></MudTooltip>
                <MudTooltip Text="Export PNG" Placement="Placement.Right"><MudIconButton Icon="@Icons.Material.Filled.Download" OnClick='@(()=>Command("export"))' aria-label="Export PNG" /></MudTooltip>
            </MudPaper>
            <MudPaper Class="design-docs-sketch-palette design-docs-sketch-ink-palette" Elevation="4" role="toolbar" aria-label="Ink and brush size">
                <div class="design-docs-swatches">
                    @foreach(var color in new[]{"theme","red","blue","green","purple"}) {
                        <MudTooltip Text="@(color=="theme"?"Theme ink":color)"><MudIconButton Icon="@Icons.Material.Filled.Circle" Style="@($"color:var(--design-docs-ink-{color})")" Class="@(_ink==color?"is-selected":null)" Disabled="@(!_writable)" OnClick="@(()=>SetInk(color))" aria-label="@(color=="theme"?"Theme ink":color+" ink")" aria-pressed="@(_ink==color)" /></MudTooltip>
                    }
                </div>
                <div class="design-docs-brushes">
                    @for(var index=0;index<5;index++) {
                        var level=index;
                        <MudTooltip Text="@($"Brush size {level+1}")"><MudIconButton Icon="@BrushIcon(level)" Class="@(_level==level?"is-selected":null)" Disabled="@(!_writable)" OnClick="@(()=>SetLevel(level))" aria-label="@($"Brush size {level+1}")" aria-pressed="@(_level==level)" /></MudTooltip>
                    }
                </div>
            </MudPaper>
            <MudPaper Class="design-docs-sketch-palette design-docs-sketch-history-palette" Elevation="4" role="toolbar" aria-label="Sketch history">
                <MudTooltip Text="Undo"><MudIconButton Icon="@Icons.Material.Filled.Undo" Disabled="@(!_writable)" OnClick='@(()=>Command("undo"))' aria-label="Undo" /></MudTooltip>
                <MudTooltip Text="Redo"><MudIconButton Icon="@Icons.Material.Filled.Redo" Disabled="@(!_writable)" OnClick='@(()=>Command("redo"))' aria-label="Redo" /></MudTooltip>
                <MudTooltip Text="Clear sketch"><MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Disabled="@(!_writable)" OnClick='@(()=>Command("clear"))' aria-label="Clear sketch" /></MudTooltip>
            </MudPaper>
            <MudPaper Class="design-docs-sketch-palette design-docs-sketch-zoom-palette" Elevation="4" role="toolbar" aria-label="View zoom">
                <MudTooltip Text="Zoom out"><MudIconButton Icon="@Icons.Material.Filled.ZoomOut" OnClick='@(()=>Command("zoomOut"))' aria-label="Zoom out" /></MudTooltip>
                <MudTooltip Text="Fit page"><MudIconButton Icon="@Icons.Material.Filled.FitScreen" OnClick='@(()=>Command("fit"))' aria-label="Fit page" /></MudTooltip>
                <MudTooltip Text="Zoom in"><MudIconButton Icon="@Icons.Material.Filled.ZoomIn" OnClick='@(()=>Command("zoomIn"))' aria-label="Zoom in" /></MudTooltip>
            </MudPaper>
        </div>
    </DialogContent>
</MudDialog>
@code{
    private ISoloClientApi Api=>OfflineApi.For(HostApi,Js);
    [CascadingParameter] private IMudDialogInstance Dialog {get;set;}=null!;
    [Parameter] public Guid ProjectId {get;set;}
    [Parameter] public Guid VaultId {get;set;}
    [Parameter,EditorRequired] public SketchDto Sketch {get;set;}=null!;
    [Parameter] public bool CanWrite {get;set;}
    private string _tool="pen",_ink="theme";private int _level;private bool _constrain,_writable,_touchDrawing,_supportsTouch;
    private SaveBeforeLeave? _saveGuard;
    private Task<bool> SaveBeforeClose()=>_sketch is null?Task.FromResult(true):_sketch.InvokeAsync<bool>("close",10000).AsTask();
    private async Task RequestClose(){if(_saveGuard is not null&&await _saveGuard.TryLeaveAsync())CloseSaved();}
    private void CloseSaved(){if(!_disposed)Dialog.Close();}
    [JSInvokable] public Task Close()=>RequestClose();
    private static readonly (string Id,string Label,string Icon)[] Tools=[("pen","Pen",Icons.Material.Filled.Edit),("eraser","Eraser",EraserIcon),("rectangle","Rectangle",Icons.Material.Filled.CropSquare),("ellipse","Ellipse",Icons.Material.Filled.RadioButtonUnchecked),("select","Box select",Icons.Material.Filled.SelectAll),("lasso","Lasso select",Icons.Material.Filled.Gesture),("text","Text",Icons.Material.Filled.TextFields)];
    // Material Symbols' ink_eraser uses a 960-unit view box; MudIcon uses 24.
    private const string EraserIcon="<g transform='scale(.025) translate(0 960)'><path d='M690-240h190v80H610l80-80Zm-500 80-85-85q-23-23-23.5-57t22.5-58l440-456q23-24 56.5-24t56.5 23l199 199q23 23 23 57t-23 57L520-160H190Zm296-80 314-322-198-198-442 456 64 64h262Zm-6-240Z' /></g>";
    private static string BrushIcon(int level)=>$"<circle cx='12' cy='12' r='{new[]{1,2,3,5,8}[level]}' />";
    private Task Command(string action,object? value=null)=>_sketch is null?Task.CompletedTask:_sketch.InvokeVoidAsync("command",action,value).AsTask();
    private async Task SetTool(string value){_tool=value;await Command("tool",value);}
    private async Task SetInk(string value){_ink=value;await Command("ink",value);}
    private async Task SetLevel(int value){_level=value;await Command("level",value);}
    private async Task ToggleTouchDrawing(){_touchDrawing=!_touchDrawing;await Command("touchDrawing",_touchDrawing);}
    private async Task Constrain(){_constrain=!_constrain;await Command("constrain",_constrain);}
    [JSInvokable] public Task Writable(bool value){_writable=CanWrite&&value;return InvokeAsync(StateHasChanged);}
    [JSInvokable] public async Task<SketchPageSettings?> PageSettings(SketchPageSettings settings){
        var dialog=await Dialogs.ShowAsync<SketchPageDialog>("Sketch page settings",new DialogParameters<SketchPageDialog>{{x=>x.Settings,settings}},new DialogOptions{CloseButton=true,MaxWidth=MaxWidth.ExtraSmall,FullWidth=true});
        return await dialog.Result is {Canceled:false,Data:SketchPageSettings result}?result:null;
    }
    private IReadOnlyList<TopicPresenceEntry> _presence=[];
    private IJSObjectReference? _sketch;private DotNetObjectReference<SketchDialog>? _reference;private IAsyncDisposable? _subscription,_vault;private bool _disposed;
    private async Task Mount(ElementReference root){
        var user=await Api.GetAsync<UserDto>("api/users/me");var slot=await Api.SendAsync<ColorDto>(HttpMethod.Post,$"api/ext/design-docs/projects/{ProjectId}/colors",new{});
        var api=new DesignDocsApi(Api);var module=await DesignDocsAssets.ModuleAsync(Js,api);_supportsTouch=await module.InvokeAsync<bool>("supportsTouch");await InvokeAsync(StateHasChanged);_reference=DotNetObjectReference.Create(this);
        _sketch=await module.InvokeAsync<IJSObjectReference>("mountSketch",root,_reference,new{canWrite=CanWrite,documentId=Sketch.Id,vaultId=VaultId,projectId=ProjectId,name=Sketch.Name,explosionUrl=api.Content("explosion.gif").ToString(),explosionSoundUrl=api.Content("explosion.wav").ToString(),
            meta=new{Sketch.PageSize,Sketch.Orientation,Sketch.Pattern},user=new{userId=user.Id,name=user.DisplayName??user.Email,avatarUrl=string.IsNullOrEmpty(user.AvatarUrl)?null:$"api/users/{user.Id}/avatar",color=DocPresenceColor.Value(slot.Slot)}});
        await _sketch.InvokeVoidAsync("connected",false);
        _subscription=await Live.SubscribeAsync(ProjectId,DocTopics.Doc(Sketch.Id),async m=>{if(_sketch is null||_disposed)return;if(m.Kind=="deleted"){await _sketch.InvokeVoidAsync("connected",false);return;}await _sketch.InvokeVoidAsync("receive",m.Kind,m.Data);},Presence);
        _vault=await Live.SubscribeAsync(ProjectId,DocTopics.Vault(VaultId),async m=>{if(m.Kind is "closed" or "deleted"&&_sketch is not null)await _sketch.InvokeVoidAsync("connected",false);});
        Live.ConnectionChanged+=Connection;if(Live.IsConnected)await Live.SetPresenceAsync(ProjectId,DocTopics.Doc(Sketch.Id),CanWrite?PresenceMode.Editing:PresenceMode.Viewing);await Connection();
    }
    private async Task Presence(IReadOnlyList<TopicPresenceEntry> people){
        if(_disposed)return;_presence=people;
        if(_sketch is not null)await _sketch.InvokeVoidAsync("presence",people);
        await InvokeAsync(()=>{StateHasChanged();Dialog.StateHasChanged();});
    }
    private Task Connection()=>_sketch is null?Task.CompletedTask:_sketch.InvokeVoidAsync("connected",Live.IsConnected).AsTask();
    [JSInvokable]public Task<LiveSendResult> Send(string kind,string data)=>Live.SendAsync(ProjectId,DocTopics.Doc(Sketch.Id),kind,data);
    [JSInvokable]public Task<bool> Confirm(string message)=>DocDialogs.Confirm(Dialogs,"Sketch",message,"Continue");
    [JSInvokable]public async Task Meta(string pageSize,string orientation,string pattern){
        var root=$"api/ext/design-docs/projects/{ProjectId}/vaults/{VaultId}/sketches";
        var current=(await Api.GetAsync<List<SketchDto>>(root)).Single(s=>s.Id==Sketch.Id);
        Sketch=await Api.SendAsync<SketchDto>(HttpMethod.Put,root+"/"+Sketch.Id,new SketchChange(current.Name,pageSize,orientation,pattern,current.Version));
    }
    public async ValueTask DisposeAsync(){_disposed=true;Live.ConnectionChanged-=Connection;if(_subscription is not null)await _subscription.DisposeAsync();if(_vault is not null)await _vault.DisposeAsync();if(_sketch is not null){try{await _sketch.InvokeVoidAsync("dispose");await _sketch.DisposeAsync();}catch(JSDisconnectedException){}}_reference?.Dispose();}
}
