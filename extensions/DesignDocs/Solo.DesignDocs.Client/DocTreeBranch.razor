@foreach(var entry in Entries.Where(e=>e.ParentId==ParentId).OrderByDescending(e=>e.IsFolder).ThenBy(e=>e.Name)) {
    <MudTreeViewItem T="Guid" Value="entry.Id" Text="entry.Name" Icon="@(entry.IsFolder?Icons.Material.Filled.Folder:Icons.Material.Filled.Description)" Expanded="@OpenFolders.Contains(entry.Id)" ExpandedChanged="@(value=>OnExpanded.InvokeAsync(new(entry.Id,value)))" CanExpand="@entry.IsFolder" Class="@(entry.IsFolder?null:"design-docs-leaf")" ChildContent="@Children(entry)">
        <BodyContent>
            <div class="design-docs-tree-row" data-doc-tree-id="@entry.Id" data-doc-drop="@(entry.IsFolder?entry.Id.ToString():entry.ParentId?.ToString()??"")" data-doc-name="@entry.Name"
                 @oncontextmenu:preventDefault="true" @oncontextmenu="@(e=>OnMenu.InvokeAsync(new(entry,e.ClientX,e.ClientY)))">
                <button type="button" class="design-docs-tree-name" title="@entry.Name" data-doc-drag="@(CanWrite?"":null)" draggable="false" @onclick:stopPropagation="true" @onclick="@(()=>Open(entry))"><span class="design-docs-tree-track"><span class="design-docs-tree-text">@entry.Name</span><span class="design-docs-tree-text design-docs-tree-copy" aria-hidden="true">@entry.Name</span></span></button>
                @if(CanWrite) { <MudIconButton Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" aria-label="@($"Actions for {entry.Name}")" OnClick="@(e=>OnMenu.InvokeAsync(new(entry,e.ClientX,e.ClientY)))" /> }
            </div>
        </BodyContent>
    </MudTreeViewItem>
}
@code {
    [Parameter] public IReadOnlyList<DocTreeEntry> Entries {get;set;}=[];
    [Parameter] public Guid? ParentId {get;set;}
    [Parameter] public bool CanWrite {get;set;}
    [Parameter] public IReadOnlySet<Guid> OpenFolders {get;set;}=new HashSet<Guid>();
    [Parameter] public EventCallback<DocTreeExpansion> OnExpanded {get;set;}
    [Parameter] public EventCallback<Guid> OnOpen {get;set;}
    [Parameter] public EventCallback<DocTreeMenu> OnMenu {get;set;}
    private RenderFragment? Children(DocTreeEntry entry) {
        if(!entry.IsFolder)return null;
        return @<text>
            @if(OpenFolders.Contains(entry.Id)) {
                <DocTreeBranch Entries="Entries" ParentId="entry.Id" CanWrite="CanWrite" OpenFolders="OpenFolders" OnExpanded="OnExpanded" OnOpen="OnOpen" OnMenu="OnMenu" />
            }
        </text>;
    }
    private Task Open(DocTreeEntry entry)=>entry.IsFolder?OnExpanded.InvokeAsync(new(entry.Id,!OpenFolders.Contains(entry.Id))):OnOpen.InvokeAsync(entry.Id);
}
