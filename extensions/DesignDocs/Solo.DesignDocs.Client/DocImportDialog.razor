<MudDialog>
    <DialogContent>
        <MudText>@Summary.Notes notes and @Summary.Images embedded images will be imported.</MudText>
        @if(Summary.Videos>0){<MudAlert Severity="Severity.Warning">Videos will be skipped. Their Markdown references are preserved, but video playback is not supported yet.</MudAlert>}
        @if(Summary.Conflicts.Count>0){<MudAlert Severity="Severity.Error">These paths already exist. Choose another design doc or resolve the names before importing.</MudAlert>@foreach(var path in Summary.Conflicts.Take(100)){<MudText Typo="Typo.body2">@path</MudText>}}
        @if(Summary.Skipped.Count>0){<MudText Class="mt-3">Skipped (@Summary.Skipped.Count):</MudText>@foreach(var item in Summary.Skipped.Take(100)){<MudText Typo="Typo.body2">@item</MudText>}@if(Summary.Skipped.Count>100){<MudText>Showing the first 100 skipped files.</MudText>}}
    </DialogContent>
    <DialogActions><MudButton OnClick="Dialog.Cancel">Cancel</MudButton><MudButton Color="Color.Primary" Disabled="@(Summary.Notes==0||Summary.Conflicts.Count>0)" OnClick="@(()=>Dialog.Close(DialogResult.Ok(true)))">Import</MudButton></DialogActions>
</MudDialog>
@code{
    [CascadingParameter]private IMudDialogInstance Dialog {get;set;}=null!;
    [Parameter,EditorRequired]public ImportSummary Summary {get;set;}=null!;
}
