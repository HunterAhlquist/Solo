<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The client half runs in browser-wasm, so it references Shared, never
       Extensibility. Its ES module and CSS ship in the package's content folder. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Version>1.0.2</Version>
    <!-- content/ (the stylesheet and the pointer-event module) ships in the
         package and is fetched from /api/extensions/design-docs/content/, not
         through the host's static-web-asset pipeline. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <!-- Pinned and kept private for the reasons in Solo.Mcp.csproj; Solo.Client
         supplies the host's copy to Solo.DesignDocs.Tests. -->
    <PackageReference Include="HunterAhlquist.Solo.Shared" Version="1.10.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Solo.DesignDocs\Contracts\*.cs" Link="Contracts\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
