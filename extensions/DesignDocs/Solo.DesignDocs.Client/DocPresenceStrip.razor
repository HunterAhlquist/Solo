@inject IJSRuntime Js
@inject ISoloClientApi HostApi
<span class="design-docs-presence" aria-label="People in this document">
    @foreach(var person in Entries.DistinctBy(p=>p.UserId)){
        <MudTooltip Text="@(person.DisplayName??"Someone")">
            <MudAvatar Size="Size.Small" Class="design-docs-presence-avatar" role="img" aria-label="@(person.DisplayName??"Someone")" tabindex="0" Style="@($"--design-docs-user-color:{Color(person.UserId)}")">
                @if(!_failed.Contains(person.UserId)){
                    <img src="@Api.Resolve($"api/users/{person.UserId}/avatar")" alt="@(person.DisplayName??"Someone")" @onerror="@(()=>_failed.Add(person.UserId))" />
                }else{@Initials(person.DisplayName)}
            </MudAvatar>
        </MudTooltip>
    }
</span>
@code{
    private ISoloClientApi Api=>OfflineApi.For(HostApi,Js);
    [Parameter] public Guid ProjectId {get;set;}
    [Parameter] public IReadOnlyList<TopicPresenceEntry> Entries {get;set;}=[];
    private Guid _project;
    private Dictionary<Guid,int> _colors=[];
    private readonly HashSet<Guid> _failed=[];
    protected override async Task OnParametersSetAsync(){
        if(_project!=ProjectId){_project=ProjectId;_colors.Clear();_failed.Clear();}
        if(Entries.Any(p=>!_colors.ContainsKey(p.UserId))){
            var project=ProjectId;
            try{
                var colors=await Api.GetAsync<List<ColorDto>>($"api/ext/design-docs/projects/{project}/colors");
                if(project==ProjectId)_colors=colors.ToDictionary(p=>p.UserId,p=>p.Slot);
            }catch(SoloApiException){ /* Presence remains visible while the server reconnects. */ }
        }
    }
    private string Color(Guid user)=>_colors.TryGetValue(user,out var slot)?DocPresenceColor.Value(slot):"var(--mud-palette-text-secondary)";
    private static string Initials(string? name){var words=(name??"?").Split(' ',StringSplitOptions.RemoveEmptyEntries);return words.Length>1?$"{words[0][0]}{words[^1][0]}".ToUpperInvariant():words.FirstOrDefault()?[..1].ToUpperInvariant()??"?";}
}
