@page "/docs/{ProjectAlias}"
@page "/docs/note/{RouteNoteKey}"
@page "/docs/{ProjectAlias}/{VaultId:guid}"
@attribute [Authorize]
@implements IAsyncDisposable
@inject ISoloClientApi Api
@inject ISoloLiveTopics Live
@inject ISoloContextMenu Menus
@inject NavigationManager Navigation
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject ISoloWorkspace Workspace
<PageTitle>@(_tree?.Vault.Name ?? "Design Docs")</PageTitle>
@if(_error is not null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
else if(_project is null) { <MudProgressLinear Indeterminate="true" /> }
else if(VaultId==Guid.Empty) {
    <MudText Typo="Typo.h4">Design Docs</MudText>
    <VaultList Project="_project" />
} else if(_tree is not null&&_preferencesLoaded) {
    <div class="design-docs-page" style="@($"--design-docs-font-scale:{_fontScale}%;--design-docs-scale:{(_fontScale/100d).ToString(System.Globalization.CultureInfo.InvariantCulture)};{(_marginWidth<0?"":$"--design-docs-margin:{_marginWidth}cqw;")}")">
    <div class="design-docs-heading">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" OnClick="@(()=>_treeOpen=!_treeOpen)" aria-label="Toggle note tree" />
        <MudText Typo="Typo.h5">@_tree.Vault.Name</MudText>
        @if(_tree.Vault.IsClosed) { <MudChip T="string" Size="Size.Small">Closed · read-only</MudChip> }
        <MudSpacer />
        <MudMenu Label="@($"{_fontScale}%")" StartIcon="@Icons.Material.Filled.FormatSize" aria-label="Editor font size">
            @foreach(var scale in new[]{75,90,100,110,125,150,175,200}) {
                <MudMenuItem OnClick="@(()=>SetFontScale(scale))" Icon="@(scale==_fontScale?Icons.Material.Filled.Check:null)">@($"{scale}%")</MudMenuItem>
            }
        </MudMenu>
        <MudMenu Label="@($"Margins: {MarginLabel}")" StartIcon="@Icons.Material.Filled.SpaceBar" aria-label="Editor margin width">
            @foreach(var width in new[]{-1,0,5,10,15,20}) {
                <MudMenuItem OnClick="@(()=>SetMarginWidth(width))" Icon="@(width==_marginWidth?Icons.Material.Filled.Check:null)">@(width<0?"Auto":$"{width}%")</MudMenuItem>
            }
        </MudMenu>
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" aria-label="Design doc actions">
            <MudMenuItem Icon="@Icons.Material.Filled.Download" OnClick="@(()=>_transfer!.Export())">Export zip</MudMenuItem>
            @if(_canManage) {
                <MudMenuItem OnClick="RenameVault">Rename</MudMenuItem>
                <MudMenuItem OnClick="ToggleClosed">@(_tree.Vault.IsClosed?"Reopen":"Close")</MudMenuItem>
                @if(_tree.Vault.IsClosed) { <MudMenuItem OnClick="DeleteVault">Delete</MudMenuItem> }
            }
        </MudMenu>
    </div>
    <VaultTransfer @ref="_transfer" @key="VaultId" ProjectId="_project.Id" Tree="_tree" />
    <div class="design-docs-workspace">
        @if(_treeOpen) { <button class="design-docs-tree-backdrop" aria-label="Close note tree" @onclick="@(()=>_treeOpen=false)"></button> }
        <aside class="@($"design-docs-tree {(_treeOpen?"is-open":"")}")" aria-label="Notes">
            <div class="design-docs-tree-tools">
                @if(CanEdit) {
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.NoteAdd" OnClick="@(()=>Add(false,null))">Note</MudButton>
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="@(()=>Add(true,null))">Folder</MudButton>
                }
            </div>
            <DocHierarchy @key="VaultId" Entries="Entries" CanWrite="CanEdit" SelectedNoteId="Selected?.Id" OpenFolders="_openFolders" OnExpanded="SetExpanded" OnOpen="Open" OnMenu="Context" OnMove="Drop" OnToggleAll="ToggleFolders" />
            @if(_tree.Notes.Count==0) { <MudText Typo="Typo.body2" Class="pa-3">No notes yet.</MudText> }
        </aside>
        <main class="design-docs-note">
            @if(Selected is {} note) {
                <MudText Typo="Typo.h4">@note.Name</MudText>
                @if(note.LastEditedAt is {} edited) { <MudText Typo="Typo.caption" Class="d-block">Last edited by @Author(note.LastEditedBy) · @edited.ToLocalTime().ToString("g")</MudText> }
                <NoteEditor @key="note.Id" ProjectId="_project.Id" Note="note" CanWrite="CanEdit" />
            } else { <MudText Class="pa-6" Color="Color.Secondary">Choose a note from the tree.</MudText> }
        </main>
    </div>
    </div>
} else { <MudProgressLinear Indeterminate="true" /> }
@code {
    [Parameter] public string? RouteNoteKey {get;set;}
    private Guid? _routeNoteId;private long _routeGeneration;
    [Parameter] public string ProjectAlias {get;set;}="";
    [Parameter] public Guid VaultId {get;set;}
    [SupplyParameterFromQuery(Name="note")] public string? NoteKey {get;set;}
    private Guid? NoteId=>_routeNoteId??(NoteAddress.TryDecode(NoteKey,out var id)?id:null);
    private readonly Dictionary<Guid,string> _authors=[];
    private string Author(Guid? id)=>id.HasValue&&_authors.TryGetValue(id.Value,out var name)?name:"Former member";
    private ProjectSummaryDto? _project;private TreeDto? _tree;private string? _error,_loaded;
    private IDisposable? _workspace;
    private IJSObjectReference? _preferences;private HashSet<Guid> _openFolders=[];private Guid? _rememberedNote;private int _fontScale=100,_marginWidth=-1;private bool _preferencesLoaded;private long _loadGeneration;
    private string MarginLabel=>_marginWidth<0?"Auto":$"{_marginWidth}%";
    private bool _canManage,_disposed;private bool _treeOpen=true;private IAsyncDisposable? _subscription;
    private bool CanEdit=>_project is not null&&(_project.IsOwner||_project.Role==ProjectRole.ReadWrite)&&_tree?.Vault.IsClosed==false;
    private VaultTransfer? _transfer;
    private string Root=>$"api/ext/design-docs/projects/{_project!.Id}/vaults";
    private string Path=>$"{Root}/{VaultId}";
    private NoteDto? Selected=>_routeNoteId.HasValue||!string.IsNullOrEmpty(NoteKey)?_tree?.Notes.FirstOrDefault(n=>n.Id==NoteId):_tree?.Notes.FirstOrDefault(n=>n.Id==_rememberedNote)??_tree?.Notes.FirstOrDefault();
    private IReadOnlyList<DocTreeEntry> Entries=>_tree is null?[]:_tree.Folders.Select(f=>new DocTreeEntry(f.Id,true,f.ParentId,f.Name,f.Version))
        .Concat(_tree.Notes.Select(n=>new DocTreeEntry(n.Id,false,n.FolderId,n.Name,n.Version))).ToList();
    protected override async Task OnParametersSetAsync() {
        var routeGeneration=++_routeGeneration;_routeNoteId=null;
        if(RouteNoteKey is not null){
            if(!NoteAddress.TryDecode(RouteNoteKey,out var id)){_error="Note not found or unavailable.";return;}
            if(RouteNoteKey!=NoteAddress.Encode(id)){Navigation.NavigateTo(NoteAddress.Url(id)+new Uri(Navigation.Uri).Fragment,replace:true);return;}
            try{
                var located=await Api.GetAsync<LocateDto>($"api/ext/design-docs/notes/{id}/locate");
                if(routeGeneration!=_routeGeneration||_disposed)return;
                ProjectAlias=located.ProjectAlias;VaultId=located.VaultId;_routeNoteId=located.NoteId;_error=null;
            }catch(SoloApiException){if(routeGeneration==_routeGeneration)_error="Note not found or unavailable.";return;}
        }

        var key=$"{ProjectAlias}/{VaultId}";if(_loaded==key){if(_preferencesLoaded)await RememberNote();return;}_loaded=key;
        var generation=++_loadGeneration;var vaultId=VaultId;var alias=ProjectAlias;_preferencesLoaded=false;
        var previous=_subscription;_subscription=null;if(previous is not null)await previous.DisposeAsync();
        if(generation!=_loadGeneration||_disposed)return;
        _tree=null;_project=null;_error=null;
        if(vaultId!=Guid.Empty)_workspace??=Workspace.Enter(new(FullWidth:true,FillHeight:true,CollapseNavigation:true));
        else {_workspace?.Dispose();_workspace=null;}
        try {
            var project=(await Api.GetAsync<List<ProjectSummaryDto>>("api/projects")).FirstOrDefault(p=>string.Equals(p.Alias,alias,StringComparison.OrdinalIgnoreCase));
            if(generation!=_loadGeneration||_disposed)return;
            if(project is null){_error="Project not found.";return;}
            var user=await Api.GetAsync<UserDto>("api/users/me");
            var details=await Api.GetAsync<ProjectDto>($"api/projects/{project.Id}");
            await DesignDocsAssets.EnsureStylesAsync(Js,new DesignDocsApi(Api));
            if(generation!=_loadGeneration||_disposed)return;
            _project=project;_canManage=user.IsSuperAdmin;
            _authors.Clear();foreach(var member in details.Members)if(member.UserId is Guid userId)_authors[userId]=member.DisplayName??member.Email;
            if(vaultId!=Guid.Empty) {
                var tree=await Api.GetAsync<TreeDto>($"api/ext/design-docs/projects/{project.Id}/vaults/{vaultId}");
                var module=await DesignDocsAssets.ModuleAsync(Js,new(Api));
                var preferences=await module.InvokeAsync<VaultViewPreferences>("loadVaultPreferences",vaultId.ToString());
                if(generation!=_loadGeneration||_disposed)return;
                _preferences=module;_tree=tree;_openFolders=preferences.OpenFolders.ToHashSet();_rememberedNote=preferences.NoteId;_fontScale=preferences.FontScale;_marginWidth=preferences.MarginWidth;
                // Theme/auth rerenders can arrive while JS is loading. They must never persist defaults.
                _preferencesLoaded=true;
                DesignDocsNavEvents.Activate(_project.Id,VaultId);
                if(NoteId.HasValue&&await module.InvokeAsync<bool>("isNarrowWorkspace"))_treeOpen=false;
                await RememberNote();
                if(generation!=_loadGeneration||_disposed)return;
                var subscription=await Live.SubscribeAsync(project.Id,DocTopics.Vault(vaultId),m=>InvokeAsync(async()=>{
                    if(_disposed||generation!=_loadGeneration)return;if(m.Kind=="deleted"){Navigation.NavigateTo($"/docs/{alias}");return;}
                    await Load();StateHasChanged();
                }));
                if(generation!=_loadGeneration||_disposed)await subscription.DisposeAsync();else _subscription=subscription;
            }
        }catch(SoloApiException e){if(generation==_loadGeneration&&!_disposed)_error=e.Message;}
    }
    private async Task Load(){
        if(_disposed)return;var generation=_loadGeneration;var path=Path;
        try{var tree=await Api.GetAsync<TreeDto>(path);if(generation==_loadGeneration&&!_disposed){_tree=tree;_error=null;}}
        catch(SoloApiException e){if(generation==_loadGeneration&&!_disposed)_error=e.Message;}
    }
    private Task SavePreferences()=>!_preferencesLoaded||_preferences is null?Task.CompletedTask:_preferences.InvokeVoidAsync("saveVaultPreferences",VaultId.ToString(),new VaultViewPreferences(_openFolders.Order().ToArray(),_rememberedNote,_fontScale,_marginWidth)).AsTask();
    private async Task RememberNote(){if(Selected is {} note&&note.Id!=_rememberedNote){_rememberedNote=note.Id;await SavePreferences();}}
    private async Task ToggleFolders(){
        var folders=_tree!.Folders;
        if(folders.Any(f=>!_openFolders.Contains(f.Id)))_openFolders=folders.Select(f=>f.Id).ToHashSet();
        else{
            _openFolders.Clear();
            for(var parent=Selected?.FolderId;parent.HasValue;parent=folders.FirstOrDefault(f=>f.Id==parent)?.ParentId)_openFolders.Add(parent.Value);
        }
        await SavePreferences();
    }
    private async Task SetExpanded(DocTreeExpansion change){if(change.Expanded)_openFolders.Add(change.Id);else _openFolders.Remove(change.Id);await SavePreferences();}
    private async Task SetFontScale(int scale){_fontScale=scale;await SavePreferences();}
    private async Task SetMarginWidth(int width){_marginWidth=width;await SavePreferences();}
    private async Task Open(Guid id){_rememberedNote=id;await SavePreferences();var module=await DesignDocsAssets.ModuleAsync(Js,new(Api));if(await module.InvokeAsync<bool>("isNarrowWorkspace"))_treeOpen=false;Navigation.NavigateTo(NoteAddress.Url(id));}
    private async Task Run(Func<Task> action){try{await action();await Load();}catch(SoloApiException e){Snackbar.Add(e.Message,Severity.Error);await Load();}}
    private async Task Add(bool folder,Guid? parent) {
        var name=await DocDialogs.Name(Dialogs,folder?"New folder":"New note");if(name is null)return;
        await Run(async()=>{
            if(folder)await Api.SendAsync(HttpMethod.Post,Path+"/folders",new ItemChange(name,parent));
            else {var n=await Api.SendAsync<NoteDto>(HttpMethod.Post,Path+"/notes",new ItemChange(name,parent));await Open(n.Id);}
        });
    }
    private async Task Context(DocTreeMenu menu) {
        if(!CanEdit)return;var e=menu.Entry;
        var items=new List<ContextMenuItem>{new("rename","Rename"),new("delete","Delete"){Danger=true}};
        if(e.IsFolder){items.Insert(0,new("note","New note"));items.Insert(1,new("folder","New folder"));}
        var selected=await Menus.ShowAsync(menu.X,menu.Y,items);
        if(selected=="note"||selected=="folder"){await Add(selected=="folder",e.Id);return;}
        if(selected=="rename") {
            var name=await DocDialogs.Name(Dialogs,"Rename",e.Name);if(name is null||name==e.Name)return;
            if(!e.IsFolder) {
                var impact=await Api.GetAsync<RenameImpactDto>($"{Path}/notes/{e.Id}/rename-impact");
                if(impact.References>0&&!await DocDialogs.Confirm(Dialogs,"Links keep their old path",$"{impact.References} notes may link to this name. Renaming leaves those wiki links unresolved.","Rename"))return;
            }
            await Move(e,e.ParentId,name);DocLinkLabels.Invalidate(Api);
        } else if(selected=="delete"&&await DocDialogs.Confirm(Dialogs,"Delete "+e.Name,e.IsFolder?"Delete this folder and all of its notes and sketches?":"Delete this note and its sketches?")) {
            await Run(()=>Api.SendAsync(HttpMethod.Delete,$"{Path}/{(e.IsFolder?"folders":"notes")}/{e.Id}?version={e.Version}"));
        }
    }
    private Task Move(DocTreeEntry e,Guid? parent,string? name=null)=>Run(()=>Api.SendAsync(HttpMethod.Put,$"{Path}/{(e.IsFolder?"folders":"notes")}/{e.Id}",new ItemChange(name??e.Name,parent,e.Version)));
    private async Task Drop(DocTreeDrop drop){var entry=Entries.FirstOrDefault(e=>e.Id==drop.Id);if(entry is not null&&CanEdit&&entry.ParentId!=drop.ParentId&&entry.Id!=drop.ParentId)await Move(entry,drop.ParentId);}
    private async Task RenameVault(){var name=await DocDialogs.Name(Dialogs,"Rename design doc",_tree!.Vault.Name);if(name is not null)await ChangeVault(name,_tree.Vault.IsClosed);}
    private Task ToggleClosed()=>ChangeVault(_tree!.Vault.Name,!_tree.Vault.IsClosed);
    private Task ChangeVault(string name,bool closed)=>Run(async()=>{await Api.SendAsync(HttpMethod.Put,Path,new VaultChange(name,closed,_tree!.Vault.Version));DesignDocsNavEvents.Raise(_project!.Id);});
    private async Task DeleteVault(){if(!await DocDialogs.Confirm(Dialogs,"Delete design doc","Permanently delete every note, image and sketch in this closed design doc?"))return;
        try{await Api.SendAsync(HttpMethod.Delete,Path+"?version="+_tree!.Vault.Version);DesignDocsNavEvents.Raise(_project!.Id);Navigation.NavigateTo($"/docs/{ProjectAlias}");}catch(SoloApiException e){Snackbar.Add(e.Message,Severity.Error);}}
    public async ValueTask DisposeAsync(){_disposed=true;_loadGeneration++;_workspace?.Dispose();if(_subscription is not null)await _subscription.DisposeAsync();}
}
