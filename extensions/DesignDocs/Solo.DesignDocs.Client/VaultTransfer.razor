@implements IAsyncDisposable
@inject ISoloClientApi HostApi
@inject IJSRuntime Js
@inject ISnackbar Snackbar
<div class="design-docs-transfer">
    @if(_busy){<MudProgressCircular Indeterminate="true" Size="Size.Small" /><MudButton OnClick="Cancel">Cancel</MudButton>}
    <MudText Typo="Typo.caption" role="status">@_progress</MudText>
</div>
@code {
    private ISoloClientApi Api=>OfflineApi.For(HostApi,Js);
    [Parameter]public Guid ProjectId {get;set;}
    [Parameter,EditorRequired]public TreeDto Tree {get;set;}=null!;
    private VaultTransferSession? _session;private bool _busy;private string _progress="";
    public async Task Export(){
        if(_busy)return;
        _busy=true;
        try {
            if(_session is not null)await _session.DisposeAsync();
            _session=new(Api,Js,ProjectId,Tree.Vault.Name,text=>InvokeAsync(()=>{_progress=text;StateHasChanged();}));
            await _session.ExportAsync(Tree);_progress="Export ready.";
        }catch(OperationCanceledException){_progress="Export canceled.";}
        catch(Exception e)when(e is SoloApiException or JSException or HttpRequestException){Snackbar.Add(e.Message,Severity.Error);_progress="Export stopped.";}
        finally{_busy=false;}
    }
    private void Cancel()=>_session?.Cancel();
    public async ValueTask DisposeAsync(){if(_session is not null)await _session.DisposeAsync();}
}
