@implements IAsyncDisposable
@inject ISoloClientApi HostApi
@inject IJSRuntime Js
<div @ref="_root" class="design-docs-hierarchy">
    <div data-doc-drop="" class="design-docs-root pa-2"><span>Vault root</span><MudSpacer /><MudIconButton Icon="@(AllExpanded?Icons.Material.Filled.UnfoldLess:Icons.Material.Filled.UnfoldMore)" Size="Size.Small" aria-label="@(AllExpanded?"Collapse all folders":"Expand all folders")" OnClick="@(()=>OnToggleAll.InvokeAsync())" /></div>
    <MudTreeView T="Guid" Dense="true">
        <DocTreeBranch Entries="Entries" CanWrite="CanWrite" SelectedNoteId="SelectedNoteId" OpenFolders="OpenFolders" OnExpanded="OnExpanded" OnOpen="OnOpen" OnMenu="OnMenu" />
    </MudTreeView>
</div>
@code {
    private ISoloClientApi Api=>OfflineApi.For(HostApi,Js);
    [Parameter] public IReadOnlyList<DocTreeEntry> Entries {get;set;}=[];
    [Parameter] public bool CanWrite {get;set;}
    [Parameter] public Guid? SelectedNoteId {get;set;}
    [Parameter] public IReadOnlySet<Guid> OpenFolders {get;set;}=new HashSet<Guid>();
    [Parameter] public EventCallback<DocTreeExpansion> OnExpanded {get;set;}
    [Parameter] public EventCallback<Guid> OnOpen {get;set;}
    [Parameter] public EventCallback<DocTreeMenu> OnMenu {get;set;}
    [Parameter] public EventCallback OnToggleAll {get;set;}
    private bool AllExpanded=>Entries.Where(e=>e.IsFolder).All(e=>OpenFolders.Contains(e.Id));
    [Parameter] public EventCallback<DocTreeDrop> OnMove {get;set;}
    private ElementReference _root;private IJSObjectReference? _tree;private DotNetObjectReference<DocHierarchy>? _reference;
    protected override async Task OnAfterRenderAsync(bool firstRender){
        if(firstRender){var module=await DesignDocsAssets.ModuleAsync(Js,new(Api));_reference=DotNetObjectReference.Create(this);_tree=await module.InvokeAsync<IJSObjectReference>("mountTree",_root,_reference);}
    }
    [JSInvokable] public Task Move(string id,string? parent)=>CanWrite&&Guid.TryParse(id,out var item)?OnMove.InvokeAsync(new(item,Guid.TryParse(parent,out var target)?target:null)):Task.CompletedTask;
    public async ValueTask DisposeAsync(){if(_tree is not null){try{await _tree.InvokeVoidAsync("dispose");await _tree.DisposeAsync();}catch(JSDisconnectedException){}}_reference?.Dispose();}
}
