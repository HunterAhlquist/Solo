@implements IAsyncDisposable
@inject ISoloClientApi HostApi
@inject ISoloLiveTopics Live
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject ISoloTaskPicker TaskPicker
@inject ISoloTaskDrawer TaskDrawer
@inject ISoloContextMenu Menus
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
<SaveBeforeLeave Save="SaveBeforeNavigation" ContentName="note" />
<header class="design-docs-note-header">
<div class="design-docs-note-details">
    <MudText Typo="Typo.h4">@Note.Name</MudText>
    @if(Note.LastEditedAt is {} edited){<MudText Typo="Typo.caption" Class="d-block">Last edited by @Author · @edited.ToLocalTime().ToString("g")</MudText>}
    <div class="design-docs-note-status">
    @if(_status.Contains("read-only",StringComparison.OrdinalIgnoreCase)){
        <MudAlert Severity="@(_status.StartsWith("Offline",StringComparison.Ordinal)?Severity.Warning:Severity.Info)" Dense="true">@_status</MudAlert>
    }else{<MudText Typo="Typo.caption" role="status">@_status</MudText>}
    </div>
</div>
<DocPresenceStrip ProjectId="ProjectId" Entries="_presence" />
</header>
<div class="design-docs-note-body">
@if(CanWrite){<MudPaper Class="design-docs-note-palette" Elevation="4" role="toolbar" aria-orientation="vertical" aria-label="Insert into note" aria-keyshortcuts="Alt+Insert">
    <MudTooltip Text="Link a task"><MudIconButton Disabled="_leaving" Icon="@Icons.Material.Filled.AddLink" OnClick="InsertTask" aria-label="Link a task" /></MudTooltip>
    <MudTooltip Text="New sketch"><MudIconButton Disabled="_leaving" Icon="@Icons.Material.Filled.Draw" OnClick="NewSketch" aria-label="New sketch" /></MudTooltip>
    <MudTooltip Text="Add image"><MudIconButton Disabled="_leaving" Icon="@Icons.Material.Filled.AddPhotoAlternate" OnClick="AddImage" aria-label="Add image" /></MudTooltip>
    <MudTooltip Text="Attachments"><MudIconButton Disabled="_leaving" Icon="@Icons.Material.Filled.PermMedia" OnClick="OpenAttachments" aria-label="Attachments" /></MudTooltip>
</MudPaper>}
<EditorSurface Ready="Mount" />
</div>
@code {
    private ISoloClientApi Api=>OfflineApi.For(HostApi,Js);
    [Parameter] public Guid ProjectId {get;set;}
    [Parameter,EditorRequired] public NoteDto Note {get;set;}=null!;
    [Parameter] public string Author {get;set;}="";
    [Parameter] public bool CanWrite {get;set;}
    [Parameter] public EventCallback OnReady {get;set;}
    private bool _ready;
    [JSInvokable] public async Task Ready(){if(_ready||_disposed)return;_ready=true;await OnReady.InvokeAsync();}
    private ElementReference _root;private IJSObjectReference? _editor;private DotNetObjectReference<NoteEditor>? _reference;
    private IAsyncDisposable? _subscription, _vaultSubscription;private string _status="Connecting…";private bool _disposed;
    private IReadOnlyList<TopicPresenceEntry> _presence=[];
    private bool? _lastWrite;
    protected override async Task OnParametersSetAsync(){if(_lastWrite!=CanWrite&&_editor is not null)await _editor.InvokeVoidAsync("permissions",CanWrite);_lastWrite=CanWrite;}
    private string Topic=>DocTopics.Doc(Note.Id);
    private async Task Mount(ElementReference root){_root=root;
        try {
            var user=await Api.GetAsync<UserDto>("api/users/me");
            var slot=await Api.SendAsync<ColorDto>(HttpMethod.Post,$"api/ext/design-docs/projects/{ProjectId}/colors",new{});
            var color=DocPresenceColor.Value(slot.Slot);
            var module=await DesignDocsAssets.ModuleAsync(Js,new DesignDocsApi(Api));_reference=DotNetObjectReference.Create(this);
            _editor=await module.InvokeAsync<IJSObjectReference>("mountEditor",_root,_reference,new{canWrite=CanWrite,documentId=Note.Id,vaultId=Note.VaultId,projectId=ProjectId,icons=new{close=Icons.Material.Filled.Close,previous=Icons.Material.Filled.ChevronLeft,next=Icons.Material.Filled.ChevronRight,edit=Icons.Material.Filled.Edit,remove=Icons.Material.Filled.Delete,download=Icons.Material.Filled.Download,replace=Icons.Material.Filled.FindReplace,owner=Icons.Material.Filled.OpenInNew},fragment=new Uri(Navigation.Uri).Fragment,user=new{userId=user.Id,name=user.DisplayName??user.Email,avatarUrl=string.IsNullOrEmpty(user.AvatarUrl)?null:$"api/users/{user.Id}/avatar",color,colorLight=DocPresenceColor.Value(slot.Slot,true)}});
            await _editor.InvokeVoidAsync("connected",false);
            _subscription=await Live.SubscribeAsync(ProjectId,Topic,async m=>{
                if(_editor is null||_disposed)return;
                if(m.Kind is "deleted" or "closed"){await _editor.InvokeVoidAsync("connected",false);await Status("Content unavailable · read-only");return;}
                await _editor.InvokeVoidAsync("receive",m.Kind,m.Data);
            },async people=>{_presence=people;if(_editor is not null)await _editor.InvokeVoidAsync("presence",people);await InvokeAsync(StateHasChanged);});
            _vaultSubscription=await Live.SubscribeAsync(ProjectId,DocTopics.Vault(Note.VaultId),async m=>{
                if(_editor is null||_disposed)return;
                if(m.Kind=="image")await _editor.InvokeVoidAsync("imagesChanged");
                if(m.Kind=="sketch"&&System.Text.Json.JsonSerializer.Deserialize<SketchPreviewChange>(m.Data??"{}",new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)) is {} change&&change.NoteId==Note.Id){
                    _sketchRefreshes.Add(change.Name);_sketchRefreshes.Add(change.Path[..^7]);
                    if(change.PreviousName is {} old){_sketchRefreshes.Add(old);_sketchRefreshes.Add(AttachmentPaths.ForNote(Note.Id,old+".sketch")[..^7]);}
                    _refreshTask??=RefreshSketches();
                }else if(m.Kind=="sketch"&&System.Text.Json.JsonSerializer.Deserialize<SketchPreviewChange>(m.Data??"{}",new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)) is {} other){
                    // Another note's sketch is embedded here only by its full path.
                    _sketchRefreshes.Add(other.Path[..^7]);
                    if(other.PreviousName is {} old)_sketchRefreshes.Add(AttachmentPaths.ForNote(other.NoteId,old+".sketch")[..^7]);
                    _refreshTask??=RefreshSketches();
                }
            });
            Live.ConnectionChanged+=Connection;if(Live.IsConnected)await Live.SetPresenceAsync(ProjectId,Topic,PresenceMode.Viewing);await Connection();
        }catch(Exception e){await Status(e.Message);await Ready();}
    }
    private bool _leaving;
    private async Task<bool> SaveBeforeNavigation(){
        if(_editor is null)return true;
        _leaving=true;await InvokeAsync(StateHasChanged);
        try{await _editor.InvokeVoidAsync("suspend",true);return await _editor.InvokeAsync<bool>("waitForSave",10000);}
        finally{_leaving=false;if(!_disposed&&_editor is not null){await _editor.InvokeVoidAsync("suspend",_sketchOpen);await InvokeAsync(StateHasChanged);}}
    }
    private readonly HashSet<string> _sketchRefreshes=[];
    private readonly CancellationTokenSource _refreshStop=new();private Task? _refreshTask;
    private async Task RefreshSketches(){
        try{while(_sketchRefreshes.Count>0){
            await Task.Delay(200,_refreshStop.Token);var names=_sketchRefreshes.ToArray();_sketchRefreshes.Clear();
            if(_editor is not null&&!_disposed)await _editor.InvokeVoidAsync("refreshSketches",new object[]{names});
        }}catch(OperationCanceledException)when(_refreshStop.IsCancellationRequested){}finally{_refreshTask=null;}
    }
    private async Task Connection(){if(_editor is null||_disposed)return;await _editor.InvokeVoidAsync("connected",Live.IsConnected);if(Live.IsConnected)await _editor.InvokeVoidAsync("sketchesChanged");}
    [JSInvokable] public Task<Solo.Shared.Hubs.LiveSendResult> Send(string kind,string data)=>Live.SendAsync(ProjectId,Topic,kind,data);
    [JSInvokable] public void Notice(string value)=>Snackbar.Add(value,Severity.Info);
    [JSInvokable] public Task<string?> ConfirmRemoveAttachment(string path,bool sketch)=>CanWrite
        ?DocDialogs.RemoveAttachment(Dialogs,AttachmentPaths.FileName(path),sketch)
        :Task.FromResult<string?>(null);
    // The id is the attachment the viewer loaded and showed when the person chose to delete it.
    // A path is never resolved again here: if that attachment is gone, a fallback match could be
    // another note's file of the same name. The embed is removed afterwards, so a refusal leaves
    // the note unchanged.
    [JSInvokable] public async Task<bool> DeleteAttachment(string path,bool sketch,string? id){
        if(!CanWrite)return false;
        if(!Guid.TryParse(id,out var target)){await Status("This attachment hasn’t loaded, so it can’t be deleted. Remove it from the note instead.");return false;}
        try{
            if(sketch){
                var found=(await Api.GetAsync<List<SketchDto>>(SketchRoot)).SingleOrDefault(s=>s.Id==target);
                if(found is null){await Status("This sketch was already deleted.");return false;}
                await Api.SendAsync(HttpMethod.Delete,$"{SketchRoot}/{found.Id}?version={found.Version}");
            }else{
                var found=(await Api.GetAsync<List<ImageDto>>(ImageRoot)).SingleOrDefault(i=>i.Id==target);
                if(found is null){await Status("This image was already deleted.");return false;}
                await Api.SendAsync(HttpMethod.Delete,$"{ImageRoot}/{found.Id}?version={found.Version}");
            }
            return true;
        }catch(SoloApiException e){await Status(e.StatusCode==HttpStatusCode.NotFound?"This attachment was already deleted.":e.Message);return false;}
    }
    private string VaultRoot=>$"api/ext/design-docs/projects/{ProjectId}/vaults/{Note.VaultId}";
    private async Task OpenAttachments(){
        if(_editor is null)return;
        try{
            var list=await Api.GetAsync<AttachmentListDto>(VaultRoot+"/attachments");var tree=await Api.GetAsync<TreeDto>(VaultRoot);
            // The open note's own embeds come from the editor, which is ahead of its saved copy.
            var live=await _editor.InvokeAsync<string[]>("embedTargets");
            var dialog=await Dialogs.ShowAsync<AttachmentsDialog>("Attachments",new DialogParameters<AttachmentsDialog>{
                {x=>x.Items,AttachmentCatalog.Build(list,tree,Note.Id,live)},{x=>x.NoteId,Note.Id},{x=>x.CanWrite,CanWrite},{x=>x.Delete,DeleteListed}},
                new DialogOptions{MaxWidth=MaxWidth.Small,FullWidth=true,CloseButton=true});
            if(await dialog.Result is not {Canceled:false,Data:AttachmentsDialog.Choice choice}||_editor is null||_disposed)return;
            var path=choice.Item.Path;
            switch(choice.Action){
                case "insert":await _editor.InvokeVoidAsync("insert",$"![[{path}]]");break;
                case "view":await _editor.InvokeVoidAsync("view",path,choice.Item.Sketch);break;
                case "edit":await OpenSketch(path[..^7]);break;
                case "replace":await _editor.InvokeVoidAsync("replaceImage",path);break;
            }
        }catch(SoloApiException e){await Status(e.Message);}
    }
    private async Task<bool> DeleteListed(AttachmentItem item){
        var others=item.EmbeddedIn.Count(n=>n!=Note.Id);
        var where=item.EmbeddedIn.Count==0?"It isn’t embedded in any note.":
            (item.EmbeddedIn.Contains(Note.Id)?"Its embeds in this note are removed. ":"")+(others>0?$"{others} other {(others==1?"note shows":"notes show")} it as unavailable.":"");
        if(!await DocDialogs.Confirm(Dialogs,item.Sketch?"Delete sketch":"Delete image",
            $"Delete “{item.Name}” permanently? It is deleted from the vault and cannot be recovered. {where}".TrimEnd(),"Delete permanently"))return false;
        if(!await DeleteAttachment(item.Path,item.Sketch,item.Id.ToString()))return false;
        if(_editor is not null&&!_disposed){
            if(item.Targets.Count>0)await _editor.InvokeVoidAsync("removeEmbeds",item.Targets);
            await _editor.InvokeVoidAsync("forget",item.Path);
        }
        return true;
    }
    // The viewer offers a way to the note an attachment was created in, when that isn't this note.
    [JSInvokable] public async Task<object?> AttachmentOwner(string path,bool sketch,string? id){
        if(!Guid.TryParse(id,out var target))return null;
        Guid? owner=sketch?(await Api.GetAsync<List<SketchDto>>(SketchRoot)).SingleOrDefault(s=>s.Id==target)?.NoteId
            :(await Api.GetAsync<List<ImageDto>>(ImageRoot)).SingleOrDefault(i=>i.Id==target) is {} image?AttachmentPaths.Owner(image.Path):null;
        if(owner is not {} note||note==Note.Id)return null;
        var found=(await Api.GetAsync<TreeDto>(VaultRoot)).Notes.SingleOrDefault(n=>n.Id==note);
        return found is null?null:new{url=NoteAddress.Url(found.Id),name=found.Name};
    }
    [JSInvokable] public void OpenNote(string url){if(NoteAddress.TryReadUrl(url,out _))Navigation.NavigateTo(url);}
    [JSInvokable] public Task<string?> SpellingMenu(string[] suggestions,double x,double y)
    {
        if(!CanWrite)return Task.FromResult<string?>(null);
        var items=new List<ContextMenuItem>{new("heading","English spelling"){Disabled=true}};
        items.AddRange(suggestions.Select((word,index)=>new ContextMenuItem(index.ToString(),word)));
        items.Add(new("ignore","Ignore for now"){SeparatorBefore=true});
        return Menus.ShowAsync(x,y,items);
    }
    [JSInvokable] public Task Status(string value){_status=value;return InvokeAsync(StateHasChanged);}
    [JSInvokable] public Task Focus(bool focused)=>!Live.IsConnected?Task.CompletedTask:Live.SetPresenceAsync(ProjectId,Topic,focused&&CanWrite?PresenceMode.Editing:PresenceMode.Viewing);
    [JSInvokable] public async Task Copy(string markdown,string seq,HeadingDto[] headings){try{await Api.SendAsync(HttpMethod.Put,$"api/ext/design-docs/projects/{ProjectId}/vaults/{Note.VaultId}/notes/{Note.Id}/copy",new CopyRequest(markdown,headings,seq));}catch(SoloApiException e){await Status(e.Message);}}
    private Task AddImage()=>_editor is null?Task.CompletedTask:_editor.InvokeVoidAsync("chooseImage").AsTask();
    private async Task InsertTask(){
        var task=await TaskPicker.PickAsync(ProjectId,new TaskPickerOptions{IncludeFinished=true,IncludeClosedBoards=true});if(task is null||_editor is null)return;
        var info=await TaskInfo(task.Id.ToString());await _editor.InvokeVoidAsync("insert",$"[{info.Serial}](/docs/task/{task.Id:N})");
    }
    public sealed record TaskLabel(string Serial,string Name);
    [JSInvokable] public async Task<TaskLabel> TaskInfo(string value){
        var id=Guid.Parse(value);
        var task=await Api.GetAsync<TaskDto>($"api/tasks/{id}");var board=await Api.GetAsync<BoardDto>($"api/boards/{task.BoardId}");
        var project=(await Api.GetAsync<List<ProjectSummaryDto>>("api/projects")).First(p=>p.Id==board.ProjectId);
        return new(Aliases.Serial(project.Alias,board.Alias,task.Number),task.Name);
    }
    [JSInvokable] public Task OpenTask(string value)=>TaskDrawer.OpenAsync(Guid.Parse(value));
    private string SketchRoot=>$"api/ext/design-docs/projects/{ProjectId}/vaults/{Note.VaultId}/sketches";
    private string ImageRoot=>$"api/ext/design-docs/projects/{ProjectId}/vaults/{Note.VaultId}/images";
    private bool PendingAttachment(string path,Guid id)=>path.StartsWith(AttachmentPaths.ForNote(Note.Id,id+"/"),StringComparison.Ordinal)||path.StartsWith($"offline/{id}/",StringComparison.Ordinal);
    private bool MatchesSketch(SketchDto sketch,string name)=>AttachmentCatalog.MatchesSketch(sketch,name,Note.Id);
    private async Task<ImageDto> FindImage(string path){
        var images=await Api.GetAsync<List<ImageDto>>(ImageRoot);
        var exact=images.FirstOrDefault(i=>i.Path==path)??images.FirstOrDefault(i=>PendingAttachment(path,i.Id));if(exact is not null)return exact;
        var tree=await Api.GetAsync<TreeDto>($"api/ext/design-docs/projects/{ProjectId}/vaults/{Note.VaultId}");
        var parts=new List<string>{Note.Name+".md"};
        for(var parent=Note.FolderId;parent.HasValue;){var folder=tree.Folders.Single(f=>f.Id==parent);parts.Insert(0,folder.Name);parent=folder.ParentId;}
        var resolved=VaultPaths.ResolveImage(images.Select(i=>i.Path).ToArray(),path,string.Join('/',parts));
        return images.SingleOrDefault(i=>i.Path==resolved)??throw new InvalidOperationException("Image not found or ambiguous.");
    }
    [JSInvokable] public async Task<object> Image(string path){var image=await FindImage(path);var bytes=await Api.GetBytesAsync(ImageRoot+"/"+image.Id);return new{image.Id,base64=Convert.ToBase64String(bytes.Content),image.ContentType,image.Version};}
    [JSInvokable] public async Task<string> UploadImage(byte[] bytes,string contentType,string path,bool replace){
        if(replace){var image=await FindImage(path);await Api.SendBytesAsync<ImageDto>(HttpMethod.Put,ImageRoot+"/"+image.Id+"?version="+image.Version,bytes,contentType);}
        else return (await Api.SendBytesAsync<ImageDto>(HttpMethod.Post,ImageRoot+"/notes/"+Note.Id+"?path="+Uri.EscapeDataString(path),bytes,contentType)).Path;
        return path;
    }
    [JSInvokable] public async Task<bool> ImageMenu(string path,double x,double y)=>CanWrite&&await Menus.ShowAsync(x,y,[new("replace","Replace image")])=="replace";
    private async Task NewSketch(){var name=await DocDialogs.Name(Dialogs,"New sketch");if(name is null||_editor is null)return;
        try{var sketch=await Api.SendAsync<SketchDto>(HttpMethod.Post,$"api/ext/design-docs/projects/{ProjectId}/vaults/{Note.VaultId}/sketches/notes/{Note.Id}",new NameRequest(name));
            await _editor.InvokeVoidAsync("insert",$"![[{sketch.Path}]]");await OpenSketch(sketch.Path[..^7]);
        }catch(SoloApiException e){await Status(e.Message);}}
    private bool _sketchOpen;
    [JSInvokable]public async Task OpenSketch(string name){
        if(_sketchOpen||_editor is null)return;_sketchOpen=true;
        try{var sketches=await Api.GetAsync<List<SketchDto>>($"api/ext/design-docs/projects/{ProjectId}/vaults/{Note.VaultId}/sketches");
            var sketch=sketches.SingleOrDefault(s=>MatchesSketch(s,name));if(sketch is null){await Status("Sketch not found in this note.");return;}
            await _editor.InvokeVoidAsync("suspend",true);
            var dialog=await Dialogs.ShowAsync<SketchDialog>(sketch.Name,new DialogParameters<SketchDialog>{{x=>x.ProjectId,ProjectId},{x=>x.VaultId,Note.VaultId},{x=>x.Sketch,sketch},{x=>x.CanWrite,CanWrite}},new DialogOptions{FullScreen=true,CloseButton=false,CloseOnEscapeKey=false,BackdropClick=false});
            await dialog.Result;if(_editor is not null&&!_disposed)await _editor.InvokeVoidAsync("refreshSketches",new object[]{new[]{sketch.Name,sketch.Path[..^7]}});
        }catch(SoloApiException e){await Status(e.Message);}
        finally{_sketchOpen=false;if(_editor is not null&&!_disposed)await _editor.InvokeVoidAsync("suspend",false);}}
    [JSInvokable]public async Task<object?> ResolveWiki(string target){
        var tree=await Api.GetAsync<TreeDto>($"api/ext/design-docs/projects/{ProjectId}/vaults/{Note.VaultId}");
        string FolderPath(Guid? id){if(id is null)return "";var f=tree.Folders.Single(x=>x.Id==id);return FolderPath(f.ParentId)+f.Name+"/";}
        string Canonical(string value){var parts=new List<string>();foreach(var part in value.Replace('\\','/').Split('/')){if(part is "" or ".")continue;if(part==".."){if(parts.Count==0)return "";parts.RemoveAt(parts.Count-1);}else parts.Add(part);}return string.Join('/',parts);}
        if(string.IsNullOrEmpty(target))return new{url=NoteAddress.Url(Note.Id),headings=tree.Notes.Single(n=>n.Id==Note.Id).Headings};
        var path=Uri.UnescapeDataString(target);if(!path.EndsWith(".md",StringComparison.OrdinalIgnoreCase))path+=".md";
        var exact=Canonical(path);var relative=Canonical(FolderPath(Note.FolderId)+path);
        var note=tree.Notes.FirstOrDefault(n=>FolderPath(n.FolderId)+n.Name+".md"==exact)??tree.Notes.FirstOrDefault(n=>FolderPath(n.FolderId)+n.Name+".md"==relative);
        if(note is null){var matches=tree.Notes.Where(n=>n.Name+".md"==path.Split('/').Last()).ToList();if(matches.Count==1)note=matches[0];}
        return note is null?null:new{url=NoteAddress.Url(note.Id),note.Headings};
    }
    [JSInvokable]public async Task<object?> SketchPreview(string name){
        var sketches=await Api.GetAsync<List<SketchDto>>($"api/ext/design-docs/projects/{ProjectId}/vaults/{Note.VaultId}/sketches");var sketch=sketches.SingleOrDefault(s=>MatchesSketch(s,name));if(sketch is null)return null;
        var path=$"api/ext/design-docs/projects/{ProjectId}/documents/{sketch.Id}";
        var state=await Api.GetAsync<System.Text.Json.JsonElement>(path);
        var updates=state.GetProperty("updates").EnumerateArray().Select(u=>u.GetProperty("data").GetString()).ToList();
        if(Live.IsConnected&&sketch.Version!=0){
            try{
                // Merge fresh server state with local pending edits in the preview's Y.Doc.
                var fresh=await HostApi.GetAsync<System.Text.Json.JsonElement>(path);
                updates.AddRange(fresh.GetProperty("updates").EnumerateArray().Select(u=>u.GetProperty("data").GetString()));
            }catch(HttpRequestException){}catch(SoloApiException e)when(e.StatusCode is HttpStatusCode.BadGateway or HttpStatusCode.ServiceUnavailable or HttpStatusCode.GatewayTimeout){}
        }
        return new{sketch,updates};
    }
    public async ValueTask DisposeAsync(){_disposed=true;_refreshStop.Cancel();if(_refreshTask is not null)await _refreshTask;_refreshStop.Dispose();Live.ConnectionChanged-=Connection;if(_subscription is not null)await _subscription.DisposeAsync();if(_vaultSubscription is not null)await _vaultSubscription.DisposeAsync();if(_editor is not null){try{await _editor.InvokeVoidAsync("dispose");await _editor.DisposeAsync();}catch(JSDisconnectedException){}}_reference?.Dispose();}
}
