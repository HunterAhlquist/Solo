<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Roadmaps extension's server half: roadmaps, their entries and the
       timeline settings, in its own ext_roadmap schema. Built the way Solo.Mcp is —
       it references the contract package and nothing from src/, reads core only
       through ISoloQuery, and never writes a core row. Task dates are set by the
       client half through core's own schedule endpoint.

       Remove the package and the instance loses roadmaps and nothing else; the
       schema is then reported as data without a package and can be purged.

       Versioned independently of the app — build/pack-roadmap-extension.sh stamps
       this version into the package filename and checks it against extension.json. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Version>1.8.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned and kept private for the reasons in Solo.Mcp.csproj. The host's
         copy reaches Solo.Roadmap.Tests through Solo.Api; Solo.Roadmap.Data.Tests,
         which has no host, references the package itself. -->
    <PackageReference Include="HunterAhlquist.Solo.Extensibility" Version="1.11.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Migrations are scaffolded at build time by the extension author, exactly
         as core's are; the host only applies them. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
