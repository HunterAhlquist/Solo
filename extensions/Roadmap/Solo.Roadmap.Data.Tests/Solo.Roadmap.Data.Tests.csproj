<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Roadmaps extension's own tests: its context against a real Postgres,
       and the pure functions (ranking, the stripe anchor). References the
       server half directly — unlike Solo.Roadmap.Tests, which loads the package
       the way a deployment does — because these test its internals, not its
       loading. No host is involved, so nothing here comes from src/: the
       contract arrives as the package, the same one the server half builds
       against. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Solo.Roadmap keeps its own reference private, so this one is explicit. -->
    <PackageReference Include="HunterAhlquist.Solo.Extensibility" Version="1.10.0" />
    <ProjectReference Include="..\Solo.Roadmap\Solo.Roadmap.csproj" />
  </ItemGroup>

</Project>
