@page "/projects/{ProjectAlias}/roadmaps/{RoadmapId:guid}"
@implements IAsyncDisposable

@*
    A roadmap: its tasks as bars on a day grid that scrolls sideways between the
    instance's bounds, in rows in the roadmap's own order — a row holds as many
    tasks as fit on it without overlapping. Writers add a task or a milestone by
    right-clicking any day no bar covers, drag a bar up or down onto another row
    or between two, or sideways to move its dates, drag its edges to reschedule it,
    and select several bars (a box dragged around them, or Cmd/Ctrl-click) to
    take them off together from the bar menu; everyone can open a task in the
    board's drawer by clicking its bar. The menus are the host's, so the
    desktop app shows native ones. Missed deadlines flash, and are listed under
    the grid. Milestones are dotted lines with a flag in the month band, which
    writers drag to move and click to edit; one due this sprint flashes.
    Everyone else's changes arrive live, and whoever else has it open shows in
    the header.
*@

<PageTitle>@(_timeline?.Title ?? "Roadmap") · Solo</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Warning">@_error</MudAlert>
}
else if (_timeline is null || _project is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    var drawn = Layout();
    <div class="roadmap-page">
        <div class="roadmap-header">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small"
                           Href="@($"projects/{_project.Alias}")" aria-label="Back to project" />
            <MudIcon Icon="@Icons.Material.Filled.Timeline" Color="Color.Primary" />
            <MudText Typo="Typo.h1" Class="roadmap-header__title">@_timeline.Title</MudText>
            @if (_present.Count > 0)
            {
                <span class="roadmap-presence">
                    @foreach (var person in _present.Take(MaxPresent))
                    {
                        <MemberAvatar @key="person.UserId" Member="@PresentMember(person)" AvatarUrl="@Api.Avatar"
                                      Tooltip="@DescribePresence(person)"
                                      Class="@(person.Mode == PresenceMode.Editing ? "roadmap-presence--editing" : null)" />
                    }
                    @if (_present.Count > MaxPresent)
                    {
                        <MudAvatar Size="Size.Small" Class="roadmap-avatar">+@(_present.Count - MaxPresent)</MudAvatar>
                    }
                </span>
            }
            <MudSpacer />
            @if (CanWrite)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => PickAsync(_today))">
                    Add task
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Flag" OnClick="@(() => AddMilestoneAsync(_today))">
                    Add milestone
                </MudButton>
            }
            @if (CanWrite || _canDelete)
            {
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" aria-label="Roadmap actions"
                         AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    @if (CanWrite)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@RenameAsync">Rename</MudMenuItem>
                    }
                    @if (_canDelete)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@DeleteAsync">
                            Delete
                        </MudMenuItem>
                    }
                </MudMenu>
            }
        </div>

        <div class="roadmap-timeline" @ref="_scroller"
             style="--roadmap-day-width:@(DayWidth)px;--roadmap-row-height:@(RowHeight)px">
            <div class="roadmap-canvas" style="width:@(_window.Days * DayWidth)px">
                <div class="roadmap-head" data-roadmap-head>
                    <div class="roadmap-months">
                        @foreach (var month in Months())
                        {
                            <div class="roadmap-month" @key="month.First"
                                 style="left:@(month.First * DayWidth)px;width:@(month.Length * DayWidth)px;@(month.StartsMonth ? "" : "border-left:0")">
                                <span class="roadmap-month__label">@month.Label</span>
                            </div>
                        }
                    </div>
                    <div class="roadmap-days">
                        @for (var index = _rendered.First; index <= _rendered.Last; index++)
                        {
                            var day = _window.DayAt(index);
                            <div class="@DayClass(day)" @key="index"
                                 style="left:@(index * DayWidth)px;width:@(DayWidth)px"
                                 title="@day.ToString("dddd d MMMM yyyy")">
                                <span>@day.Day</span>
                                <span class="roadmap-day__weekday">@Weekday(day)</span>
                            </div>
                        }
                    </div>

                    @* Where to look for a milestone scrolled out of view, pinned to the
                       side it went (roadmap.js sets data-offscreen on each chip). Every
                       milestone has a chip on both sides; only the one that applies shows. *@
                    @if (_milestones.Count > 0)
                    {
                        <div class="roadmap-milestone-hints">
                            @foreach (var side in new[] { "before", "after" })
                            {
                                <span class="roadmap-milestone-hints__@side">
                                    @foreach (var milestone in _milestones)
                                    {
                                        <span class="@MilestoneClass(milestone, "roadmap-milestone-hint")" @key="milestone.Id"
                                              data-roadmap-milestone-hint data-day="@_window.IndexOf(milestone.Day)"
                                              style="@MilestoneStyle(milestone)" title="@MilestoneTitle(milestone)">
                                            @(side == "before" ? "‹ " : "")<span class="roadmap-milestone-hint__dot"></span>@milestone.Name@(side == "after" ? " ›" : "")
                                        </span>
                                    }
                                </span>
                            }
                        </div>
                    }

                    @foreach (var milestone in Placed())
                    {
                        <div class="@MilestoneClass(milestone, "roadmap-milestone")" @key="milestone.Id"
                             data-roadmap-milestone="@milestone.Id" data-day="@_window.IndexOf(milestone.Day)"
                             style="@MilestoneStyle(milestone)">
                            <span class="roadmap-milestone__pole"></span>
                            <span class="roadmap-milestone__flag" tabindex="0" role="button"
                                  title="@MilestoneTitle(milestone)" aria-label="@MilestoneTitle(milestone)"
                                  @onkeydown="@(e => OnMilestoneKeyDownAsync(milestone, e))">@milestone.Name</span>
                        </div>
                    }
                </div>

                <div class="roadmap-body" data-roadmap-body style="@BodyStyle(drawn)">
                    <div class="roadmap-today" style="left:@(_window.IndexOf(_today) * DayWidth)px"></div>
                    <div class="roadmap-drop-indicator" data-roadmap-drop></div>
                    @foreach (var milestone in Placed())
                    {
                        <div class="@MilestoneClass(milestone, "roadmap-milestone-line")" @key="milestone.Id"
                             data-roadmap-milestone="@milestone.Id" data-day="@_window.IndexOf(milestone.Day)"
                             style="@MilestoneStyle(milestone)" title="@MilestoneTitle(milestone)"></div>
                    }
                    @if (CanWrite)
                    {
                        <div class="roadmap-marquee" data-roadmap-marquee aria-hidden="true"></div>
                    }

                    @if (_entries.Count == 0)
                    {
                        <div class="roadmap-empty">
                            @(CanWrite
                                ? "No tasks on this roadmap yet. Right-click a day in the grid (or press and hold one), or use Add task, to put one on it."
                                : "No tasks on this roadmap yet.")
                        </div>
                    }

                    @* A line per row, or more for a row whose bars overlap, each holding
                       the hints for its bars scrolled out of view. roadmap.js shows the
                       nearest on each side, if the bars in view leave it room. *@
                    @for (var i = 0; i < drawn.Lines.Count; i++)
                    {
                        var line = drawn.Lines[i];
                        var hinted = line.Entries.Where(e => !Timeline.IsDone(e.Task, Timeline.Span(e.Task, e.AnchorDay), _today)).ToList();
                        <div class="roadmap-line" @key="i" data-roadmap-line="@i" data-row="@line.Row"
                             style="top:@(i * RowHeight)px">
                            @foreach (var entry in hinted)
                            {
                                var place = Place(entry);
                                <span class="roadmap-hint roadmap-hint--before" data-roadmap-hint="before"
                                      data-start="@place.StartIndex" data-end="@place.EndIndex">
                                    ‹ @Serial(entry) · @entry.Task.Name
                                </span>
                            }
                            @foreach (var entry in hinted)
                            {
                                var place = Place(entry);
                                <span class="roadmap-hint roadmap-hint--after" data-roadmap-hint="after"
                                      data-start="@place.StartIndex" data-end="@place.EndIndex">
                                    @Serial(entry) · @entry.Task.Name ›
                                </span>
                            }
                        </div>
                    }

                    @* In the roadmap's order rather than the lines', so a bar that changes
                       line keeps its element, and with it any focus it had. data-line and
                       data-row tell roadmap.js where it is; data-selected, which bars a
                       drag takes along. *@
                    @foreach (var entry in _entries)
                    {
                        var span = Timeline.Span(entry.Task, entry.AnchorDay);
                        var place = _window.Place(span);
                        var at = drawn.LineOf(entry.Id);
                        <div class="roadmap-entry" @key="entry.Id" data-roadmap-entry="@entry.Id"
                             data-start="@place.StartIndex" data-end="@place.EndIndex"
                             data-line="@at" data-row="@drawn.RowOf(entry.Id)"
                             data-selected="@(_selected.Contains(entry.Id) ? "" : null)"
                             style="top:@(at * RowHeight)px">
                            @if (place.Overlaps(_rendered.First, _rendered.Last))
                            {
                                <div class="@BarClass(entry)" data-roadmap-bar tabindex="0" role="button"
                                     title="@BarTitle(entry, span)" aria-label="@BarTitle(entry, span)"
                                     style="@BarStyle(entry, place)"
                                     @onkeydown="@(e => OnBarKeyDownAsync(entry, e))">
                                    @if (CanWrite && !place.ClippedStart)
                                    {
                                        <span class="roadmap-bar__handle roadmap-bar__handle--start"
                                              data-roadmap-handle="start" aria-hidden="true"></span>
                                    }
                                    @if (place.ClippedStart)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronLeft" Class="roadmap-bar__clip" />
                                    }
                                    @* The text twice: the copy shows only while a name too long
                                       for its bar scrolls past (roadmap.js), and is what lets
                                       that loop run on without a jump. *@
                                    <span class="roadmap-bar__label">
                                        <span class="roadmap-bar__track">
                                            <span class="roadmap-bar__text">
                                                <span class="roadmap-bar__serial">@Serial(entry)</span>
                                                <span class="roadmap-bar__name">@entry.Task.Name</span>
                                            </span>
                                            <span class="roadmap-bar__text roadmap-bar__text--copy" aria-hidden="true">
                                                <span class="roadmap-bar__serial">@Serial(entry)</span>
                                                <span class="roadmap-bar__name">@entry.Task.Name</span>
                                            </span>
                                        </span>
                                    </span>
                                    <span class="roadmap-bar__spacer"></span>
                                    @if (place.Length * DayWidth >= AvatarBarWidth && Assignees(entry.Task) is { Count: > 0 } assignees)
                                    {
                                        <span class="roadmap-bar__avatars">
                                            @foreach (var member in assignees.Take(3))
                                            {
                                                <MemberAvatar Member="@member" AvatarUrl="@Api.Avatar" />
                                            }
                                        </span>
                                    }
                                    @if (place.ClippedEnd)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Class="roadmap-bar__clip" />
                                    }
                                    @if (CanWrite)
                                    {
                                        <button type="button" class="roadmap-bar__more" data-roadmap-menu
                                                aria-label="@($"More for {Serial(entry)}")"
                                                @onclick="@(e => ShowBarMenuAsync(entry, e.ClientX, e.ClientY))">⋯</button>
                                        @if (!place.ClippedEnd)
                                        {
                                            <span class="roadmap-bar__handle roadmap-bar__handle--end"
                                                  data-roadmap-handle="end" aria-hidden="true"></span>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <section class="roadmap-missed" aria-label="Missed deadlines">
            <MudText Typo="Typo.h4" Class="mb-2">Missed deadlines</MudText>
            @if (Missed() is { Count: > 0 } missed)
            {
                <div class="roadmap-missed__table">
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                        <thead>
                            <tr>
                                <th>Serial</th>
                                <th>Title</th>
                                <th>Assigned</th>
                                <th>Overdue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in missed)
                            {
                                var overdue = Timeline.DaysOverdue(entry.Task, _today);
                                <tr class="roadmap-missed__row" @key="entry.Id" tabindex="0"
                                    @onclick="@(() => OpenTaskAsync(entry))"
                                    @onkeydown="@(e => e.Key == "Enter" ? OpenTaskAsync(entry) : Task.CompletedTask)">
                                    <td>@Serial(entry)</td>
                                    <td>@entry.Task.Name</td>
                                    <td>
                                        <span class="roadmap-missed__assignees">
                                            @foreach (var member in Assignees(entry.Task))
                                            {
                                                <span class="roadmap-missed__assignee">
                                                    <MemberAvatar Member="@member" AvatarUrl="@Api.Avatar" />
                                                    @(member.DisplayName ?? member.Email)
                                                </span>
                                            }
                                        </span>
                                    </td>
                                    <td class="roadmap-missed__overdue">
                                        @overdue @(overdue == 1 ? "day" : "days")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No missed deadlines.</MudText>
            }
        </section>
    </div>
}
