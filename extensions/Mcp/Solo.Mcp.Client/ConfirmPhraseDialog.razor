@*
    Confirmation for something with no undo: the caller types a fixed phrase.
    The host's own dialogs are in Solo.Client, which an extension cannot
    reference, so this package brings its own — MudBlazor's dialog service is
    resolved from the host either way.
*@

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">@Message</MudText>
        <MudTextField @bind-Value="_typed" Label="@Label" Variant="Variant.Outlined" Margin="Margin.Dense"
                      Immediate="true" AutoFocus="true" MaxLength="64" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => Dialog.Cancel())">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" Disabled="@(!Matches)"
                   OnClick="@(() => Dialog.Close(DialogResult.Ok(true)))">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _typed = string.Empty;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public required string Message { get; set; }

    /// <summary>The exact words the caller has to type.</summary>
    [Parameter, EditorRequired]
    public required string Phrase { get; set; }

    [Parameter]
    public string Label { get; set; } = "Confirmation";

    [Parameter]
    public string ConfirmText { get; set; } = "Confirm";

    private bool Matches =>
        string.Equals(_typed.Trim(), Phrase, StringComparison.OrdinalIgnoreCase);
}
