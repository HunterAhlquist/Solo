<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Solo.Api\Solo.Api.csproj" />
    <!-- Built, but deliberately NOT referenced: the fixture extension has to
         arrive the way a real package does — discovered on disk and loaded into
         its own AssemblyLoadContext. Referencing it would load it into the
         default context and the loader would never be exercised. -->
    <ProjectReference Include="..\Solo.Extension.Fixture\Solo.Extension.Fixture.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <!-- Same arrangement for the shipped MCP extension: built and staged as a
         package, never referenced, so the tests exercise the package a release
         actually produces rather than a project reference. -->
    <ProjectReference Include="..\..\src\Solo.Mcp\Solo.Mcp.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\..\src\Solo.Mcp.Client\Solo.Mcp.Client.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Lay the fixture out as a package directory under the test output, so
       Extensions:DevelopmentDirectories can point at it. -->
  <Target Name="StageExtensionFixture" AfterTargets="Build">
    <MSBuild Projects="..\Solo.Extension.Fixture\Solo.Extension.Fixture.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="FixtureAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(FixtureAssembly)"
          DestinationFolder="$(OutDir)extension-fixtures\fixture\server" />
    <Copy SourceFiles="..\Solo.Extension.Fixture\extension.json"
          DestinationFolder="$(OutDir)extension-fixtures\fixture" />
  </Target>

  <!-- And the real MCP package, laid out the same way — both halves plus its
       content/, so the tests exercise the archive a release actually ships. -->
  <Target Name="StageMcpExtension" AfterTargets="Build">
    <MSBuild Projects="..\..\src\Solo.Mcp\Solo.Mcp.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="McpAssembly" />
    </MSBuild>
    <MSBuild Projects="..\..\src\Solo.Mcp.Client\Solo.Mcp.Client.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="McpClientAssembly" />
    </MSBuild>
    <ItemGroup>
      <McpContent Include="..\..\src\Solo.Mcp\content\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(McpAssembly)"
          DestinationFolder="$(OutDir)extension-fixtures\mcp\server" />
    <Copy SourceFiles="@(McpClientAssembly)"
          DestinationFolder="$(OutDir)extension-fixtures\mcp\client" />
    <Copy SourceFiles="@(McpContent)"
          DestinationFolder="$(OutDir)extension-fixtures\mcp\content\%(RecursiveDir)" />
    <Copy SourceFiles="..\..\src\Solo.Mcp\extension.json"
          DestinationFolder="$(OutDir)extension-fixtures\mcp" />
  </Target>

</Project>