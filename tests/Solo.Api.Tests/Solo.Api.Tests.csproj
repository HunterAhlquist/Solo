<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Solo.Api.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Solo.Api\Solo.Api.csproj" />
    <ProjectReference Include="..\Solo.Api.Testing\Solo.Api.Testing.csproj" />
    <!-- Built, but deliberately NOT referenced: the fixture extension has to
         arrive the way a real package does — discovered on disk and loaded into
         its own AssemblyLoadContext. Referencing it would load it into the
         default context and the loader would never be exercised. -->
    <ProjectReference Include="..\Solo.Extension.Fixture\Solo.Extension.Fixture.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Solo.Extension.Fixture.Client\Solo.Extension.Fixture.Client.csproj"
                      ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Lay the fixture out as a package directory under the test output, so
       Extensions:DevelopmentDirectories can point at it. The shipped extensions
       are staged the same way by their own test projects under extensions/. -->
  <Target Name="StageExtensionFixture" AfterTargets="Build">
    <MSBuild Projects="..\Solo.Extension.Fixture\Solo.Extension.Fixture.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="FixtureAssembly" />
    </MSBuild>
    <MSBuild Projects="..\Solo.Extension.Fixture.Client\Solo.Extension.Fixture.Client.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="FixtureClientAssembly" />
    </MSBuild>
    <Copy SourceFiles="@(FixtureAssembly)"
          DestinationFolder="$(OutDir)extension-fixtures\fixture\server" />
    <Copy SourceFiles="@(FixtureClientAssembly)"
          DestinationFolder="$(OutDir)extension-fixtures\fixture\client" />
    <Copy SourceFiles="..\Solo.Extension.Fixture\extension.json"
          DestinationFolder="$(OutDir)extension-fixtures\fixture" />
  </Target>

</Project>
