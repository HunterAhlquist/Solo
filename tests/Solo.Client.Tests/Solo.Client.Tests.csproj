<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.11.3" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Solo.Client.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Solo.Client\Solo.Client.csproj" />
    <ProjectReference Include="..\Solo.Client.Testing\Solo.Client.Testing.csproj" />
    <!-- The fixture package's client half: a real assembly with a route, for the
         loader tests to fetch and hand to the router. The shipped extensions'
         pages are tested in their own projects under extensions/. -->
    <ProjectReference Include="..\Solo.Extension.Fixture.Client\Solo.Extension.Fixture.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../fixtures/markdown-safe-urls.json" Link="markdown-safe-urls.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
