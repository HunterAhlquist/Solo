<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- The fixture package's client half: one routable page, so the client's
       extension loading can be tested against a real assembly — fetched as
       bytes, Assembly.Load-ed, handed to the router — without leaning on an
       extension that ships. Solo.Api.Tests stages it beside the server half,
       which gives the host a real client asset to serve. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
  </ItemGroup>

</Project>
